    <!-- Navigation Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/"
        class="w-full sm:w-auto bg-brand-black text-white font-sans text-xs font-semibold tracking-widest2 uppercase px-8 py-3.5 hover:bg-brand-gray-600 transition-colors"
