      </a>
      <a
        href="/shop"
        class="w-full sm:w-auto border border-brand-gray-200 text-brand-black font-sans text-xs font-semibold tracking-widest2 uppercase px-8 py-3.5 hover:bg-brand-gray-100 transition-colors"
