<%- include('../partials/navbar') %>

<main class="min-h-screen bg-brand-gray-50 pb-20">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-black mb-8">Shopping Cart</h1>

    <% if (cart && cart.items && cart.items.length > 0) { %>
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
        
        <!-- Cart Items (Left) -->
        <div class="w-full lg:w-2/3 flex flex-col gap-6">
          <div class="bg-white border border-brand-gray-200 shadow-sm p-4 sm:p-6">
            <div class="hidden sm:grid sm:grid-cols-12 gap-4 pb-4 border-b border-brand-gray-100 font-sans text-xs font-bold text-brand-gray-500 uppercase tracking-widest2">
              <div class="sm:col-span-6">Product</div>
              <div class="sm:col-span-2 text-center">Price</div>
              <div class="sm:col-span-2 text-center">Quantity</div>
              <div class="sm:col-span-2 text-right">Total</div>
            </div>

            <div class="flex flex-col gap-6 pt-4">
              <% cart.items.forEach(item => { %>
                <div id="cart-item-row-<%= item._id %>" class="flex flex-col sm:grid sm:grid-cols-12 gap-4 items-start sm:items-center py-4 border-b border-brand-gray-50 last:border-0 relative">
                  
                  <!-- Mobile Remove Button -->
                  <button type="button" onclick="removeItem('<%= item._id %>')" class="absolute top-4 right-0 sm:hidden text-brand-gray-400 hover:text-red-500 p-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>

                  <!-- Product Info -->
                  <div class="sm:col-span-6 flex gap-4 w-full">
                    <a href="<%= item.product && !item.isUnavailable ? '/shop/product/' + item.product._id : '#' %>" class="w-20 h-24 sm:w-24 sm:h-32 flex-shrink-0 bg-brand-gray-50 overflow-hidden relative border border-brand-gray-100">
                      <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                        <img src="<%= item.product.images[0] %>" alt="Product Image" class="w-full h-full object-cover">
                      <% } else { %>
                        <div class="w-full h-full flex items-center justify-center text-brand-gray-400 font-serif">P</div>
                      <% } %>
                    </a>
                    
                    <div class="flex flex-col justify-center py-1 flex-1 pr-8 sm:pr-0">
                      <% if (item.product && item.product.category) { %>
                        <span class="text-xs text-brand-gray-500 font-sans uppercase tracking-widest2 mb-1"><%= item.product.category.name %></span>
                      <% } %>
                      
                      <a href="<%= item.product && !item.isUnavailable ? '/shop/product/' + item.product._id : '#' %>" class="font-serif font-bold text-brand-black text-sm sm:text-base hover:text-brand-gray-600 transition-colors line-clamp-2 mb-2">
                        <%= item.product ? item.product.name : 'Unknown Product' %>
                      </a>
                      
                      <div class="font-sans text-xs sm:text-sm text-brand-gray-600 flex items-center gap-3">
                        <span class="px-2 py-0.5 bg-brand-gray-50 border border-brand-gray-200"><%= item.variant.size %></span>
                        <span class="px-2 py-0.5 bg-brand-gray-50 border border-brand-gray-200"><%= item.variant.color %></span>
                      </div>

                      <% if (item.isUnavailable || item.isOutOfStock || item.stockMismatch) { %>
                        <div class="mt-3 text-xs font-sans font-medium text-red-500 bg-red-50 border border-red-100 px-2 py-1 inline-block">
                          <%= item.message %>
                        </div>
                      <% } %>
                    </div>
                  </div>

                  <!-- Price -->
                  <div class="sm:col-span-2 hidden sm:flex justify-center font-sans font-medium text-brand-black">
                    <% if (!item.isUnavailable && item.price) { %>
                      ₹<%= item.price %>
                    <% } else { %>
                      -
                    <% } %>
                  </div>

                  <!-- Quantity -->
                  <div class="sm:col-span-2 flex items-center justify-between sm:justify-center w-full sm:w-auto mt-2 sm:mt-0">
                    <span class="sm:hidden font-sans text-sm text-brand-gray-500">Qty:</span>
                    
                    <% if (item.isUnavailable || item.isOutOfStock) { %>
                      <span class="text-brand-gray-400 font-sans text-sm font-medium">N/A</span>
                    <% } else { %>
                      <div class="flex items-center border border-brand-gray-200 h-10 w-28 bg-white">
                        <button type="button" id="btn-dec-<%= item._id %>" onclick="updateQty('<%= item._id %>', 'decrement')" class="flex-1 h-full flex items-center justify-center text-brand-gray-600 hover:bg-brand-gray-50 transition-colors <%= item.quantity <= 1 ? 'opacity-50 cursor-not-allowed' : '' %>" <%= item.quantity <= 1 ? 'disabled' : '' %>>-</button>
                        <input type="text" id="qty-input-<%= item._id %>" value="<%= item.quantity %>" class="w-10 h-full text-center font-sans text-brand-black focus:outline-none appearance-none border-x border-brand-gray-200 bg-transparent text-sm pointer-events-none" readonly>
                        <button type="button" id="btn-inc-<%= item._id %>" onclick="updateQty('<%= item._id %>', 'increment')" class="flex-1 h-full flex items-center justify-center text-brand-gray-600 hover:bg-brand-gray-50 transition-colors <%= item.quantity >= 5 || item.quantity >= item.stock ? 'opacity-50 cursor-not-allowed' : '' %>" <%= item.quantity >= 5 || item.quantity >= item.stock ? 'disabled' : '' %>>+</button>
                      </div>
                    <% } %>
                  </div>

                  <!-- Total -->
                  <div class="sm:col-span-2 flex items-center justify-between sm:justify-end w-full sm:w-auto mt-2 sm:mt-0 relative pr-0 sm:pr-8">
                    <span class="sm:hidden font-sans text-sm font-bold text-brand-black">Total:</span>
                    <span id="item-total-<%= item._id %>" class="font-sans font-semibold text-brand-black text-base">
                      <% if (!item.isUnavailable && !item.isOutOfStock && !item.stockMismatch && item.itemTotal) { %>
                        ₹<%= item.itemTotal %>
                      <% } else { %>
                        -
                      <% } %>
                    </span>

                    <!-- Desktop Remove Button -->
                    <button type="button" onclick="removeItem('<%= item._id %>')" class="absolute right-0 hidden sm:flex text-brand-gray-400 hover:text-red-500 items-center justify-center h-full group" title="Remove item">
                      <svg class="w-5 h-5 transition-transform group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </div>

                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Order Summary (Right) -->
        <div class="w-full lg:w-1/3">
          <div class="bg-white border border-brand-gray-200 shadow-sm p-6 sticky top-24">
            <h2 class="font-serif text-xl font-bold text-brand-black mb-6 border-b border-brand-gray-100 pb-4">Order Summary</h2>
            
            <div class="flex justify-between items-center mb-4 font-sans text-sm text-brand-gray-600">
              <span>Subtotal</span>
              <span id="cart-subtotal-val" class="font-medium text-brand-black">₹<%= cart.cartTotal %></span>
            </div>
            
            <div class="flex justify-between items-center mb-6 font-sans text-sm text-brand-gray-600">
              <span>Shipping</span>
              <span class="font-medium text-brand-black">Calculated at checkout</span>
            </div>

            <div class="border-t border-brand-gray-100 pt-4 mb-8 flex justify-between items-center">
              <span class="font-sans font-bold text-brand-black">Total</span>
              <span id="cart-total-val" class="font-sans font-bold text-brand-black text-xl">₹<%= cart.cartTotal %></span>
            </div>

            <% 
              const hasUnavailableItems = cart.items.some(item => item.isUnavailable || item.isOutOfStock || item.stockMismatch); 
            %>

            <% if (hasUnavailableItems) { %>
              <div class="bg-red-50 border border-red-200 text-red-600 text-xs px-4 py-3 font-sans mb-4 text-center">
                Please remove unavailable or out of stock items from your cart to proceed with checkout.
              </div>
              <button type="button" disabled class="w-full h-12 bg-brand-gray-200 text-brand-gray-400 font-sans text-sm font-bold uppercase tracking-wider cursor-not-allowed">
                Proceed to Checkout
              </button>
            <% } else { %>
              <a href="/checkout" class="flex items-center justify-center w-full h-12 bg-brand-black text-white font-sans text-sm font-bold uppercase tracking-wider hover:bg-brand-gray-600 transition-colors">
                Proceed to Checkout
              </a>
            <% } %>

            <a href="/shop" class="flex items-center justify-center w-full mt-4 font-sans text-sm text-brand-gray-500 hover:text-brand-black transition-colors">
              Continue Shopping
            </a>
          </div>
        </div>

      </div>
    <% } else { %>
      
      <!-- Empty Cart -->
      <div class="flex flex-col items-center justify-center py-16 sm:py-24 bg-white border border-brand-gray-200 shadow-sm">
        <div class="w-20 h-20 bg-brand-gray-50 rounded-full flex items-center justify-center mb-6">
          <svg class="w-10 h-10 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <h2 class="font-serif text-2xl font-bold text-brand-black mb-3">Your cart is empty</h2>
        <p class="font-sans text-brand-gray-500 mb-8 max-w-md text-center px-4">Looks like you haven't added anything to your cart yet. Explore our collection of timeless fashion.</p>
        <a href="/shop" class="px-8 py-3 bg-brand-black text-white font-sans text-sm font-medium hover:bg-brand-gray-600 transition-colors">
          Start Shopping
        </a>
      </div>

    <% } %>
  </div>
</main>

<script>
  async function updateQty(itemId, action) {
    try {
      const res = await fetch(`/cart/update/${itemId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      });
      
      const data = await res.json();
      
      if (res.ok && data.success) {
        if (typeof window.updateNavCounts === 'function' && typeof data.cartCount !== 'undefined') {
          window.updateNavCounts(data.cartCount, undefined);
        }

        // Update item quantity input & buttons
        if (data.item) {
          const qtyInput = document.getElementById(`qty-input-${itemId}`);
          const itemTotalSpan = document.getElementById(`item-total-${itemId}`);
          const btnDec = document.getElementById(`btn-dec-${itemId}`);
          const btnInc = document.getElementById(`btn-inc-${itemId}`);

          if (qtyInput) qtyInput.value = data.item.quantity;
          if (itemTotalSpan && typeof data.item.itemTotal !== 'undefined') {
            itemTotalSpan.textContent = `₹${data.item.itemTotal}`;
          }

          if (btnDec) {
            if (data.item.quantity <= 1) {
              btnDec.disabled = true;
              btnDec.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
              btnDec.disabled = false;
              btnDec.classList.remove('opacity-50', 'cursor-not-allowed');
            }
          }

          if (btnInc) {
            if (data.item.quantity >= 5 || (data.item.stock && data.item.quantity >= data.item.stock)) {
              btnInc.disabled = true;
              btnInc.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
              btnInc.disabled = false;
              btnInc.classList.remove('opacity-50', 'cursor-not-allowed');
            }
          }
        }

        // Update Order Summary subtotal & total
        if (typeof data.cartTotal !== 'undefined') {
          const subtotalEl = document.getElementById('cart-subtotal-val');
          const totalEl = document.getElementById('cart-total-val');
          if (subtotalEl) subtotalEl.textContent = `₹${data.cartTotal}`;
          if (totalEl) totalEl.textContent = `₹${data.cartTotal}`;
        }
      } else {
        if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to update quantity');
      }
    } catch (error) {
      console.error(error);
      if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
    }
  }

  async function removeItem(itemId) {
    if (typeof Swal !== 'undefined') {
      const result = await Swal.fire({
        title: 'Remove Item?',
        text: "Are you sure you want to remove this item from your cart?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#111',
        cancelButtonColor: '#9a9a94',
        confirmButtonText: 'Yes, remove it',
        customClass: {
          popup: 'rounded-none font-sans',
          confirmButton: 'font-sans text-xs tracking-widest2 uppercase px-6 py-2',
          cancelButton: 'font-sans text-xs tracking-widest2 uppercase px-6 py-2',
        }
      });
      
      if (!result.isConfirmed) return;
    } else {
      if (!confirm('Remove this item from cart?')) return;
    }

    try {
      const res = await fetch(`/cart/remove/${itemId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await res.json();
      
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to remove item');
      }
    } catch (error) {
      console.error(error);
      if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
    }
  }
</script>

<%- include('../partials/footer') %>
