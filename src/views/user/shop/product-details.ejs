<%- include('../partials/navbar') %>

  <main class="min-h-screen bg-brand-gray-50 pb-20">

    <!-- Breadcrumbs -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <nav class="flex text-sm text-brand-gray-500 font-sans" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-brand-black transition-colors">Home</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
              <a href="/shop?category=<%= product.category._id %>" class="hover:text-brand-black transition-colors">
                <%= product.category.name %>
              </a>
            </div>
          </li>
          <% if (product.subcategory) { %>
            <li>
              <div class="flex items-center">
                <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd"
                    d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
                <a href="/shop?subcategory=<%= product.subcategory._id %>"
                  class="hover:text-brand-black transition-colors">
                  <%= product.subcategory.name %>
                </a>
              </div>
            </li>
            <% } %>
              <li aria-current="page">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                      d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-brand-black font-medium line-clamp-1">
                    <%= product.name %>
                  </span>
                </div>
              </li>
        </ol>
      </nav>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white p-6 sm:p-8 lg:p-12 shadow-sm border border-brand-gray-200">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">

          <!-- Image Gallery (Left) -->
          <div class="w-full lg:w-1/2 flex flex-col gap-4">
            <div class="relative w-full aspect-[3/4] bg-brand-gray-50 overflow-hidden cursor-zoom-in"
              id="main-image-container" onmousemove="zoomImage(event)" onmouseleave="resetZoom()">
              <img src="<%= product.images[0] %>" alt="<%= product.name %>" id="main-image"
                class="w-full h-full object-cover origin-center block" style="transition: transform 0.1s ease-out;">
            </div>

            <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide" id="thumbnails-container">
              <% product.images.forEach((img, idx)=> { %>
                <button type="button" onclick="changeImage('<%= img %>')"
                  class="flex-shrink-0 w-20 h-24 sm:w-24 sm:h-32 bg-brand-gray-50 border-2 <%= idx === 0 ? 'border-brand-black' : 'border-transparent' %> hover:border-brand-gray-400 transition-colors focus:outline-none thumbnail-btn">
                  <img src="<%= img %>" alt="Thumbnail <%= idx + 1 %>" class="w-full h-full object-cover">
                </button>
                <% }) %>
            </div>
          </div>

          <!-- Product Details (Right) -->
          <div class="w-full lg:w-1/2 flex flex-col">
            <div class="mb-2">
              <span class="text-xs text-brand-gray-500 font-sans uppercase tracking-widest2">
                <%= product.subcategory?.name || product.category?.name %>
              </span>
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-black mb-4">
              <%= product.name %>
            </h1>

            <!-- Dynamic Rating Summary -->
            <% const avgRating=(ratingSummary && ratingSummary.averageRating) ? ratingSummary.averageRating : 0; %>
              <% const totalReviewsCount=(ratingSummary && ratingSummary.totalReviews) ? ratingSummary.totalReviews : 0;
                %>
                <div class="flex items-center gap-2 mb-4">
                  <div class="flex text-yellow-400 text-sm">
                    <% for (let i=1; i <=5; i++) { %>
                      <span
                        class="<%= i <= Math.round(avgRating) ? 'text-yellow-400' : 'text-brand-gray-300' %>">★</span>
                      <% } %>
                  </div>
                  <span class="font-sans text-sm font-semibold text-brand-black">
                    <%= avgRating> 0 ? avgRating.toFixed(1) : '0.0' %>
                  </span>
                  <a href="#customer-reviews"
                    class="font-sans text-sm text-brand-gray-500 underline hover:text-brand-black transition-colors">
                    (<%= totalReviewsCount %>
                      <%= totalReviewsCount===1 ? 'Review' : 'Reviews' %>)
                  </a>
                </div>

                <div class="text-2xl font-sans font-semibold text-brand-black mb-6" id="price-display">
                  <% if (product.bestOffer && product.bestOffer.discountAmount> 0) { %>
                    <div class="flex items-baseline gap-3">
                      <% let minPrice=Infinity; let minOrigPrice=Infinity; product.variants.forEach(v=> {
                        if(v.price < minPrice) { minPrice=v.price; minOrigPrice=v.originalPrice || v.price; } }); %>
                          <span class="text-3xl font-bold text-brand-black">₹<%= (minPrice !== Infinity) ? minPrice.toLocaleString('en-IN') : 0 %></span>
                          <span class="text-base text-brand-gray-400 line-through font-normal">₹<%= (minOrigPrice !== Infinity) ? minOrigPrice.toLocaleString('en-IN') : 0 %></span>
                          <span
                            class="text-xs text-green-700 font-bold bg-green-50 border border-green-200 px-2 py-0.5 rounded">
                            <%= product.bestOffer.offerPercentage %>% OFF
                          </span>
                    </div>
                    <% } else { %>
                      <% let minPrice=Infinity; let maxPrice=0; product.variants.forEach(v=> {
                        if(v.price < minPrice) minPrice=v.price; if(v.price> maxPrice) maxPrice = v.price;
                          }); %>
                          <% if (minPrice===maxPrice) { %>
                            ₹<%= (minPrice !== Infinity) ? minPrice.toLocaleString('en-IN') : 0 %>
                              <% } else { %>
                                ₹<%= (minPrice !== Infinity) ? minPrice.toLocaleString('en-IN') : 0 %> - ₹<%= maxPrice.toLocaleString('en-IN') %>
                                    <% } %>
                                      <% } %>
                </div>

                <% if (product.bestOffer && product.bestOffer.discountAmount> 0) { %>
                  <div class="mb-6 p-3 bg-green-50 border border-green-200 rounded-md">
                    <div class="flex items-center gap-2">
                      <span
                        class="px-2 py-0.5 bg-green-700 text-white font-sans text-[10px] font-bold uppercase tracking-wider rounded">Special
                        Offer</span>
                      <span class="font-sans text-xs font-bold text-green-800">
                        <%= product.bestOffer.offerName %>
                      </span>
                    </div>
                    <p class="text-xs font-sans text-green-700 mt-1">Get <%= product.bestOffer.offerPercentage %>% off
                        (Save ₹<%= product.bestOffer.discountAmount %>) automatically applied on this item.</p>
                  </div>
                  <% } %>

                    <div class="prose prose-sm font-sans text-brand-gray-600 mb-8 max-w-none">
                      <%= product.description %>
                    </div>

                    <!-- Variants Selection -->
                    <div class="mb-8">
                      <% const colorOptions=(product.colorOptions && product.colorOptions.length> 0)
                        ? product.colorOptions
                        : [...new Set(product.variants.map(v => v.color))].map(cName => ({ name: cName, code: '#000000'
                        }));
                        const sizes = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
                        %>

                        <div class="mb-6">
                          <h3 class="font-sans text-sm font-bold text-brand-black uppercase tracking-wider mb-3">Color
                          </h3>
                          <div class="flex flex-wrap gap-3">
                            <% colorOptions.forEach(color=> { %>
                              <button type="button" onclick="selectColor('<%= color.name %>', this)"
                                class="color-btn w-8 h-8 rounded-full border-2 border-brand-gray-200 hover:border-brand-black transition-all focus:outline-none relative"
                                style="background-color: <%= color.code %>" data-color="<%= color.name %>"
                                title="<%= color.name %>">
                                <span class="sr-only">
                                  <%= color.name %>
                                </span>
                              </button>
                              <% }) %>
                          </div>
                        </div>

                        <div class="mb-6">
                          <div class="flex justify-between items-baseline mb-3 border-b border-brand-gray-100 pb-2">
                            <h3 class="font-sans text-sm font-bold text-brand-black uppercase tracking-wider">Size</h3>
                            <button type="button" onclick="openSizeChart()"
                              class="text-xs text-brand-gray-500 hover:text-brand-black underline font-sans focus:outline-none">
                              Size Chart
                            </button>
                          </div>
                          <div class="flex flex-wrap gap-3" id="size-container">
                            <% sizes.forEach(size=> { %>
                              <button type="button" onclick="selectSize('<%= size %>')"
                                class="size-btn w-12 h-12 flex items-center justify-center border border-brand-gray-200 font-sans text-sm hover:border-brand-black transition-colors focus:outline-none"
                                data-size="<%= size %>">
                                <%= size %>
                              </button>
                              <% }) %>
                          </div>
                        </div>

                        <!-- Available Coupons Section Dropdown (Positioned directly below Size section) -->
                        <% const couponsList = (typeof availableCoupons !== 'undefined' && availableCoupons && availableCoupons.length > 0) ? availableCoupons : ((typeof activeCoupons !== 'undefined' && activeCoupons) ? activeCoupons : []); %>
                        <div class="mb-6 pt-4 border-t border-brand-gray-100">
                          <label for="product-coupons-dropdown" class="font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-widest2 block mb-2">Available Coupons</label>
                          <% if (couponsList && couponsList.length > 0) { %>
                            <div class="relative w-full">
                              <select id="product-coupons-dropdown" onchange="showProductCouponInfo(this)" class="w-full pl-3 pr-10 py-2.5 bg-brand-gray-50 border border-brand-gray-200 rounded-md font-sans text-xs font-medium text-brand-black focus:outline-none focus:ring-1 focus:ring-brand-black focus:bg-white appearance-none cursor-pointer transition-colors shadow-sm">
                                <option value="">-- Select an Available Coupon --</option>
                                <% couponsList.forEach(coupon => { %>
                                  <option value="<%= coupon.code %>"
                                          data-type="COUPON"
                                          data-code="<%= coupon.code %>"
                                          data-discount="<%= coupon.type === 'PERCENTAGE' ? coupon.discountValue + '% OFF' : '₹' + coupon.discountValue + ' OFF' %>"
                                          data-min="<%= coupon.minPurchase || 0 %>"
                                          data-desc="<%= coupon.description || (coupon.type === 'PERCENTAGE' ? coupon.discountValue + '% OFF' : 'Flat ₹' + coupon.discountValue + ' OFF') %>">
                                    <%= coupon.code %> — <%= coupon.type === 'PERCENTAGE' ? coupon.discountValue + '% OFF' : '₹' + coupon.discountValue + ' OFF' %> <%= coupon.minPurchase > 0 ? '(Min: ₹' + coupon.minPurchase + ')' : '' %>
                                  </option>
                                <% }) %>
                              </select>
                              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-500">
                                <svg class="fill-current h-4 w-4" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                              </div>
                            </div>
                            <div id="product-coupon-details" class="mt-2.5 text-xs font-sans text-brand-gray-600 hidden bg-white p-3 border border-brand-gray-100 rounded shadow-sm">
                              <div class="font-semibold text-brand-black flex items-center justify-between gap-2">
                                <div class="flex items-center gap-1.5">
                                  <span id="product-coupon-type-badge" class="px-1.5 py-0.5 text-[10px] font-bold rounded uppercase bg-brand-gray-100 text-brand-black border border-brand-gray-200">COUPON</span>
                                  <span id="product-coupon-code" class="font-mono font-bold text-brand-black"></span>
                                </div>
                                <span id="product-coupon-discount" class="text-green-600 font-bold"></span>
                              </div>
                              <p id="product-coupon-desc" class="text-brand-gray-500 mt-1"></p>
                              <p id="product-coupon-min" class="text-[11px] text-brand-gray-400 mt-0.5"></p>
                            </div>
                          <% } else { %>
                            <p class="font-sans text-xs text-brand-gray-500 italic">No valid coupons currently available.</p>
                          <% } %>
                        </div>
                    </div>

                    <!-- Stock Status -->
                    <div id="stock-status"
                      class="mb-6 font-sans text-sm font-medium min-h-[40px] flex flex-col justify-center">
                      <!-- Populated by JS -->
                    </div>

                    <!-- Add to Cart -->
                    <div class="flex items-center gap-4 mt-auto">
                      <div class="flex items-center border border-brand-gray-200 h-12 bg-white" id="qty-container">
                        <button type="button" onclick="decrementQty()" id="qty-minus" disabled
                          class="w-12 h-full flex items-center justify-center text-brand-gray-600 hover:bg-brand-gray-50 disabled:opacity-30 disabled:cursor-not-allowed focus:outline-none">-</button>
                        <input type="number" id="qty-input" value="1" min="1" max="5"
                          class="w-12 h-full text-center font-sans text-brand-black focus:outline-none appearance-none border-x border-brand-gray-200 disabled:opacity-50 disabled:cursor-not-allowed bg-transparent"
                          readonly disabled>
                        <button type="button" onclick="incrementQty()" id="qty-plus" disabled
                          class="w-12 h-full flex items-center justify-center text-brand-gray-600 hover:bg-brand-gray-50 disabled:opacity-30 disabled:cursor-not-allowed focus:outline-none">+</button>
                      </div>

                      <button type="button" id="add-to-cart-btn" onclick="addToCart()"
                        class="flex-1 h-12 bg-brand-black text-white font-sans text-sm font-bold uppercase tracking-wider hover:bg-brand-gray-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                        Add to Cart
                      </button>

                      <!-- Wishlist Button -->
                      <button type="button" id="wishlist-btn" onclick="toggleWishlistDetails()"
                        class="w-12 h-12 flex items-center justify-center border border-brand-gray-200 text-brand-gray-500 hover:text-red-500 transition-colors focus:outline-none"
                        title="Add to Wishlist">
                        <svg class="w-5 h-5 <%= isInWishlist ? 'text-red-500 fill-current' : 'text-brand-gray-400' %>"
                          fill="<%= isInWishlist ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor"
                          stroke-width="2" id="wishlist-heart-icon">
                          <path stroke-linecap="round" stroke-linejoin="round"
                            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                    </div>



                    <div class="mt-8 border-t border-brand-gray-200">
                      <!-- Delivery & Returns -->
                      <details class="group py-4 border-b border-brand-gray-200 cursor-pointer">
                        <summary
                          class="flex justify-between items-center font-sans font-bold text-sm uppercase tracking-wider text-brand-black list-none">
                          Delivery & Returns
                          <span class="transition group-open:rotate-180">
                            <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor"
                              stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24"
                              width="24">
                              <path d="M6 9l6 6 6-6"></path>
                            </svg>
                          </span>
                        </summary>
                        <div class="text-brand-gray-600 text-sm font-sans mt-3">
                          Delivery charge ₹49 on every order.<br />
                          7-day return policy applies to eligible delivered products.
                        </div>
                      </details>


                    </div>

          </div>
        </div>
      </div>
    </div>

    <!-- Customer Reviews Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 sm:mt-24 pt-8" id="customer-reviews">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-black text-center mb-8">Customer Reviews</h2>

      <!-- Your Review / Review Action Section -->
      <% if (canReview) { %>
        <div class="max-w-2xl mx-auto mb-12 bg-white p-6 sm:p-8 border border-brand-gray-200 shadow-sm rounded-md" id="your-review-section">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-brand-gray-100">
            <h3 class="font-serif text-xl font-bold text-brand-black">Your Review</h3>
            <% if (userReview) { %>
              <% 
                let userStarStr = '';
                for (let s = 1; s <= 5; s++) {
                  userStarStr += s <= userReview.rating ? '★' : '☆';
                }
              %>
              <button type="button" onclick="openReviewModal('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', <%= userReview.rating %>, '<%= (userReview.title || '').replace(/'/g, "\\'") %>', '<%= (userReview.comment || '').replace(/'/g, "\\'").replace(/\n/g, "\\n") %>')" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-brand-black hover:bg-brand-gray-600 text-white text-xs font-sans font-bold uppercase tracking-wider rounded transition-colors shadow-sm focus:outline-none">
                <span class="text-yellow-400"><%= userStarStr %></span> – EDIT REVIEW
              </button>
            <% } else { %>
              <button type="button" onclick="openReviewModal('<%= product._id %>', '<%= product.name.replace(/'/g, "\\'") %>', 0, '', '')" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-brand-black hover:bg-brand-gray-600 text-white text-xs font-sans font-bold uppercase tracking-wider rounded transition-colors shadow-sm focus:outline-none">
                WRITE A REVIEW
              </button>
            <% } %>
          </div>

          <% if (userReview) { %>
            <div class="font-sans text-sm">
              <div class="flex text-yellow-400 text-sm mb-2">
                <% for (let i = 1; i <= 5; i++) { %>
                  <span class="<%= i <= userReview.rating ? 'text-yellow-400' : 'text-brand-gray-300' %>">★</span>
                <% } %>
              </div>
              <% if (userReview.title) { %>
                <h4 class="font-bold text-brand-black mb-1"><%= userReview.title %></h4>
              <% } %>
              <p class="text-brand-gray-600 mb-2"><%= userReview.comment %></p>
              <span class="text-xs text-brand-gray-400">Submitted on <%= new Date(userReview.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
            </div>
          <% } else { %>
            <p class="font-sans text-xs text-brand-gray-600">You purchased and received this product. Share your feedback with other shoppers!</p>
          <% } %>
        </div>
      <% } else { %>
        <div class="max-w-2xl mx-auto mb-12 p-4 text-center bg-brand-gray-50 border border-brand-gray-200 rounded-md font-sans text-sm text-brand-gray-600">
          <% if (!user) { %>
            <p>Please <a href="/login" class="font-semibold text-brand-black underline hover:text-brand-gray-600">log in</a> and purchase this product to write a review.</p>
          <% } else { %>
            <p>Review submission becomes available after this product has been successfully delivered to you.</p>
          <% } %>
        </div>
      <% } %>

      <!-- Dynamic Customer Reviews List -->
      <% if (reviews && reviews.length> 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% reviews.forEach(r=> { %>
            <div class="bg-white p-6 border border-brand-gray-100 rounded-md shadow-sm">
              <div class="flex text-yellow-400 text-sm mb-3">
                <% for (let i=1; i <=5; i++) { %>
                  <span class="<%= i <= r.rating ? 'text-yellow-400' : 'text-brand-gray-300' %>">★</span>
                  <% } %>
              </div>
              <% if (r.title) { %>
                <h4 class="font-bold font-sans text-brand-black mb-2 text-sm">
                  <%= r.title %>
                </h4>
                <% } %>
                  <p class="font-sans text-brand-gray-600 text-sm mb-4">
                    <%= r.comment %>
                  </p>
                  <span class="font-sans text-xs text-brand-gray-400 font-semibold uppercase tracking-wider">
                    <%= r.user ? (r.user.fullName || (r.user.firstName + ' ' + (r.user.lastName || '' )))
                      : 'Verified Buyer' %> -
                      <%= new Date(r.createdAt).toLocaleDateString('en-US', { month: 'long' , day: 'numeric' ,
                        year: 'numeric' }) %>
                  </span>
            </div>
            <% }) %>
        </div>
        <% } else { %>
          <p class="text-center font-sans text-brand-gray-500 text-sm italic mb-12">No reviews yet for this product.</p>
          <% } %>
    </div>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length> 0) { %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 sm:mt-24 border-t border-brand-gray-200 pt-16">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-black text-center mb-10">You May Also Like</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          <% relatedProducts.forEach(rel=> { %>
            <div
              class="group relative flex flex-col bg-white border border-brand-gray-100 overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <a href="/shop/product/<%= rel._id %>"
                class="relative w-full aspect-[3/4] overflow-hidden bg-brand-gray-50 block">
                <% if (rel.images && rel.images.length> 0) { %>
                  <img src="<%= rel.images[0] %>" alt="<%= rel.name %>"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                  <% } %>
              </a>
              <div class="p-4 flex flex-col flex-1">
                <div class="mb-1 text-xs text-brand-gray-500 font-sans uppercase tracking-wider">
                  <%= rel.category?.name %>
                </div>
                <a href="/shop/product/<%= rel._id %>"
                  class="font-serif font-bold text-brand-black text-base leading-tight mb-2 hover:text-brand-gray-600 transition-colors line-clamp-1">
                  <%= rel.name %>
                </a>
                <div class="mt-auto pt-3 border-t border-brand-gray-50">
                  <span class="font-sans font-semibold text-brand-black">
                    <% let rMin=Infinity; let rMax=0; if (rel.variants) rel.variants.forEach(v=> {
                      if(v.price < rMin) rMin=v.price; if(v.price> rMax) rMax = v.price;
                        });
                        %>
                        <%= rMin===rMax ? '₹' + rMin : '₹' + rMin + ' - ₹' + rMax %>
                  </span>
                </div>
              </div>
            </div>
            <% }) %>
        </div>
      </div>
      <% } %>

  </main>

  <!-- Login Modal -->
  <div id="login-modal" class="fixed inset-0 bg-black/60 z-[70] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-sm p-6 text-center">
      <h3 class="font-serif text-xl font-bold text-brand-black mb-2">Please Login</h3>
      <p class="font-sans text-sm text-brand-gray-600 mb-6">You need to be logged in to add items to your cart.</p>
      <div class="flex flex-col gap-3">
        <a href="/login"
          class="bg-brand-black text-white font-sans font-bold text-sm uppercase tracking-wider py-3 px-4 hover:bg-brand-gray-600 transition-colors">Login</a>
        <button type="button" onclick="document.getElementById('login-modal').classList.add('hidden')"
          class="font-sans text-sm text-brand-gray-500 hover:text-brand-black underline transition-colors">Cancel</button>
      </div>
    </div>
  </div>

  <script>
    const productData = <%- JSON.stringify(product) %>;
    const variants = productData.variants;
    const productId = productData._id;

    // Fallback colorOptions if empty (for older products in database)
    const colorOptions = (productData.colorOptions && productData.colorOptions.length > 0)
      ? productData.colorOptions
      : [...new Set(variants.map(v => v.color))].map(cName => ({ name: cName, code: '#000000', images: productData.images }));

    let selectedColor = null;
    let selectedSize = null;
    let maxStock = 0;

    function showProductCouponInfo(selectEl) {
      const opt = selectEl.options[selectEl.selectedIndex];
      const detailsDiv = document.getElementById('product-coupon-details');
      if (!opt || !opt.value) {
        if (detailsDiv) detailsDiv.classList.add('hidden');
        return;
      }
      const code = opt.getAttribute('data-code');
      const discount = opt.getAttribute('data-discount');
      const desc = opt.getAttribute('data-desc');
      const min = opt.getAttribute('data-min');

      const codeEl = document.getElementById('product-coupon-code');
      const discEl = document.getElementById('product-coupon-discount');
      const descEl = document.getElementById('product-coupon-desc');
      const minEl = document.getElementById('product-coupon-min');

      if (codeEl) codeEl.textContent = code || '';
      if (discEl) discEl.textContent = discount || '';
      if (descEl) descEl.textContent = desc || '';
      if (minEl) minEl.textContent = min > 0 ? `Minimum purchase: ₹${min}` : 'No minimum order required';

      if (detailsDiv) detailsDiv.classList.remove('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
      // Preselect the first color
      if (colorOptions.length > 0) {
        const firstBtn = document.querySelector('.color-btn');
        if (firstBtn) {
          selectColor(colorOptions[0].name, firstBtn);
        }
      } else {
        updateAvailableSizes();
      }
    });

    function changeImage(src) {
      document.getElementById('main-image').src = src;

      // Update active thumbnail border
      document.querySelectorAll('.thumbnail-btn').forEach(btn => {
        const img = btn.querySelector('img');
        if (img.src.includes(src)) {
          btn.classList.add('border-brand-black');
          btn.classList.remove('border-transparent');
        } else {
          btn.classList.remove('border-brand-black');
          btn.classList.add('border-transparent');
        }
      });
    }

    function zoomImage(e) {
      const container = e.currentTarget;
      const img = document.getElementById('main-image');

      const rect = container.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const xPercent = (x / rect.width) * 100;
      const yPercent = (y / rect.height) * 100;

      img.style.transformOrigin = `${xPercent}% ${yPercent}%`;
      img.style.transform = 'scale(2)';
    }

    function resetZoom() {
      const img = document.getElementById('main-image');
      img.style.transformOrigin = 'center center';
      img.style.transform = 'scale(1)';
    }

    function selectColor(color, btn) {
      selectedColor = color;

      document.querySelectorAll('.color-btn').forEach(b => {
        b.classList.remove('border-brand-black', 'scale-110');
        b.classList.add('border-brand-gray-200');
      });
      if (btn) {
        btn.classList.add('border-brand-black', 'scale-110');
        btn.classList.remove('border-brand-gray-200');
      }

      // Dynamic image swap
      const co = colorOptions.find(c => c.name === color);
      if (co && co.images && co.images.length > 0) {
        document.getElementById('main-image').src = co.images[0];

        const thumbContainer = document.getElementById('thumbnails-container');
        if (thumbContainer) {
          thumbContainer.innerHTML = '';
          co.images.forEach((imgUrl, idx) => {
            const btnEl = document.createElement('button');
            btnEl.type = 'button';
            btnEl.onclick = () => changeImage(imgUrl);
            btnEl.className = `flex-shrink-0 w-20 h-24 sm:w-24 sm:h-32 bg-brand-gray-50 border-2 ${idx === 0 ? 'border-brand-black' : 'border-transparent'} hover:border-brand-gray-400 transition-colors focus:outline-none thumbnail-btn`;
            btnEl.innerHTML = `<img src="${imgUrl}" alt="Thumbnail ${idx + 1}" class="w-full h-full object-cover">`;
            thumbContainer.appendChild(btnEl);
          });
        }
      }

      updateAvailableSizes();
      checkVariant();
    }

    function selectSize(size) {
      if (!selectedColor) {
        if (typeof showFlash === 'function') showFlash('warning', 'Please select a color first');
        return;
      }

      selectedSize = size;

      document.querySelectorAll('.size-btn').forEach(btn => {
        if (btn.dataset.size === size) {
          btn.classList.add('border-brand-black', 'bg-brand-black', 'text-white');
        } else {
          btn.classList.remove('border-brand-black', 'bg-brand-black', 'text-white');
        }
      });

      checkVariant();
    }

    function updateAvailableSizes() {
      document.querySelectorAll('.size-btn').forEach(btn => {
        const size = btn.dataset.size;
        const variant = variants.find(v => v.color === selectedColor && v.size === size);
        const isAvailable = variant && Number(variant.stock) > 0;

        btn.classList.remove(
          'border-brand-black', 'bg-brand-black', 'text-white',
          'opacity-30', 'opacity-40', 'opacity-50',
          'pointer-events-none', 'cursor-not-allowed', 'line-through',
          'bg-gray-100', 'bg-brand-gray-100', 'text-brand-gray-400', 'border-brand-gray-200'
        );

        if (!isAvailable) {
          // Out of stock (stock = 0) or unavailable -> crossed out, disabled, NOT selectable
          btn.classList.add(
            'line-through', 'opacity-40', 'bg-brand-gray-100',
            'text-brand-gray-400', 'cursor-not-allowed', 'border-brand-gray-200'
          );
          btn.disabled = true;
          if (selectedSize === size) {
            selectedSize = null;
          }
        } else {
          // In stock (stock >= 1) -> normal, enabled, selectable
          btn.disabled = false;
          if (selectedSize === size) {
            btn.classList.add('border-brand-black', 'bg-brand-black', 'text-white');
          } else {
            btn.classList.add('border-brand-gray-200');
          }
        }
      });
    }

    function checkVariant() {
      const stockStatus = document.getElementById('stock-status');
      const priceDisplay = document.getElementById('price-display');
      const addBtn = document.getElementById('add-to-cart-btn');

      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      const qtyInput = document.getElementById('qty-input');

      const deliveryHTML = `<div class="text-brand-gray-500 mt-1 font-normal text-xs">Delivery ₹49</div>`;

      if (!selectedColor || !selectedSize) {
        if (stockStatus) {
          stockStatus.innerHTML = `<span class="text-brand-gray-500 font-medium">Please select an available size</span>${deliveryHTML}`;
        }
        if (addBtn) addBtn.disabled = true;
        if (qtyInput) qtyInput.disabled = true;
        maxStock = 0;
        updateQtyButtons();
        return;
      }

      const variant = variants.find(v => v.color === selectedColor && v.size === selectedSize);

      if (variant) {
        priceDisplay.innerHTML = `₹${variant.price.toLocaleString('en-IN')}`;
        maxStock = Number(variant.stock) || 0;

        if (maxStock > 0) {
          if (maxStock < 5) {
            stockStatus.innerHTML = `<span class="text-red-600 font-bold">Only ${maxStock} left in stock</span>${deliveryHTML}`;
          } else if (maxStock < 20) {
            stockStatus.innerHTML = `<span class="text-yellow-600 font-bold">Only ${maxStock} left in stock</span>${deliveryHTML}`;
          } else {
            stockStatus.innerHTML = `<span class="text-green-600 font-bold">In Stock</span>${deliveryHTML}`;
          }

          addBtn.disabled = false;
          qtyInput.disabled = false;
          let currentVal = parseInt(qtyInput.value) || 1;
          if (currentVal > maxStock) currentVal = maxStock;
          if (currentVal < 1) currentVal = 1;
          qtyInput.value = currentVal;
          updateQtyButtons();
        } else {
          stockStatus.innerHTML = `<span class="text-red-500 font-bold">Out of Stock</span>${deliveryHTML}`;
          addBtn.disabled = true;
          qtyInput.disabled = true;
          updateQtyButtons();
        }
      } else {
        stockStatus.innerHTML = `<span class="text-red-500 font-bold">Unavailable</span>${deliveryHTML}`;
        addBtn.disabled = true;
        qtyInput.disabled = true;
        maxStock = 0;
        updateQtyButtons();
      }
    }

    function updateQtyButtons() {
      const input = document.getElementById('qty-input');
      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      const val = parseInt(input.value) || 1;
      if (qtyMinus) qtyMinus.disabled = (val <= 1 || maxStock <= 0);
      if (qtyPlus) qtyPlus.disabled = (val >= maxStock || val >= 5 || maxStock <= 0);
    }

    function incrementQty() {
      const input = document.getElementById('qty-input');
      let val = parseInt(input.value) || 1;

      if (!selectedColor || !selectedSize) {
        if (typeof showFlash === 'function') showFlash('warning', 'Please select color and size first');
        return;
      }

      if (val < 5 && val < maxStock) {
        input.value = val + 1;
      } else if (val >= maxStock) {
        if (typeof showFlash === 'function') showFlash('warning', `Only ${maxStock} available in stock`);
      } else {
        if (typeof showFlash === 'function') showFlash('warning', 'Maximum 5 quantity allowed');
      }
      updateQtyButtons();
    }

    function decrementQty() {
      const input = document.getElementById('qty-input');
      let val = parseInt(input.value) || 1;
      if (val > 1) {
        input.value = val - 1;
      }
      updateQtyButtons();
    }

    async function addToCart() {
      if (!selectedColor || !selectedSize) {
        if (typeof showFlash === 'function') showFlash('warning', 'Please select color and size');
        return;
      }

      if (maxStock <= 0) {
        if (typeof showFlash === 'function') showFlash('error', 'This item is out of stock');
        return;
      }

      const qty = parseInt(document.getElementById('qty-input').value) || 1;
      if (qty > maxStock) {
        if (typeof showFlash === 'function') showFlash('warning', `Only ${maxStock} available in stock`);
        return;
      }

      try {
        const addBtn = document.getElementById('add-to-cart-btn');
        addBtn.disabled = true;
        addBtn.innerHTML = 'Adding...';

        const res = await fetch('/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: productId,
            color: selectedColor,
            size: selectedSize,
            quantity: qty
          })
        });

        const data = await res.json();

        if (res.ok && data.success) {
          if (typeof showFlash === 'function') showFlash('success', data.message);
          if (data.cartCount !== undefined) {
            const badge = document.getElementById('nav-cart-count');
            if (badge) {
              badge.innerText = data.cartCount;
              if (data.cartCount > 0) badge.classList.remove('hidden');
              else badge.classList.add('hidden');
            }
          }
        } else {
          // If unauthorized, redirect to login
          if (res.status === 401) {
            document.getElementById('login-modal').classList.remove('hidden');
            return;
          }
          if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to add to cart');
        }
      } catch (error) {
        console.error(error);
        if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
      } finally {
        const addBtn = document.getElementById('add-to-cart-btn');
        addBtn.disabled = false;
        addBtn.innerHTML = 'Add to Cart';
      }
    }

    async function toggleWishlistDetails() {
      if (!selectedColor || !selectedSize) {
        if (typeof showFlash === 'function') showFlash('warning', 'Please select color and size first');
        return;
      }

      try {
        const res = await fetch('/wishlist/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: '<%= product._id %>',
            color: selectedColor,
            size: selectedSize
          })
        });

        if (res.status === 401) {
          window.location.href = '/login';
          return;
        }

        const data = await res.json();
        if (res.ok && data.success) {
          if (typeof window.updateNavCounts === 'function') {
            window.updateNavCounts(undefined, data.wishlistCount);
          }
          const heartIcon = document.getElementById('wishlist-heart-icon');
          if (data.action === 'added') {
            heartIcon.classList.remove('text-brand-gray-400');
            heartIcon.classList.add('text-red-500', 'fill-current');
            heartIcon.setAttribute('fill', 'currentColor');
            if (typeof showFlash === 'function') showFlash('success', 'Added to wishlist');
          } else {
            heartIcon.classList.remove('text-red-500', 'fill-current');
            heartIcon.classList.add('text-brand-gray-400');
            heartIcon.setAttribute('fill', 'none');
            if (typeof showFlash === 'function') showFlash('success', 'Removed from wishlist');
          }
        } else {
          if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to update wishlist');
        }
      } catch (error) {
        console.error(error);
        if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
      }
    }

  </script>

  <!-- Size Chart Modal -->
