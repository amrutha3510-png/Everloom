    aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeSizeChart()"
        aria-hidden="true"></div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div
        class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full p-6 sm:p-8">
        <div class="flex justify-between items-center pb-4 border-b border-brand-gray-100">
          <h3 class="font-serif text-xl font-bold text-brand-black" id="modal-title">Size Chart</h3>
          <button type="button" onclick="closeSizeChart()"
            class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="mt-6">
          <table class="w-full text-left border-collapse font-sans text-sm">
            <thead>
              <tr class="border-b border-brand-gray-200 text-brand-black font-semibold">
                <th class="py-3 pr-4">Size</th>
                <th class="py-3 px-4">Chest (in)</th>
                <th class="py-3 pl-4">Length (in)</th>
              </tr>
            </thead>
            <tbody class="text-brand-gray-600">
              <tr class="border-b border-brand-gray-100 hover:bg-brand-gray-50/50 transition-colors">
                <td class="py-3 pr-4 font-medium text-brand-black">XS</td>
                <td class="py-3 px-4">36</td>
                <td class="py-3 pl-4">26</td>
              </tr>
              <tr class="border-b border-brand-gray-100 hover:bg-brand-gray-50/50 transition-colors">
                <td class="py-3 pr-4 font-medium text-brand-black">S</td>
                <td class="py-3 px-4">38</td>
                <td class="py-3 pl-4">27</td>
              </tr>
              <tr class="border-b border-brand-gray-100 hover:bg-brand-gray-50/50 transition-colors">
                <td class="py-3 pr-4 font-medium text-brand-black">M</td>
                <td class="py-3 px-4">40</td>
                <td class="py-3 pl-4">28</td>
              </tr>
              <tr class="border-b border-brand-gray-100 hover:bg-brand-gray-50/50 transition-colors">
                <td class="py-3 pr-4 font-medium text-brand-black">L</td>
                <td class="py-3 px-4">42</td>
                <td class="py-3 pl-4">29</td>
              </tr>
              <tr class="border-b border-brand-gray-100 hover:bg-brand-gray-50/50 transition-colors">
                <td class="py-3 pr-4 font-medium text-brand-black">XL</td>
                <td class="py-3 px-4">44</td>
                <td class="py-3 pl-4">30</td>
              </tr>
              <tr class="border-b border-brand-gray-100 hover:bg-brand-gray-50/50 transition-colors">
                <td class="py-3 pr-4 font-medium text-brand-black">XXL</td>
                <td class="py-3 px-4">46</td>
                <td class="py-3 pl-4">31</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt-6 pt-4 border-t border-brand-gray-100 text-xs text-brand-gray-400 font-sans">
          * Measurements are in inches and refer to garment dimensions. Please allow +/- 0.5" tolerance.
        </div>
      </div>
    </div>
  </div>

  <script>
    window.openSizeChart = function () {
      const modal = document.getElementById('size-chart-modal');
      if (modal) {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeSizeChart = function () {
      const modal = document.getElementById('size-chart-modal');
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }
    };
  </script>

  <!-- Product Review Modal -->
  <div id="review-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeReviewModal()"></div>

      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

      <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full p-6 sm:p-8">
        <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
          <div>
            <h3 class="font-serif text-xl font-bold text-brand-black" id="modal-review-heading">Write a Review</h3>
            <p class="font-sans text-xs text-brand-gray-500 mt-0.5 line-clamp-1" id="modal-review-product-name"><%= product.name %></p>
          </div>
          <button type="button" onclick="closeReviewModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <form id="modal-review-form" class="mt-6 font-sans text-sm space-y-4" onsubmit="handleModalReviewSubmit(event)" novalidate>
          <input type="hidden" id="modal-review-product-id" value="<%= product._id %>">
          <input type="hidden" id="modal-review-rating-val" value="">

          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-2">
              Rating <span class="text-red-500">*</span>
            </label>
            <div class="flex items-center gap-1 cursor-pointer select-none" id="modal-star-picker">
              <% for (let i = 1; i <= 5; i++) { %>
                <button type="button" onclick="setModalRating(<%= i %>)" onmouseover="hoverModalRating(<%= i %>)" onmouseleave="resetHoverModalRating()"
                  class="modal-star-btn text-2xl focus:outline-none transition-colors text-brand-gray-300"
                  data-star="<%= i %>"
                  title="<%= i %> star<%= i > 1 ? 's' : '' %>">
                  ★
                </button>
              <% } %>
            </div>
            <p class="hidden text-red-500 text-xs mt-1.5 font-sans" id="modalRatingError">Please select a rating between 1 and 5 stars.</p>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">
              Review Title (Optional)
            </label>
            <input type="text" id="modal-review-title" placeholder="Summarize your review..."
              class="w-full px-3 py-2 border border-brand-gray-200 focus:outline-none focus:border-brand-black bg-white font-sans text-sm">
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">
              Your Review <span class="text-red-500">*</span>
            </label>
            <textarea id="modal-review-comment" rows="4" placeholder="Write your review details here..." required
              class="w-full px-3 py-2 border border-brand-gray-200 focus:outline-none focus:border-brand-black bg-white font-sans text-sm"></textarea>
            <p class="hidden text-red-500 text-xs mt-1.5 font-sans" id="modalCommentError">Review text is required.</p>
          </div>

          <div class="pt-4 flex gap-3">
            <button type="button" onclick="closeReviewModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Cancel</button>
            <button type="submit" id="modal-submit-review-btn" class="flex-1 py-2.5 bg-brand-black hover:bg-brand-gray-600 text-white font-sans font-bold uppercase tracking-wider text-xs transition-colors">Submit Review</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let modalCurrentRating = 0;

    function openReviewModal(prodId, prodName, existingRating, existingTitle, existingComment) {
      document.getElementById('modal-review-product-id').value = prodId || productId;
      document.getElementById('modal-review-product-name').textContent = prodName || productData.name;

      const isEdit = !!existingRating;
      document.getElementById('modal-review-heading').textContent = isEdit ? 'Edit Your Review' : 'Write a Review';
      document.getElementById('modal-submit-review-btn').textContent = isEdit ? 'Update Review' : 'Submit Review';

      document.getElementById('modal-review-title').value = existingTitle || '';
      document.getElementById('modal-review-comment').value = existingComment || '';

      modalCurrentRating = existingRating || 0;
      document.getElementById('modal-review-rating-val').value = modalCurrentRating || '';
      updateModalStarVisuals(modalCurrentRating);

      document.getElementById('modalRatingError')?.classList.add('hidden');
      document.getElementById('modalCommentError')?.classList.add('hidden');

      document.getElementById('review-modal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeReviewModal() {
      document.getElementById('review-modal').classList.add('hidden');
      document.body.style.overflow = '';
    }

    function setModalRating(rating) {
      modalCurrentRating = rating;
      document.getElementById('modal-review-rating-val').value = rating;
      document.getElementById('modalRatingError')?.classList.add('hidden');
      updateModalStarVisuals(rating);
    }

    function hoverModalRating(rating) {
      updateModalStarVisuals(rating);
    }

    function resetHoverModalRating() {
      updateModalStarVisuals(modalCurrentRating);
    }

    function updateModalStarVisuals(rating) {
      const stars = document.querySelectorAll('#modal-star-picker .modal-star-btn');
      stars.forEach(btn => {
        const starVal = parseInt(btn.dataset.star);
        if (starVal <= rating) {
          btn.classList.remove('text-brand-gray-300');
          btn.classList.add('text-yellow-400');
        } else {
          btn.classList.remove('text-yellow-400');
          btn.classList.add('text-brand-gray-300');
        }
      });
    }

    async function handleModalReviewSubmit(e) {
      e.preventDefault();
      const pId = document.getElementById('modal-review-product-id').value;
      const ratingVal = parseInt(document.getElementById('modal-review-rating-val').value);
      const title = document.getElementById('modal-review-title').value;
      const comment = document.getElementById('modal-review-comment').value;

      let hasError = false;

      if (!ratingVal || isNaN(ratingVal) || ratingVal < 1 || ratingVal > 5) {
        document.getElementById('modalRatingError')?.classList.remove('hidden');
        hasError = true;
      } else {
        document.getElementById('modalRatingError')?.classList.add('hidden');
      }

      if (!comment || !comment.trim()) {
        document.getElementById('modalCommentError')?.classList.remove('hidden');
        hasError = true;
      } else {
        document.getElementById('modalCommentError')?.classList.add('hidden');
      }

      if (hasError) return;

      const submitBtn = document.getElementById('modal-submit-review-btn');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Saving...';
      }

      try {
        const res = await fetch(`/shop/product/${pId}/review`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rating: ratingVal, title, comment })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          closeReviewModal();
          if (typeof showFlash === 'function') showFlash('success', data.message);
          setTimeout(() => window.location.reload(), 800);
        } else {
          if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to submit review');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Submit Review';
          }
        }
      } catch (error) {
        console.error(error);
        if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Review';
      }
    }

    function showProductCouponInfo(selectEl) {
      if (!selectEl) return;
      const val = selectEl.value;
      const opt = selectEl.options[selectEl.selectedIndex];
      const infoContainer = document.getElementById('product-coupon-details');

      if (!val || !opt || !opt.value) {
        if (infoContainer) infoContainer.classList.add('hidden');
        return;
      }

      const type = opt.getAttribute('data-type') || 'COUPON';
      const name = opt.getAttribute('data-name') || val;
      const discount = opt.getAttribute('data-discount') || '';
      const min = opt.getAttribute('data-min') || '0';
      const desc = opt.getAttribute('data-desc') || '';

      const badgeEl = document.getElementById('product-coupon-type-badge');
      const codeEl = document.getElementById('product-coupon-code');
      const discEl = document.getElementById('product-coupon-discount');
      const descEl = document.getElementById('product-coupon-desc');
      const minEl = document.getElementById('product-coupon-min');

      if (badgeEl) {
        badgeEl.textContent = type;
        if (type === 'OFFER') {
          badgeEl.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded uppercase bg-green-100 text-green-800 border border-green-200';
        } else {
          badgeEl.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded uppercase bg-blue-100 text-blue-800 border border-blue-200';
        }
      }

      if (codeEl) codeEl.textContent = name;
      if (discEl) discEl.textContent = discount;
      if (descEl) descEl.textContent = desc || `${discount} discount applied.`;
      if (minEl) {
        if (type === 'COUPON') {
          minEl.textContent = Number(min) > 0 ? `Minimum order amount: ₹${min}` : 'No minimum purchase required.';
        } else {
          minEl.textContent = 'Discount automatically applied on item price.';
        }
      }

      if (infoContainer) infoContainer.classList.remove('hidden');
    }
  </script>

