<%- include('../partials/navbar') %>

<main class="min-h-screen bg-brand-gray-50 pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-sans text-brand-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-black transition-colors">Home</a>
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      <a href="/account/profile" class="hover:text-brand-black transition-colors">My Account</a>
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      <span class="text-brand-black font-medium">My Wallet</span>
    </nav>

    <!-- Page header -->
    <p class="font-sans text-xs uppercase tracking-widest text-brand-gray-400 mb-1">Account Dashboard</p>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-black mb-1">EverLoom Wallet</h1>
    <p class="font-sans text-sm text-brand-gray-400 mb-8 max-w-2xl font-normal">View your main wallet balance and review your complete credit &amp; debit transaction history.</p>

    <!-- Two-column layout -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">

      <!-- Sidebar -->
      <%- include('../partials/account-sidebar') %>

      <!-- Main content -->
      <div class="flex-1 flex flex-col gap-8">

        <!-- Main Balance Card -->
        <div class="bg-white border border-brand-gray-200 shadow-sm p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-brand-gray-400 block mb-1">EverLoom Wallet</span>
            <div class="flex items-baseline gap-2">
              <span class="font-sans text-xs text-brand-gray-500">Main Balance:</span>
              <span class="font-serif text-3xl sm:text-4xl font-bold text-brand-black">₹<%= typeof walletBalance !== 'undefined' ? walletBalance.toLocaleString('en-IN') : 0 %></span>
            </div>
            <p class="font-sans text-xs text-brand-gray-500 mt-2">Use your wallet balance for instant checkouts &amp; hassle-free refunds.</p>
          </div>

          <div class="flex items-center gap-2 bg-green-50 border border-green-200 px-4 py-2 rounded-md">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span class="font-sans text-xs font-bold text-green-700 uppercase tracking-wider">Active Wallet</span>
          </div>
        </div>

        <!-- Wallet Transaction History Card -->
        <div class="bg-white border border-brand-gray-200 shadow-sm p-6 sm:p-8">
          <div class="border-b border-brand-gray-100 pb-4 mb-6">
            <h2 class="font-serif text-xl font-bold text-brand-black">Transaction History</h2>
            <p class="font-sans text-xs text-brand-gray-500 mt-0.5">All credit and debit activities linked to your EverLoom account.</p>
          </div>

          <!-- Desktop Transactions Table -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-brand-gray-200 bg-brand-gray-50 text-[10px] font-sans font-bold text-brand-gray-500 uppercase tracking-widest2">
                  <th class="px-4 py-3">Date</th>
                  <th class="px-4 py-3">Description / Reason</th>
                  <th class="px-4 py-3 text-center">Type</th>
                  <th class="px-4 py-3 text-right">Amount</th>
                  <th class="px-4 py-3 text-right">Balance</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-gray-100 font-sans text-xs text-brand-black">
                <% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
                  <% transactions.forEach(tx => { %>
                    <tr class="hover:bg-brand-gray-50/50 transition-colors">
                      <td class="px-4 py-4 text-brand-gray-500 font-medium">
                        <%= new Date(tx.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                      </td>
                      <td class="px-4 py-4 font-semibold text-brand-black">
                        <%= tx.description %>
                      </td>
                      <td class="px-4 py-4 text-center">
                        <span class="px-2.5 py-1 inline-flex text-[10px] leading-4 font-bold uppercase tracking-wider rounded-md 
                          <%= tx.type === 'Credit' ? 'bg-green-100 text-green-700 border border-green-200' : 'bg-red-100 text-red-700 border border-red-200' %>">
                          <%= tx.type %>
                        </span>
                      </td>
                      <td class="px-4 py-4 text-right font-bold text-sm <%= tx.type === 'Credit' ? 'text-green-600' : 'text-red-600' %>">
                        <%= tx.type === 'Credit' ? '+' : '-' %>₹<%= tx.amount.toLocaleString('en-IN') %>
                      </td>
                      <td class="px-4 py-4 text-right text-brand-gray-500 font-medium">
                        ₹<%= (tx.runningBalance !== undefined ? tx.runningBalance : 0).toLocaleString('en-IN') %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center text-brand-gray-400 text-xs">
                      No wallet transactions found.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Mobile Transactions Card List -->
          <div class="block md:hidden divide-y divide-brand-gray-100">
            <% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
              <% transactions.forEach(tx => { %>
                <div class="py-4 flex flex-col gap-2 font-sans text-xs">
                  <div class="flex justify-between items-start">
                    <div>
                      <span class="font-bold text-brand-black text-sm block"><%= tx.description %></span>
                      <span class="text-[10px] text-brand-gray-400 block mt-0.5">
                        <%= new Date(tx.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </span>
                    </div>
                    <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded-md 
                      <%= tx.type === 'Credit' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                      <%= tx.type %>
                    </span>
                  </div>

                  <div class="flex justify-between items-center pt-2 border-t border-brand-gray-50 mt-1">
                    <span class="text-brand-gray-500 text-[11px]">Running Balance: ₹<%= (tx.runningBalance || 0).toLocaleString('en-IN') %></span>
                    <span class="font-bold text-sm <%= tx.type === 'Credit' ? 'text-green-600' : 'text-red-600' %>">
                      <%= tx.type === 'Credit' ? '+' : '-' %>₹<%= tx.amount.toLocaleString('en-IN') %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="py-10 text-center text-brand-gray-400 text-xs">
                No wallet transactions found.
              </div>
            <% } %>
          </div>

        </div>

      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
