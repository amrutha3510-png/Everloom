<%- include('../partials/navbar') %>

<main class="min-h-screen bg-brand-gray-50 pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex text-sm text-brand-gray-500 font-sans mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-brand-black transition-colors">Home</a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <a href="/account/orders" class="hover:text-brand-black transition-colors">My Orders</a>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <span class="text-brand-black font-medium">Track #<%= order.orderId %></span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
      <!-- Sidebar navigation -->
      <%- include('../partials/account-sidebar') %>

      <!-- Main Content -->
      <div class="flex-1">
        <div class="bg-white border border-brand-gray-200 p-6 sm:p-8 shadow-sm flex flex-col gap-8">
          
          <!-- Header and Basic Order Info -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-brand-gray-100 pb-6">
            <div>
              <span class="text-[10px] text-brand-gray-400 font-sans uppercase tracking-widest2">Track Shipment</span>
              <h1 class="font-serif text-2xl sm:text-3xl font-bold text-brand-black mt-0.5">Order #<%= order.orderId %></h1>
              <p class="font-sans text-xs text-brand-gray-500 mt-1">
                Placed on <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </p>
            </div>
            
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 inline-flex text-xs font-semibold rounded-md 
                <%= order.status === 'Delivered' || order.status === 'Returned' ? 'bg-green-100 text-green-700' : 
                    order.status === 'Cancelled' ? 'bg-red-100 text-red-700' : 
                    order.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 'bg-blue-100 text-blue-700' %>">
                <%= order.status %>
              </span>
              <a href="/account/orders/<%= order.orderId %>" class="px-4 py-2 border border-brand-gray-200 text-brand-black hover:bg-brand-gray-50 font-sans text-xs font-bold uppercase tracking-wider transition-colors">
                View Details
              </a>
            </div>
          </div>

          <!-- Order Tracking Status Timeline -->
          <div class="bg-brand-gray-50 p-6 border border-brand-gray-150 rounded-md">
            <h2 class="font-serif text-lg font-bold text-brand-black mb-6">Delivery Progress</h2>

            <% 
              const steps = [
                { key: 'Pending', label: 'Order Placed', desc: 'Your order has been received' },
                { key: 'Shipped', label: 'Shipped', desc: 'Package handed to delivery partner' },
                { key: 'Out for Delivery', label: 'Out for Delivery', desc: 'Courier is out for delivery' },
                { key: 'Delivered', label: 'Delivered', desc: 'Package successfully delivered' }
              ];

              const statusOrder = ['Pending', 'Shipped', 'Out for Delivery', 'Delivered'];
              const currentIdx = statusOrder.indexOf(order.status);
              const isCancelled = order.status === 'Cancelled';
            %>

            <% if (isCancelled) { %>
              <!-- Cancelled Timeline Display -->
              <div class="flex items-center gap-4 p-4 bg-red-50 border border-red-200 rounded-md">
                <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-sans font-bold text-sm text-red-700">Order Cancelled</h3>
                  <p class="font-sans text-xs text-red-600 mt-0.5">
                    <%= order.cancellationReason ? 'Reason: ' + order.cancellationReason : 'This order was cancelled and will not be delivered.' %>
                  </p>
                </div>
              </div>
            <% } else { %>
              <!-- Standard Progress Timeline -->
              <div class="relative font-sans">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 md:gap-4 relative">
                  <% steps.forEach((step, idx) => { 
                    const isCompleted = currentIdx >= idx;
                    const isCurrent = currentIdx === idx;
                  %>
                    <div class="flex md:flex-col items-start gap-4 md:gap-3 relative">
                      <!-- Status Circle Icon -->
                      <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold transition-colors z-10
                        <%= isCompleted ? 'bg-brand-black text-white' : 'bg-white border-2 border-brand-gray-300 text-brand-gray-400' %>">
                        <% if (isCompleted && currentIdx > idx) { %>
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                        <% } else { %>
                          <%= idx + 1 %>
                        <% } %>
                      </div>

                      <!-- Step Details -->
                      <div class="flex-1">
                        <h3 class="text-xs font-bold uppercase tracking-wider <%= isCompleted ? 'text-brand-black' : 'text-brand-gray-400' %>">
                          <%= step.label %>
                        </h3>
                        <p class="text-[11px] text-brand-gray-500 mt-0.5 leading-tight">
                          <%= step.desc %>
                        </p>
                        <% if (isCurrent) { %>
                          <span class="inline-block mt-1.5 text-[9px] font-bold uppercase tracking-widest text-brand-black bg-brand-gray-200 px-2 py-0.5 rounded">
                            Current Status
                          </span>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Shipping Summary -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-brand-gray-100 pt-6">
            <div>
              <h3 class="font-serif text-base font-bold text-brand-black mb-3">Delivery Address</h3>
              <div class="font-sans text-xs text-brand-gray-600 space-y-1">
                <p class="font-semibold text-brand-black text-sm"><%= order.shippingAddress.fullName %></p>
                <p>Phone: <%= order.shippingAddress.phone %></p>
                <p><%= order.shippingAddress.addressLine1 %></p>
                <% if (order.shippingAddress.addressLine2) { %>
                  <p><%= order.shippingAddress.addressLine2 %></p>
                <% } %>
                <p><%= order.shippingAddress.locality %>, <%= order.shippingAddress.city %></p>
                <p><%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
                <p><%= order.shippingAddress.country %></p>
              </div>
            </div>

            <div>
              <h3 class="font-serif text-base font-bold text-brand-black mb-3">Package Contents</h3>
              <div class="divide-y divide-brand-gray-100 font-sans text-xs space-y-2">
                <% order.items.forEach(item => { %>
                  <div class="flex items-center justify-between pt-2 first:pt-0">
                    <div class="flex items-center gap-2">
                      <span class="font-medium text-brand-black"><%= item.product ? item.product.name : 'Product' %></span>
                      <span class="text-brand-gray-400">× <%= item.quantity %></span>
                    </div>
                    <span class="text-brand-gray-500 text-[11px]"><%= item.variant.size %> / <%= item.variant.color %></span>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
