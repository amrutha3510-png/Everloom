<%- include('../partials/navbar') %>

<main class="min-h-screen bg-brand-gray-50 pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex text-sm text-brand-gray-500 font-sans mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-brand-black transition-colors">Home</a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <a href="/account/orders" class="hover:text-brand-black transition-colors">My Orders</a>
          </div>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <span class="text-brand-black font-medium">#<%= order.orderId %></span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
      <!-- Sidebar navigation -->
      <%- include('../partials/account-sidebar') %>

      <!-- Main Content -->
      <div class="flex-1">
        <div class="bg-white border border-brand-gray-200 p-6 sm:p-8 shadow-sm flex flex-col gap-8">
          
          <!-- Header and Basic Order Info -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-brand-gray-100 pb-6">
            <div>
              <span class="text-[10px] text-brand-gray-400 font-sans uppercase tracking-widest2">Order ID</span>
              <h1 class="font-serif text-2xl font-bold text-brand-black mt-0.5">#<%= order.orderId %></h1>
              <p class="font-sans text-xs text-brand-gray-500 mt-1">
                Placed on <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit' }) %>
              </p>
            </div>
            
            <div class="flex flex-wrap gap-2">
              <a href="/account/orders/<%= order.orderId %>/invoice" class="px-4 py-2 border border-brand-gray-200 hover:bg-brand-gray-50 text-brand-black font-sans text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Download Invoice
              </a>

              <% if (order.status === 'Pending' || order.status === 'Shipped') { %>
                <button type="button" onclick="openCancelModal()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-sans text-xs font-bold uppercase tracking-wider transition-colors">
                  Cancel Order
                </button>
              <% } else if (order.status === 'Delivered') { %>
                <button type="button" onclick="openReturnModal()" class="px-4 py-2 bg-brand-black hover:bg-brand-gray-600 text-white font-sans text-xs font-bold uppercase tracking-wider transition-colors">
                  Return Order
                </button>
              <% } %>
            </div>
          </div>

          <!-- Status Box -->
          <div class="bg-brand-gray-50 p-4 border border-brand-gray-150 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full 
                <%= order.status === 'Delivered' || order.status === 'Returned' ? 'bg-green-500' : 
                    order.status === 'Cancelled' ? 'bg-red-500' : 
                    order.status === 'Pending' ? 'bg-yellow-500' : 'bg-blue-500' %>">
              </span>
              <div>
                <span class="font-sans text-xs font-semibold text-brand-gray-400 uppercase tracking-wider block">Order Status</span>
                <span class="font-sans font-bold text-brand-black text-sm block mt-0.5"><%= order.status %></span>
              </div>
            </div>
            
            <% if (order.status === 'Cancelled' && order.cancellationReason) { %>
              <div class="text-xs font-sans text-brand-gray-600 max-w-sm">
                <span class="font-bold">Cancellation Reason:</span> <%= order.cancellationReason %>
              </div>
            <% } else if (order.returnReason || (typeof order.returnStatus !== 'undefined' && order.returnStatus !== 'None')) { %>
              <div class="text-xs font-sans text-brand-gray-600 max-w-sm space-y-1">
                <div>
                  <span class="font-bold">Return Status:</span> 
                  <span class="<%= order.returnStatus === 'Declined' ? 'text-red-600 font-bold' : (order.returnStatus === 'Approved' || order.status === 'Returned' ? 'text-green-600 font-bold' : 'text-yellow-600 font-bold') %>">
                    <%= order.returnStatus === 'Declined' ? 'Declined' : (order.returnStatus === 'Approved' || order.status === 'Returned' ? 'Approved' : 'Pending') %>
                  </span>
                </div>
                <% if (order.returnReason) { %>
                  <div><span class="font-bold">Return Reason:</span> <%= order.returnReason %></div>
                <% } %>
              </div>
            <% } %>
          </div>

          <!-- Shipping Details & Payment Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-b border-brand-gray-100 pb-8">
            <div>
              <h3 class="font-serif text-base font-bold text-brand-black mb-3">Shipping Details</h3>
              <div class="font-sans text-xs text-brand-gray-600 space-y-1">
                <p class="font-semibold text-brand-black text-sm"><%= order.shippingAddress.fullName %></p>
                <p>Phone: <%= order.shippingAddress.phone %></p>
                <p><%= order.shippingAddress.addressLine1 %></p>
                <% if (order.shippingAddress.addressLine2) { %>
                  <p><%= order.shippingAddress.addressLine2 %></p>
                <% } %>
                <p><%= order.shippingAddress.locality %>, <%= order.shippingAddress.city %></p>
                <p><%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></p>
                <p><%= order.shippingAddress.country %></p>
              </div>
            </div>

            <div>
              <h3 class="font-serif text-base font-bold text-brand-black mb-3">Payment Information</h3>
              <div class="font-sans text-xs text-brand-gray-600 space-y-1">
                <p>Method: <span class="font-semibold text-brand-black"><%= order.paymentMethod %></span></p>
                <p>Status: <span class="font-semibold text-brand-black">Pending Settlement</span></p>
              </div>
            </div>
          </div>

          <!-- Ordered Products Table -->
          <div>
            <h3 class="font-serif text-base font-bold text-brand-black mb-4">Ordered Items</h3>
            <div class="border border-brand-gray-200 shadow-sm overflow-hidden">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-brand-gray-200 bg-brand-gray-50 text-[10px] font-sans font-bold text-brand-gray-500 uppercase tracking-widest2">
                    <th class="px-4 py-3">Product</th>
                    <th class="px-4 py-3 text-center">Price</th>
                    <th class="px-4 py-3 text-center">Qty</th>
                    <th class="px-4 py-3 text-center">Status / Action</th>
                    <th class="px-4 py-3 text-right">Total</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-brand-gray-100 font-sans text-xs text-brand-black">
                  <% order.items.forEach(item => { %>
                    <tr class="hover:bg-brand-gray-50/50 transition-colors">
                      <td class="px-4 py-4 flex items-center gap-3">
                        <div class="w-12 h-16 bg-brand-gray-50 border border-brand-gray-150 overflow-hidden flex-shrink-0">
                          <% 
                            let itemImg = null;
                            if (item.product) {
                              if (item.product.images && item.product.images.length > 0) {
                                itemImg = item.product.images[0];
                              } else if (item.product.colorOptions && item.product.colorOptions.length > 0) {
                                const matchedCo = item.product.colorOptions.find(co => 
                                  co.name && item.variant && item.variant.color && 
                                  co.name.toLowerCase() === item.variant.color.toLowerCase()
                                );
                                if (matchedCo && matchedCo.images && matchedCo.images.length > 0) {
                                  itemImg = matchedCo.images[0];
                                } else if (item.product.colorOptions[0].images && item.product.colorOptions[0].images.length > 0) {
                                  itemImg = item.product.colorOptions[0].images[0];
                                }
                              }
                            }
                          %>
                          <% if (itemImg) { %>
                            <img src="<%= itemImg %>" alt="<%= item.product ? item.product.name : 'Product Image' %>" class="w-full h-full object-cover">
                          <% } else { %>
                            <div class="w-full h-full flex items-center justify-center bg-brand-gray-100 text-brand-gray-400 text-[10px]">No Img</div>
                          <% } %>
                        </div>
                        <div>
                          <h4 class="font-serif font-bold text-sm text-brand-black"><%= item.product ? item.product.name : 'Unknown Product' %></h4>
                          <span class="text-[10px] text-brand-gray-500 uppercase tracking-wider block mt-0.5">Size: <%= item.variant.size %> / Color: <%= item.variant.color %></span>
                        </div>
                      </td>
                      <td class="px-4 py-4 text-center">₹<%= item.price %></td>
                      <td class="px-4 py-4 text-center"><%= item.quantity %></td>
                      <td class="px-4 py-4 text-center">
                        <% if (item.status === 'Cancelled') { %>
                          <span class="inline-block px-2.5 py-1 text-[10px] font-bold text-red-600 bg-red-50 border border-red-200 rounded uppercase tracking-wider">Cancelled</span>
                        <% } else if ((order.status === 'Pending' || order.status === 'Shipped') && order.items.length > 1) { %>
                          <button type="button" onclick="openItemCancelModal('<%= item._id %>')" class="px-2.5 py-1 text-[10px] font-bold text-red-600 border border-red-200 hover:bg-red-50 rounded uppercase tracking-wider transition-colors">
                            Cancel Item
                          </button>
                        <% } else { %>
                          <span class="inline-block px-2.5 py-1 text-[10px] font-bold text-brand-gray-600 bg-brand-gray-50 border border-brand-gray-200 rounded uppercase tracking-wider">
                            <%= item.status || order.status %>
                          </span>
                        <% } %>
                      </td>
                      <td class="px-4 py-4 text-right font-semibold">₹<%= item.price * item.quantity %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pricing Totals Calculations -->
          <div class="flex justify-end pt-4">
            <div class="w-full sm:w-64 font-sans text-xs text-brand-gray-600 space-y-3">
              <% 
                const subtotal = order.items.reduce((sum, item) => sum + (item.price * item.quantity), 0);
              %>
              <div class="flex justify-between">
                <span>Subtotal</span>
                <span class="font-medium text-brand-black">₹<%= subtotal %></span>
              </div>
              
              <% if (order.discountAmount > 0) { %>
                <div class="flex justify-between text-green-600">
                  <span>Discount (<%= order.couponCode %>)</span>
                  <span class="font-medium">-₹<%= order.discountAmount %></span>
                </div>
              <% } %>

              <div class="flex justify-between">
                <span>Shipping</span>
                <span class="font-medium text-brand-black">₹<%= order.shippingCharge %></span>
              </div>

              <div class="border-t border-brand-gray-150 pt-3 flex justify-between font-bold text-brand-black text-sm">
                <span>Grand Total</span>
                <span>₹<%= order.totalAmount %></span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</main>

<!-- Cancellation Reason Modal -->
<div id="cancel-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeCancelModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Cancel Entire Order</h3>
        <button type="button" onclick="closeCancelModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="cancel-form" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-2">Reason for cancellation (Mandatory)</label>
          <textarea id="cancellationReason" rows="3" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black bg-white placeholder-brand-gray-400 transition-colors" placeholder="Please let us know why you are cancelling..."></textarea>
          <p class="hidden text-red-500 text-xs mt-1.5 font-sans pl-1" id="cancellationReasonError">Cancellation reason is required.</p>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeCancelModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Go Back</button>
          <button type="submit" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-sans font-bold uppercase tracking-wider text-xs transition-colors">Confirm Cancellation</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Single Item Cancellation Reason Modal -->
<div id="cancel-item-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeItemCancelModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Cancel Product Item</h3>
        <button type="button" onclick="closeItemCancelModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="cancel-item-form" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <input type="hidden" id="cancelTargetItemId" value="">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-2">Reason for item cancellation (Mandatory)</label>
          <textarea id="itemCancellationReason" rows="3" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black bg-white placeholder-brand-gray-400 transition-colors" placeholder="Please state why you are cancelling this item..."></textarea>
          <p class="hidden text-red-500 text-xs mt-1.5 font-sans pl-1" id="itemCancellationReasonError">Cancellation reason is required.</p>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeItemCancelModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Go Back</button>
          <button type="submit" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-sans font-bold uppercase tracking-wider text-xs transition-colors">Confirm Item Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Return Reason Modal -->
<div id="return-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeReturnModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Return Order</h3>
        <button type="button" onclick="closeReturnModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="return-form" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-2">Reason for Return (Mandatory)</label>
          <textarea id="returnReason" rows="3" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black bg-white placeholder-brand-gray-400 transition-colors" placeholder="Please write a detailed reason for returning the item(s)..."></textarea>
          <p class="hidden text-red-500 text-xs mt-1.5 font-sans pl-1" id="returnReasonError">Return reason is mandatory.</p>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeReturnModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Go Back</button>
          <button type="submit" class="flex-1 py-2.5 bg-brand-black hover:bg-brand-gray-600 text-white font-sans font-bold uppercase tracking-wider text-xs transition-colors">Submit Return Request</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Full Cancel Modal functions
  function openCancelModal() {
    document.getElementById('cancel-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeCancelModal() {
    document.getElementById('cancel-modal').classList.add('hidden');
    document.body.style.overflow = '';
    const errorEl = document.getElementById('cancellationReasonError');
    if (errorEl) errorEl.classList.add('hidden');
    const textarea = document.getElementById('cancellationReason');
    if (textarea) {
      textarea.classList.remove('border-red-500', 'focus:border-red-500');
      textarea.classList.add('border-brand-gray-200', 'focus:border-brand-black');
    }
  }

  // Single Item Cancel Modal functions
  function openItemCancelModal(itemId) {
    document.getElementById('cancelTargetItemId').value = itemId;
    document.getElementById('cancel-item-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeItemCancelModal() {
    document.getElementById('cancel-item-modal').classList.add('hidden');
    document.body.style.overflow = '';
    const errorEl = document.getElementById('itemCancellationReasonError');
    if (errorEl) errorEl.classList.add('hidden');
    const textarea = document.getElementById('itemCancellationReason');
    if (textarea) {
      textarea.classList.remove('border-red-500', 'focus:border-red-500');
      textarea.classList.add('border-brand-gray-200', 'focus:border-brand-black');
    }
  }

  // Clear validation styling when user inputs text
  const cancelTextarea = document.getElementById('cancellationReason');
  if (cancelTextarea) {
    cancelTextarea.addEventListener('input', function() {
      if (this.value.trim()) {
        this.classList.remove('border-red-500', 'focus:border-red-500');
        this.classList.add('border-brand-gray-200', 'focus:border-brand-black');
        const errorEl = document.getElementById('cancellationReasonError');
        if (errorEl) errorEl.classList.add('hidden');
      }
    });
  }

  const itemCancelTextarea = document.getElementById('itemCancellationReason');
  if (itemCancelTextarea) {
    itemCancelTextarea.addEventListener('input', function() {
      if (this.value.trim()) {
        this.classList.remove('border-red-500', 'focus:border-red-500');
        this.classList.add('border-brand-gray-200', 'focus:border-brand-black');
        const errorEl = document.getElementById('itemCancellationReasonError');
        if (errorEl) errorEl.classList.add('hidden');
      }
    });
  }

  // Return Modal functions
  function openReturnModal() {
    document.getElementById('return-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeReturnModal() {
    document.getElementById('return-modal').classList.add('hidden');
    document.body.style.overflow = '';
    const errorEl = document.getElementById('returnReasonError');
    if (errorEl) errorEl.classList.add('hidden');
    const textarea = document.getElementById('returnReason');
    if (textarea) {
      textarea.classList.remove('border-red-500', 'focus:border-red-500');
      textarea.classList.add('border-brand-gray-200', 'focus:border-brand-black');
    }
  }

  const returnTextarea = document.getElementById('returnReason');
  if (returnTextarea) {
    returnTextarea.addEventListener('input', function() {
      if (this.value.trim()) {
        this.classList.remove('border-red-500', 'focus:border-red-500');
        this.classList.add('border-brand-gray-200', 'focus:border-brand-black');
        const errorEl = document.getElementById('returnReasonError');
        if (errorEl) errorEl.classList.add('hidden');
      }
    });
  }

  // Full Order Cancel submission
  document.getElementById('cancel-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = document.getElementById('cancellationReason');
    const errorEl = document.getElementById('cancellationReasonError');
    const reason = textarea ? textarea.value.trim() : '';
    
    if (!reason) {
      if (errorEl) {
        errorEl.textContent = 'Cancellation reason is required.';
        errorEl.classList.remove('hidden');
      }
      if (textarea) {
        textarea.classList.remove('border-brand-gray-200', 'focus:border-brand-black');
        textarea.classList.add('border-red-500', 'focus:border-red-500');
        textarea.focus();
      }
      return;
    }

    try {
      const res = await fetch(`/account/orders/<%= order.orderId %>/cancel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cancellationReason: reason })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        closeCancelModal();
        if (typeof showFlash === 'function') showFlash('success', data.message);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to cancel order');
      }
    } catch (error) {
      console.error(error);
      if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
    }
  });

  // Single Item Cancel submission
  document.getElementById('cancel-item-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const itemId = document.getElementById('cancelTargetItemId').value;
    const textarea = document.getElementById('itemCancellationReason');
    const errorEl = document.getElementById('itemCancellationReasonError');
    const reason = textarea ? textarea.value.trim() : '';

    if (!itemId) return;
    
    if (!reason) {
      if (errorEl) {
        errorEl.textContent = 'Cancellation reason is required.';
        errorEl.classList.remove('hidden');
      }
      if (textarea) {
        textarea.classList.remove('border-brand-gray-200', 'focus:border-brand-black');
        textarea.classList.add('border-red-500', 'focus:border-red-500');
        textarea.focus();
      }
      return;
    }

    try {
      const res = await fetch(`/account/orders/<%= order.orderId %>/items/${itemId}/cancel`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cancellationReason: reason })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        closeItemCancelModal();
        if (typeof showFlash === 'function') showFlash('success', data.message);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to cancel item');
      }
    } catch (error) {
      console.error(error);
      if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
    }
  });

  // Return order submission
  document.getElementById('return-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = document.getElementById('returnReason');
    const errorEl = document.getElementById('returnReasonError');
    const reason = textarea ? textarea.value.trim() : '';
    
    if (!reason) {
      if (errorEl) {
        errorEl.textContent = 'Return reason is mandatory.';
        errorEl.classList.remove('hidden');
      }
      if (textarea) {
        textarea.classList.remove('border-brand-gray-200', 'focus:border-brand-black');
        textarea.classList.add('border-red-500', 'focus:border-red-500');
        textarea.focus();
      }
      return;
    }
    
    try {
      const res = await fetch(`/account/orders/<%= order.orderId %>/return`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ returnReason: reason })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        closeReturnModal();
        if (typeof showFlash === 'function') showFlash('success', data.message);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to submit return request');
      }
    } catch (error) {
      console.error(error);
      if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
    }
  });
</script>

