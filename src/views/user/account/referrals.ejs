<%- include('../partials/navbar') %>

<main class="min-h-screen bg-brand-gray-50 pb-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-sans text-brand-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-black transition-colors">Home</a>
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      <a href="/account/profile" class="hover:text-brand-black transition-colors">My Account</a>
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      <span class="text-brand-black font-medium">Refer &amp; Earn</span>
    </nav>

    <!-- Page header -->
    <p class="font-sans text-xs uppercase tracking-widest text-brand-gray-400 mb-1">Account Dashboard</p>
    <h1 class="font-serif text-3xl sm:text-4xl font-bold text-brand-black mb-1">My Account</h1>
    <p class="font-sans text-sm text-brand-gray-400 mb-8 max-w-2xl font-normal">Manage your profile, addresses, orders, wallet, and security settings in one elegant space.</p>

    <!-- Two-column layout -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">

      <!-- Sidebar -->
      <%- include('../partials/account-sidebar') %>

      <!-- Main content -->
      <div class="flex-1 flex flex-col gap-8">

        <!-- Referral Code & Link Card -->
        <div class="bg-white border border-brand-gray-200 shadow-sm p-6 sm:p-8 flex flex-col gap-6">
          
          <div class="border-b border-brand-gray-100 pb-4">
            <h2 class="font-serif text-xl font-bold text-brand-black">Your Referral Link &amp; Code</h2>
            <p class="font-sans text-xs text-brand-gray-500 mt-0.5">Share your unique link or code with friends to start earning rewards.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Referral Code -->
            <div class="bg-brand-gray-50/70 border border-brand-gray-200 p-5 rounded-sm flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-brand-gray-400 block mb-1">Your Referral Code</span>
                <span id="referral-code-display" class="font-mono text-2xl font-bold text-brand-black tracking-wider block"><%= typeof referralCode !== 'undefined' ? referralCode : '' %></span>
              </div>
              <div class="mt-4 pt-3 border-t border-brand-gray-200 flex justify-between items-center">
                <span class="text-[11px] text-brand-gray-500 font-sans">Share this code at signup</span>
                <button
                  type="button"
                  onclick="copyToClipboard('<%= typeof referralCode !== 'undefined' ? referralCode : '' %>', 'code-btn-text')"
                  class="bg-brand-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 hover:bg-brand-gray-800 transition-colors flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v2.25A2.25 2.25 0 0113.5 21.75h-9a2.25 2.25 0 01-2.25-2.25v-9A2.25 2.25 0 014.5 8.25h2.25m6.75 0V5.25A2.25 2.25 0 0011.25 3h-9A2.25 2.25 0 000 5.25v9A2.25 2.25 0 002.25 16.5h2.25" />
                  </svg>
                  <span id="code-btn-text">Copy Code</span>
                </button>
              </div>
            </div>

            <!-- Referral Link -->
            <div class="bg-brand-gray-50/70 border border-brand-gray-200 p-5 rounded-sm flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-brand-gray-400 block mb-1">Your Referral Link</span>
                <input
                  type="text"
                  readonly
                  id="referral-link-input"
                  value="<%= typeof referralLink !== 'undefined' ? referralLink : '' %>"
                  class="w-full bg-white border border-brand-gray-200 text-xs font-mono text-brand-black px-3 py-2 rounded-none focus:outline-none truncate"
                />
              </div>
              <div class="mt-4 pt-3 border-t border-brand-gray-200 flex justify-between items-center">
                <span class="text-[11px] text-brand-gray-500 font-sans">Direct link with auto code</span>
                <button
                  type="button"
                  onclick="copyToClipboard('<%= typeof referralLink !== 'undefined' ? referralLink : '' %>', 'link-btn-text')"
                  class="bg-brand-black text-white text-[10px] font-bold uppercase tracking-wider px-3.5 py-1.5 hover:bg-brand-gray-800 transition-colors flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                  </svg>
                  <span id="link-btn-text">Copy Link</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Stats summary row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="border border-brand-gray-200 p-4 rounded-sm flex items-center gap-4 bg-white">
              <div class="w-10 h-10 rounded-full bg-brand-gray-100 flex items-center justify-center text-brand-black font-bold">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                </svg>
              </div>
              <div>
                <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-brand-gray-400 block">Total Referrals</span>
                <span class="font-serif text-2xl font-bold text-brand-black"><%= typeof totalReferrals !== 'undefined' ? totalReferrals : 0 %></span>
              </div>
            </div>

            <div class="border border-brand-gray-200 p-4 rounded-sm flex items-center gap-4 bg-white">
              <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-green-700 font-bold">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H15a3 3 0 11-6 0H5.25A2.25 2.25 0 003 12m18 0v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6m18 0V9M3 12V9m18-3a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6m18 0V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6" />
                </svg>
              </div>
              <div>
                <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-brand-gray-400 block">Total Rewards Earned</span>
                <span class="font-serif text-2xl font-bold text-green-700">₹<%= typeof totalEarned !== 'undefined' ? totalEarned.toLocaleString('en-IN') : 0 %></span>
              </div>
            </div>
          </div>

        </div>

        <!-- Referral History Card -->
        <div class="bg-white border border-brand-gray-200 shadow-sm p-6 sm:p-8">
          <div class="border-b border-brand-gray-100 pb-4 mb-6">
            <h2 class="font-serif text-xl font-bold text-brand-black">Referral History</h2>
            <p class="font-sans text-xs text-brand-gray-500 mt-0.5">Track your invited friends, sign-up dates, referral status, and earned wallet rewards.</p>
          </div>

          <!-- Desktop History Table -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-brand-gray-200 bg-brand-gray-50 text-[10px] font-sans font-bold text-brand-gray-500 uppercase tracking-widest2">
                  <th class="px-4 py-3">Referred User</th>
                  <th class="px-4 py-3">Date</th>
                  <th class="px-4 py-3 text-center">Status</th>
                  <th class="px-4 py-3 text-right">Reward Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-brand-gray-100 font-sans text-xs text-brand-black">
                <% if (typeof history !== 'undefined' && history && history.length > 0) { %>
                  <% history.forEach(ref => { %>
                    <tr class="hover:bg-brand-gray-50/50 transition-colors">
                      <td class="px-4 py-4 font-semibold text-brand-black">
                        <%= ref.referredUser ? ref.referredUser.fullName : 'Registered User' %>
                        <% if (ref.referredUser && ref.referredUser.email) { %>
                          <span class="text-[11px] text-brand-gray-500 font-normal block"><%= ref.referredUser.email %></span>
                        <% } %>
                      </td>
                      <td class="px-4 py-4 text-brand-gray-500 font-medium">
                        <%= new Date(ref.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </td>
                      <td class="px-4 py-4 text-center">
                        <span class="px-2.5 py-1 inline-flex text-[10px] leading-4 font-bold uppercase tracking-wider rounded-md 
                          <%= ref.status === 'Completed' ? 'bg-green-100 text-green-700 border border-green-200' : 'bg-amber-100 text-amber-700 border border-amber-200' %>">
                          <%= ref.status %>
                        </span>
                      </td>
                      <td class="px-4 py-4 text-right font-bold text-sm text-green-600">
                        +₹<%= ref.rewardAmount.toLocaleString('en-IN') %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="px-4 py-12 text-center text-brand-gray-400 text-xs">
                      No referrals yet. Share your referral link to earn wallet rewards!
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Mobile History Card List -->
          <div class="block md:hidden divide-y divide-brand-gray-100">
            <% if (typeof history !== 'undefined' && history && history.length > 0) { %>
              <% history.forEach(ref => { %>
                <div class="py-4 flex flex-col gap-2 font-sans text-xs">
                  <div class="flex justify-between items-start">
                    <div>
                      <span class="font-bold text-brand-black text-sm block">
                        <%= ref.referredUser ? ref.referredUser.fullName : 'Registered User' %>
                      </span>
                      <span class="text-[10px] text-brand-gray-400 block mt-0.5">
                        <%= new Date(ref.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                      </span>
                    </div>
                    <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider rounded-md 
                      <%= ref.status === 'Completed' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                      <%= ref.status %>
                    </span>
                  </div>

                  <div class="flex justify-between items-center pt-2 border-t border-brand-gray-50 mt-1">
                    <span class="text-brand-gray-500 text-[11px]">Reward</span>
                    <span class="font-bold text-sm text-green-600">
                      +₹<%= ref.rewardAmount.toLocaleString('en-IN') %>
                    </span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="py-10 text-center text-brand-gray-400 text-xs">
                No referrals yet. Share your referral link to earn wallet rewards!
              </div>
            <% } %>
          </div>

        </div>

      </div>
    </div>

  </div>
</main>

<script>
  function copyToClipboard(text, elementId) {
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const btnText = document.getElementById(elementId);
      if (btnText) {
        const original = btnText.textContent;
        btnText.textContent = 'Copied!';
        setTimeout(() => {
          btnText.textContent = original;
        }, 2000);
      }
    }).catch(err => {
      console.error('Failed to copy:', err);
    });
  }
</script>

<%- include('../partials/footer') %>
