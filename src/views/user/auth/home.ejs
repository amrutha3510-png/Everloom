<%- include('../partials/navbar') %>

<section class="relative w-full h-[65vh] sm:h-[80vh] bg-brand-gray-50 overflow-hidden flex items-center">
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070" 
      alt="New Season Minimalist Wardrobe" 
      class="w-full h-full object-cover object-center brightness-[0.93]"
    />
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-xl md:max-w-2xl">
      <span class="text-[10px] font-semibold uppercase tracking-widest2 text-brand-gray-600 block mb-2 sm:mb-4">
        New Season Collection
      </span>
      <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold text-brand-black leading-[1.1] mb-4 sm:mb-6">
        Timeless Fashion<br />For Modern Women
      </h1>
      <p class="font-sans text-xs sm:text-sm text-brand-gray-600 leading-relaxed mb-6 sm:mb-8 max-w-md">
        Discover elevated essentials, curated luxury, and effortless elegance designed for the contemporary wardrobe.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/shop" class="bg-brand-black text-white text-[10px] font-bold uppercase tracking-widest2 px-6 py-3.5 hover:bg-brand-gray-600 transition-colors">
          Shop Collection
        </a>
        <a href="/lookbook" class="bg-white border border-brand-gray-200 text-brand-black text-[10px] font-bold uppercase tracking-widest2 px-6 py-3.5 hover:bg-brand-gray-50 transition-colors">
          Explore Lookbook
        </a>
      </div>
    </div>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
  <h2 class="font-serif text-2xl sm:text-3xl font-bold text-center text-brand-black mb-10 sm:mb-14">
    Shop By Category
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <a href="/shop?category=<%= category._id %>" class="group relative h-[450px] overflow-hidden bg-brand-gray-50">
          <img src="<%= category.image || 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1020' %>" alt="<%= category.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-black/10 flex items-center justify-center">
            <span class="font-serif text-white text-lg font-bold uppercase tracking-widest px-4 py-2 border-b-2 border-transparent group-hover:border-white transition-all"><%= category.name %></span>
          </div>
        </a>
      <% }); %>
    <% } else { %>
      <a href="/shop" class="group relative h-[450px] overflow-hidden bg-brand-gray-50 md:col-span-3">
        <div class="absolute inset-0 bg-black/10 flex items-center justify-center">
          <span class="font-serif text-white text-lg font-bold uppercase tracking-widest px-4 py-2 border-b-2 border-transparent group-hover:border-white transition-all">Shop All</span>
        </div>
      </a>
    <% } %>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 sm:pb-28">
  <div class="flex justify-between items-end mb-8 border-b border-brand-gray-100 pb-4">
    <div>
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-black mb-1">Latest Collection</h2>
      <p class="font-sans text-xs text-brand-gray-400">Curated pieces designed for elegance and modern luxury.</p>
    </div>
    <a href="/shop" class="font-sans text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-brand-black border-b border-brand-black hover:text-brand-gray-600 hover:border-brand-gray-600 transition-all pb-0.5">
      View All Products
    </a>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12">
    <% if (latestProducts && latestProducts.length > 0) { %>
      <% latestProducts.forEach(product => { %>
        <div class="group flex flex-col relative">
          <div class="relative bg-brand-gray-50 h-[280px] sm:h-[380px] overflow-hidden mb-3">
            <% if (Date.now() - new Date(product.createdAt).getTime() < 7 * 24 * 60 * 60 * 1000) { %>
              <span class="absolute top-3 left-3 bg-brand-black text-white font-sans font-bold text-[9px] uppercase px-2 py-0.5 tracking-wider z-10">New</span>
            <% } %>
            <a href="/shop/product/<%= product._id %>" class="w-full h-full block">
              <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" />
            </a>
            <% 
              const defaultSize = (product.variants && product.variants[0]) ? product.variants[0].size : 'M';
              const defaultColor = (product.variants && product.variants[0]) ? product.variants[0].color : 'Black';
              const inWishlist = typeof userWishlistItems !== 'undefined' && userWishlistItems.some(item => item.product.toString() === product._id.toString());
            %>
            <button type="button" onclick="toggleWishlist('<%= product._id %>', '<%= defaultSize %>', '<%= defaultColor %>', this)" 
                    class="absolute top-3 right-3 bg-white p-2 rounded-full shadow-sm text-brand-gray-400 hover:text-red-500 transition-all z-10" 
                    aria-label="Wishlist">
              <svg class="w-4 h-4 <%= inWishlist ? 'text-red-500 fill-current' : 'text-brand-gray-400' %>" fill="<%= inWishlist ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </button>
          </div>
          <span class="text-[9px] uppercase tracking-widest text-brand-gray-400 font-semibold mb-1"><%= product.category?.name || '' %></span>
          <h3 class="font-sans text-xs sm:text-sm text-brand-black font-medium mb-1 truncate">
            <a href="/shop/product/<%= product._id %>" class="hover:text-brand-gray-600 transition-colors"><%= product.name %></a>
          </h3>
          <p class="font-sans text-xs font-semibold text-brand-gray-600">
            <% 
              let pMin = Infinity; let pMax = 0;
              if (product.variants && product.variants.length > 0) {
                product.variants.forEach(v => {
                  if(v.price < pMin) pMin = v.price;
                  if(v.price > pMax) pMax = v.price;
                });
              }
            %>
            <% if (pMin === pMax && pMin !== Infinity) { %>
              ₹<%= pMin %>
            <% } else if (pMin !== Infinity) { %>
              ₹<%= pMin %> - ₹<%= pMax %>
            <% } else { %>
              Unavailable
            <% } %>
          </p>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-span-full py-10 text-center font-sans text-brand-gray-500 text-sm">
        Stay tuned for our latest arrivals!
      </div>
    <% } %>
  </div>
</section>

<script>
  async function toggleWishlist(productId, size, color, btnElement) {
    try {
      const res = await fetch('/wishlist/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId, size, color })
      });
      
      if (res.status === 401) {
        window.location.href = '/login';
        return;
      }
      
      const data = await res.json();
      if (res.ok && data.success) {
        const svg = btnElement.querySelector('svg');
        if (data.action === 'added') {
          svg.classList.remove('text-brand-gray-400');
          svg.classList.add('text-red-500', 'fill-current');
          svg.setAttribute('fill', 'currentColor');
          if (typeof showFlash === 'function') showFlash('success', 'Added to wishlist');
        } else {
          svg.classList.remove('text-red-500', 'fill-current');
          svg.classList.add('text-brand-gray-400');
          svg.setAttribute('fill', 'none');
          if (typeof showFlash === 'function') showFlash('success', 'Removed from wishlist');
        }
      } else {
        if (typeof showFlash === 'function') showFlash('error', data.message || 'Failed to update wishlist');
      }
    } catch (error) {
      console.error(error);
      if (typeof showFlash === 'function') showFlash('error', 'Network error occurred');
    }
  }
</script>

<%- include('../partials/footer') %>