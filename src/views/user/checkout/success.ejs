<%- include('../partials/navbar') %>

<main class="min-h-screen bg-brand-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full bg-white border border-brand-gray-200 p-8 text-center shadow-sm">
    
    <!-- Success Illustration (Timeless Checkmark) -->
    <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-50 border border-green-100 mb-6">
      <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <!-- Thank You message -->
    <h2 class="font-serif text-3xl font-bold text-brand-black mb-3">Thank you for your order!</h2>
    <p class="font-sans text-brand-gray-500 text-sm mb-6 leading-relaxed">
      Your order has been placed successfully and is being processed. We have sent a confirmation email with all details.
    </p>

    <!-- Order ID card -->
    <div class="bg-brand-gray-50 border border-brand-gray-150 py-4 px-6 mb-8 rounded">
      <span class="block font-sans text-[10px] text-brand-gray-400 uppercase tracking-widest2">Order Reference</span>
      <span class="block font-sans font-bold text-brand-black text-lg mt-1 select-all" id="order-id">#<%= orderId %></span>
    </div>

    <!-- Actions -->
    <div class="flex flex-col gap-3">
      <a href="/account/orders/<%= orderId %>" class="w-full py-3 bg-brand-black text-white font-sans text-xs font-bold uppercase tracking-wider hover:bg-brand-gray-600 transition-colors flex items-center justify-center gap-1.5">
        View Order Details
      </a>
      <a href="/shop" class="w-full py-3 bg-white border border-brand-gray-200 text-brand-black font-sans text-xs font-bold uppercase tracking-wider hover:bg-brand-gray-50 transition-colors flex items-center justify-center">
        Continue Shopping
      </a>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
