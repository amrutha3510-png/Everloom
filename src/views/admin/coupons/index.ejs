<!-- Title & Create Coupon Button -->
<div class="max-w-6xl mx-auto mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      <svg class="w-6 h-6 text-brand-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
      </svg>
      Coupon Management
    </h1>
    <p class="font-sans text-xs text-brand-gray-500 mt-1">Create and manage promotional discount coupons for checkout.</p>
  </div>

  <button type="button" onclick="openCreateCouponModal()" class="px-4 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 rounded-md font-sans text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-2 shadow-sm">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    Create New Coupon
  </button>
</div>

<!-- Coupons Table Card -->
<div class="max-w-6xl mx-auto bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100 flex items-center justify-between">
    <h2 class="font-serif text-xl font-bold text-brand-black">All Coupons</h2>
    <span class="font-sans text-xs text-brand-gray-500 font-medium">Total: <%= coupons.length %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse font-sans text-sm">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50 text-[10px] font-bold text-brand-gray-500 uppercase tracking-widest2">
          <th class="px-6 py-4">Coupon Code</th>
          <th class="px-6 py-4">Discount</th>
          <th class="px-6 py-4">Min Purchase</th>
          <th class="px-6 py-4">Max Cap</th>
          <th class="px-6 py-4">Expiry Date</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-100 text-brand-black">
        <% if (coupons && coupons.length > 0) { %>
          <% coupons.forEach(coupon => { %>
            <tr class="hover:bg-brand-gray-50/50 transition-colors">
              <td class="px-6 py-4 font-mono font-bold text-brand-black uppercase">
                <%= coupon.code %>
              </td>
              <td class="px-6 py-4 font-bold text-brand-black">
                <%= coupon.type === 'PERCENTAGE' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %>
              </td>
              <td class="px-6 py-4 text-brand-gray-600 font-medium">
                ₹<%= coupon.minPurchase || 0 %>
              </td>
              <td class="px-6 py-4 text-brand-gray-500">
                <%= coupon.maxDiscount ? '₹' + coupon.maxDiscount : 'No Limit' %>
              </td>
              <td class="px-6 py-4 text-xs text-brand-gray-500">
                <%= new Date(coupon.expiryDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-md <%= coupon.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                  <%= coupon.status %>
                </span>
              </td>
              <td class="px-6 py-4 text-right whitespace-nowrap space-x-2">
                <button type="button" onclick="toggleCouponStatus('<%= coupon._id %>')" class="px-3 py-1.5 border border-brand-gray-200 text-brand-black text-xs font-semibold rounded hover:bg-brand-gray-50 transition-colors">
                  <%= coupon.status === 'Active' ? 'Deactivate' : 'Activate' %>
                </button>
                <button type="button" onclick="deleteCoupon('<%= coupon._id %>')" class="px-3 py-1.5 bg-red-600 text-white text-xs font-semibold rounded hover:bg-red-700 transition-colors">
                  Delete
                </button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No coupons available. Click "Create New Coupon" to create one.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create Coupon Modal -->
<div id="coupon-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeCreateCouponModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Create New Coupon</h3>
        <button type="button" onclick="closeCreateCouponModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="coupon-form" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Coupon Code <span class="text-red-500">*</span></label>
            <input type="text" id="coupon-code" required uppercase placeholder="e.g. FESTIVE20" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black uppercase font-mono">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Discount Type</label>
            <select id="coupon-type" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
              <option value="PERCENTAGE">Percentage (%)</option>
              <option value="FIXED">Fixed Amount (₹)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Discount Value <span class="text-red-500">*</span></label>
            <input type="number" id="coupon-discountValue" min="1" required placeholder="e.g. 20" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Min Purchase (₹)</label>
            <input type="number" id="coupon-minPurchase" min="0" placeholder="e.g. 1000" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Max Discount Cap (₹)</label>
            <input type="number" id="coupon-maxDiscount" min="0" placeholder="e.g. 500 (Optional)" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Expiry Date <span class="text-red-500">*</span></label>
            <input type="date" id="coupon-expiryDate" required class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Description</label>
          <input type="text" id="coupon-description" placeholder="e.g. Flat 20% OFF on all items" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeCreateCouponModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Cancel</button>
          <button type="submit" class="flex-1 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Save Coupon</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openCreateCouponModal() {
    document.getElementById('coupon-form').reset();
    document.getElementById('coupon-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeCreateCouponModal() {
    document.getElementById('coupon-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.getElementById('coupon-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const code = document.getElementById('coupon-code').value.trim().toUpperCase();
    const type = document.getElementById('coupon-type').value;
    const discountValue = Number(document.getElementById('coupon-discountValue').value);
    const minPurchase = Number(document.getElementById('coupon-minPurchase').value || 0);
    const maxDiscount = document.getElementById('coupon-maxDiscount').value ? Number(document.getElementById('coupon-maxDiscount').value) : null;
    const expiryDate = document.getElementById('coupon-expiryDate').value;
    const description = document.getElementById('coupon-description').value.trim();

    if (!code) {
      alert('Coupon code is required');
      return;
    }

    if (isNaN(discountValue) || discountValue <= 0) {
      alert('Discount value must be greater than 0');
      return;
    }

    if (type === 'PERCENTAGE' && discountValue > 90) {
      alert('Percentage discount cannot exceed 90%');
      return;
    }

    if (!expiryDate) {
      alert('Expiry date is required');
      return;
    }

    try {
      const res = await fetch('/admin/coupons/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code,
          type,
          discountValue,
          minPurchase,
          maxDiscount,
          expiryDate,
          description
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to create coupon');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred while creating coupon');
    }
  });

  async function toggleCouponStatus(couponId) {
    try {
      const res = await fetch(`/admin/coupons/${couponId}/toggle-status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to update status');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred');
    }
  }

  async function deleteCoupon(couponId) {
    if (!confirm('Are you sure you want to delete this coupon?')) return;

    try {
      const res = await fetch(`/admin/coupons/${couponId}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to delete coupon');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred');
    }
  }
</script>
