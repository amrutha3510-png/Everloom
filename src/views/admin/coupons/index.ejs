<!-- Title & Create Coupon Button -->
<div class="max-w-6xl mx-auto mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      <svg class="w-6 h-6 text-brand-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
      </svg>
      Coupon Management
    </h1>
    <p class="font-sans text-xs text-brand-gray-500 mt-1">Create and manage promotional discount coupons for checkout.</p>
  </div>

  <button type="button" onclick="openCreateCouponModal()" class="px-4 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 rounded-md font-sans text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-2 shadow-sm">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    Create New Coupon
  </button>
</div>

<!-- Coupons Table Card -->
<div class="max-w-6xl mx-auto bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100 flex items-center justify-between">
    <h2 class="font-serif text-xl font-bold text-brand-black">All Coupons</h2>
    <span class="font-sans text-xs text-brand-gray-500 font-medium">Total: <%= coupons.length %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse font-sans text-sm">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50 text-[10px] font-bold text-brand-gray-500 uppercase tracking-widest2">
          <th class="px-6 py-4">Coupon Code</th>
          <th class="px-6 py-4">Discount</th>
          <th class="px-6 py-4">Min Purchase</th>
          <th class="px-6 py-4">Max Cap</th>
          <th class="px-6 py-4">User Limit</th>
          <th class="px-6 py-4">Expiry Date</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-100 text-brand-black">
        <% if (coupons && coupons.length > 0) { %>
          <% coupons.forEach(coupon => { %>
            <tr class="hover:bg-brand-gray-50/50 transition-colors">
              <td class="px-6 py-4 font-mono font-bold text-brand-black uppercase">
                <%= coupon.code %>
              </td>
              <td class="px-6 py-4 font-bold text-brand-black">
                <%= coupon.type === 'PERCENTAGE' ? coupon.discountValue + '%' : '₹' + coupon.discountValue %>
              </td>
              <td class="px-6 py-4 text-brand-gray-600 font-medium">
                ₹<%= coupon.minPurchase || 0 %>
              </td>
              <td class="px-6 py-4 text-brand-gray-500">
                <%= coupon.maxDiscount ? '₹' + coupon.maxDiscount : 'No Limit' %>
              </td>
              <td class="px-6 py-4 text-brand-gray-600 font-medium">
                <%= coupon.userUsageLimit || 1 %> time(s)
              </td>
              <td class="px-6 py-4 text-xs text-brand-gray-500">
                <%= new Date(coupon.expiryDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-md <%= coupon.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                  <%= coupon.status %>
                </span>
              </td>
              <td class="px-6 py-4 text-right whitespace-nowrap space-x-2">
                <button type="button"
                  data-id="<%= coupon._id %>"
                  data-code="<%= coupon.code %>"
                  data-type="<%= coupon.type %>"
                  data-discount-value="<%= coupon.discountValue %>"
                  data-min-purchase="<%= coupon.minPurchase || 0 %>"
                  data-max-discount="<%= coupon.maxDiscount || '' %>"
                  data-user-usage-limit="<%= coupon.userUsageLimit || 1 %>"
                  data-expiry-date="<%= new Date(coupon.expiryDate).toISOString().split('T')[0] %>"
                  data-description="<%= coupon.description || '' %>"
                  onclick="openEditCouponModal(this)"
                  class="px-3 py-1.5 bg-brand-black text-white text-xs font-semibold rounded hover:bg-brand-gray-600 transition-colors">
                  Edit
                </button>
                <button type="button" onclick="toggleCouponStatus('<%= coupon._id %>')" class="px-3 py-1.5 border border-brand-gray-200 text-brand-black text-xs font-semibold rounded hover:bg-brand-gray-50 transition-colors">
                  <%= coupon.status === 'Active' ? 'Deactivate' : 'Activate' %>
                </button>
                <button type="button" onclick="deleteCoupon('<%= coupon._id %>')" class="px-3 py-1.5 bg-red-600 text-white text-xs font-semibold rounded hover:bg-red-700 transition-colors">
                  Delete
                </button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No coupons available. Click "Create New Coupon" to create one.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create / Edit Coupon Modal -->
<div id="coupon-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeCreateCouponModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black" id="coupon-modal-heading">Create New Coupon</h3>
        <button type="button" onclick="closeCreateCouponModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="coupon-form" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <input type="hidden" id="editing-coupon-id" value="">

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Coupon Code <span class="text-red-500">*</span></label>
            <input type="text" id="coupon-code" required uppercase placeholder="e.g. FESTIVE20" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black uppercase font-mono">
            <p class="hidden text-red-500 text-xs mt-1 font-sans" id="coupon-code-err"></p>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Discount Type</label>
            <select id="coupon-type" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black" onchange="updateDiscountValueUI()">
              <option value="PERCENTAGE">Percentage (%)</option>
              <option value="FIXED">Fixed Amount (₹)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label id="coupon-discountValue-label" class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Discount Value (%) <span class="text-red-500">*</span></label>
            <input type="number" id="coupon-discountValue" min="1" max="75" step="1" required placeholder="e.g. 20 (1-75%)" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
            <p class="hidden text-red-500 text-xs mt-1 font-sans" id="coupon-discountValue-err"></p>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Min Purchase (₹)</label>
            <input type="number" id="coupon-minPurchase" min="0" placeholder="e.g. 1000" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div id="coupon-maxDiscount-container">
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Max Discount Cap (₹)</label>
            <input type="number" id="coupon-maxDiscount" min="0" placeholder="e.g. 500 (Optional)" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
          <div>
            <% const tomorrowStr = new Date(Date.now() + 86400000).toISOString().split('T')[0]; %>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Expiry Date <span class="text-red-500">*</span></label>
            <input type="date" id="coupon-expiryDate" min="<%= tomorrowStr %>" required class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
            <p class="hidden text-red-500 text-xs mt-1 font-sans" id="coupon-expiryDate-err"></p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Per-User Usage Limit <span class="text-red-500">*</span></label>
            <input type="number" id="coupon-userUsageLimit" min="1" step="1" value="1" required placeholder="e.g. 1" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Description</label>
            <input type="text" id="coupon-description" placeholder="e.g. Flat 20% OFF on all items" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          </div>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeCreateCouponModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Cancel</button>
          <button type="submit" id="coupon-submit-btn" class="flex-1 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Save Coupon</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function updateDiscountValueUI() {
    const typeSelect = document.getElementById('coupon-type');
    const discountInput = document.getElementById('coupon-discountValue');
    const labelEl = document.getElementById('coupon-discountValue-label');
    const maxDiscountInput = document.getElementById('coupon-maxDiscount');
    const type = typeSelect ? typeSelect.value : 'PERCENTAGE';

    if (type === 'PERCENTAGE') {
      if (labelEl) labelEl.innerHTML = 'Discount Value (%) <span class="text-red-500">*</span>';
      if (discountInput) {
        discountInput.setAttribute('min', '1');
        discountInput.setAttribute('max', '75');
        discountInput.setAttribute('step', '1');
        discountInput.placeholder = 'e.g. 20 (1-75%)';
      }
      if (maxDiscountInput) {
        maxDiscountInput.disabled = false;
        maxDiscountInput.placeholder = 'e.g. 500 (Optional)';
      }
    } else {
      if (labelEl) labelEl.innerHTML = 'Discount Value (₹) <span class="text-red-500">*</span>';
      if (discountInput) {
        discountInput.setAttribute('min', '1');
        discountInput.removeAttribute('max');
        discountInput.setAttribute('step', 'any');
        discountInput.placeholder = 'e.g. 500 (Min ₹1)';
      }
      if (maxDiscountInput) {
        maxDiscountInput.value = '';
        maxDiscountInput.disabled = true;
        maxDiscountInput.placeholder = 'Not applicable for fixed amount';
      }
    }
  }

  function resetCouponErrors() {
    ['coupon-code-err', 'coupon-discountValue-err', 'coupon-expiryDate-err'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    });
    ['coupon-code', 'coupon-discountValue', 'coupon-expiryDate'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.remove('border-red-500');
    });
  }

  function openCreateCouponModal() {
    document.getElementById('coupon-form').reset();
    document.getElementById('editing-coupon-id').value = '';
    document.getElementById('coupon-modal-heading').textContent = 'Create New Coupon';
    document.getElementById('coupon-submit-btn').textContent = 'Save Coupon';
    document.getElementById('coupon-userUsageLimit').value = 1;
    resetCouponErrors();
    updateDiscountValueUI();
    document.getElementById('coupon-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function openEditCouponModal(btn) {
    if (!btn) return;
    document.getElementById('coupon-form').reset();
    resetCouponErrors();

    const id = btn.getAttribute('data-id');
    const code = btn.getAttribute('data-code');
    const type = btn.getAttribute('data-type');
    const discountValue = btn.getAttribute('data-discount-value');
    const minPurchase = btn.getAttribute('data-min-purchase');
    const maxDiscount = btn.getAttribute('data-max-discount');
    const userUsageLimit = btn.getAttribute('data-user-usage-limit');
    const expiryDate = btn.getAttribute('data-expiry-date');
    const description = btn.getAttribute('data-description');

    document.getElementById('editing-coupon-id').value = id || '';
    document.getElementById('coupon-modal-heading').textContent = 'Edit Coupon';
    document.getElementById('coupon-submit-btn').textContent = 'Update Coupon';

    document.getElementById('coupon-code').value = code || '';
    document.getElementById('coupon-type').value = type || 'PERCENTAGE';
    document.getElementById('coupon-discountValue').value = discountValue || '';
    document.getElementById('coupon-minPurchase').value = minPurchase || 0;
    document.getElementById('coupon-maxDiscount').value = maxDiscount || '';
    document.getElementById('coupon-userUsageLimit').value = userUsageLimit || 1;
    document.getElementById('coupon-expiryDate').value = expiryDate || '';
    document.getElementById('coupon-description').value = description || '';

    updateDiscountValueUI();
    document.getElementById('coupon-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeCreateCouponModal() {
    document.getElementById('coupon-modal').classList.add('hidden');
    document.body.style.overflow = '';
    resetCouponErrors();
  }

  document.getElementById('coupon-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    resetCouponErrors();

    const editingId = document.getElementById('editing-coupon-id').value;
    const codeInput = document.getElementById('coupon-code');
    const code = codeInput.value.trim().toUpperCase();
    const type = document.getElementById('coupon-type').value;
    const discountInput = document.getElementById('coupon-discountValue');
    const discountValueRaw = discountInput.value;
    const discountValue = Number(discountValueRaw);
    const minPurchase = Number(document.getElementById('coupon-minPurchase').value || 0);
    const maxDiscount = (type === 'PERCENTAGE' && document.getElementById('coupon-maxDiscount').value) ? Number(document.getElementById('coupon-maxDiscount').value) : null;
    const userUsageLimit = Number(document.getElementById('coupon-userUsageLimit').value || 1);
    const expiryInput = document.getElementById('coupon-expiryDate');
    const expiryDate = expiryInput.value;
    const description = document.getElementById('coupon-description').value.trim();

    let valid = true;

    if (!code) {
      const err = document.getElementById('coupon-code-err');
      err.textContent = 'Coupon Code is required and cannot be whitespace only.';
      err.classList.remove('hidden');
      codeInput.classList.add('border-red-500');
      valid = false;
    }

    if (type === 'PERCENTAGE') {
      if (!discountValueRaw || isNaN(discountValue) || !Number.isInteger(discountValue) || discountValue < 1 || discountValue > 75) {
        const err = document.getElementById('coupon-discountValue-err');
        err.textContent = 'Percentage discount must be a whole number between 1% and 75%.';
        err.classList.remove('hidden');
        discountInput.classList.add('border-red-500');
        valid = false;
      }
    } else if (type === 'FIXED') {
      if (!discountValueRaw || isNaN(discountValue) || discountValue < 1) {
        const err = document.getElementById('coupon-discountValue-err');
        err.textContent = 'Fixed price discount must be at least ₹1.';
        err.classList.remove('hidden');
        discountInput.classList.add('border-red-500');
        valid = false;
      }
    }

    if (!expiryDate) {
      const err = document.getElementById('coupon-expiryDate-err');
      err.textContent = 'Expiry Date is required.';
      err.classList.remove('hidden');
      expiryInput.classList.add('border-red-500');
      valid = false;
    } else {
      const expD = new Date(expiryDate);
      const todayEnd = new Date();
      todayEnd.setHours(23, 59, 59, 999);
      if (expD <= todayEnd) {
        const err = document.getElementById('coupon-expiryDate-err');
        err.textContent = 'Expiry Date must be a future date.';
        err.classList.remove('hidden');
        expiryInput.classList.add('border-red-500');
        valid = false;
      }
    }

    if (!valid) return;

    const submitBtn = document.getElementById('coupon-submit-btn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';

    const url = editingId ? `/admin/coupons/${editingId}/edit` : '/admin/coupons/create';

    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code,
          type,
          discountValue,
          minPurchase,
          maxDiscount,
          userUsageLimit,
          expiryDate,
          description
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        const err = document.getElementById('coupon-discountValue-err');
        err.textContent = data.message || 'Failed to save coupon.';
        err.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = editingId ? 'Update Coupon' : 'Save Coupon';
      }
    } catch (err) {
      console.error(err);
      const errEl = document.getElementById('coupon-discountValue-err');
      errEl.textContent = 'Network error occurred while saving coupon.';
      errEl.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = editingId ? 'Update Coupon' : 'Save Coupon';
    }
  });

  async function toggleCouponStatus(couponId) {
    try {
      const res = await fetch(`/admin/coupons/${couponId}/toggle-status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to update status');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred');
    }
  }

  async function deleteCoupon(couponId) {
    if (!confirm('Are you sure you want to delete this coupon?')) return;

    try {
      const res = await fetch(`/admin/coupons/${couponId}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to delete coupon');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred');
    }
  }
</script>
