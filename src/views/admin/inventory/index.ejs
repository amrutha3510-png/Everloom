<!-- Title & Header Action -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
    </svg>
    Inventory & Stock Management
  </h1>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-4 gap-6 mb-8">
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Total<br>Variants</p>
      <div class="p-2 bg-brand-gray-50 rounded-full">
        <svg class="w-4 h-4 text-brand-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.total %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">In Stock</p>
      <div class="p-2 bg-green-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-green-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.inStock %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Low Stock</p>
      <div class="p-2 bg-yellow-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-yellow-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.lowStock %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Out of Stock</p>
      <div class="p-2 bg-red-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-red-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.outOfStock %></h3>
  </div>
</div>

<!-- Inventory Directory Card -->
<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Inventory Directory</h2>
    
    <form id="filter-form" action="/admin/inventory" method="GET" class="flex flex-col lg:flex-row gap-2 lg:gap-3">
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search by name, size, color, category..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>
      
      <!-- Stock Status Filter -->
      <div class="relative w-full lg:w-44">
        <select id="stock-status-filter" name="stockStatus" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="All" <%= stockStatusFilter === 'All' ? 'selected' : '' %>>All Stock Statuses</option>
          <option value="In Stock" <%= stockStatusFilter === 'In Stock' ? 'selected' : '' %>>In Stock (> 5)</option>
          <option value="Low Stock" <%= stockStatusFilter === 'Low Stock' ? 'selected' : '' %>>Low Stock (1-5)</option>
          <option value="Out of Stock" <%= stockStatusFilter === 'Out of Stock' ? 'selected' : '' %>>Out of Stock (0)</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>

      <!-- Category Filter -->
      <div class="relative w-full lg:w-44">
        <select id="category-filter" name="category" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="All Categories" <%= categoryFilter === 'All Categories' ? 'selected' : '' %>>All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat._id %>" <%= categoryFilter === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
          <% }) %>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>

      <!-- Sorting Filter -->
      <div class="relative w-full lg:w-44">
        <select id="sort-filter" name="sort" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="newest" <%= sortOption === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="stock-low" <%= sortOption === 'stock-low' ? 'selected' : '' %>>Stock: Low to High</option>
          <option value="stock-high" <%= sortOption === 'stock-high' ? 'selected' : '' %>>Stock: High to Low</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <!-- Form Actions -->
      <div class="flex gap-2 w-full lg:w-auto">
        <button type="submit" class="flex-1 lg:flex-initial bg-brand-black text-white px-5 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        <% if (searchQuery || stockStatusFilter !== 'All' || categoryFilter !== 'All Categories' || sortOption !== 'newest') { %>
          <a href="/admin/inventory" class="flex-1 lg:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-5 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center" title="Clear all search and filters">
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Inventory Table -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50/50">
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Product</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Variant Size</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Variant Color</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Current Stock</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Stock Status</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-50">
        <% if (variants && variants.length > 0) { %>
          <% variants.forEach(item => { %>
            <tr class="hover:bg-brand-gray-50 transition-colors">
              <!-- Product Image & Name -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-none overflow-hidden bg-brand-gray-100 border border-brand-gray-200 flex-shrink-0">
                    <% if (item.image) { %>
                      <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center font-serif text-sm font-bold text-brand-gray-400 bg-brand-gray-200">
                        <%= item.name.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                  </div>
                  <span class="font-sans font-medium text-brand-black text-sm max-w-[200px] truncate" title="<%= item.name %>"><%= item.name %></span>
                </div>
              </td>
              <!-- Category -->
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500 max-w-[150px] truncate" title="<%= item.category?.name %>">
                <%= item.category?.name || '—' %>
              </td>
              <!-- Size -->
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500">
                <span class="px-2 py-0.5 bg-brand-gray-50 border border-brand-gray-200 text-xs font-medium"><%= item.variant.size %></span>
              </td>
              <!-- Color -->
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500">
                <span class="px-2 py-0.5 bg-brand-gray-50 border border-brand-gray-200 text-xs font-medium"><%= item.variant.color %></span>
              </td>
              <!-- Current Stock -->
              <td class="px-6 py-4 font-sans text-sm text-brand-black font-semibold">
                <%= item.variant.stock %>
              </td>
              <!-- Stock Status -->
              <td class="px-6 py-4 whitespace-nowrap">
                <% if (item.stockStatus === 'In Stock') { %>
                  <span class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md bg-green-100 text-green-700">
                    In Stock
                  </span>
                <% } else if (item.stockStatus === 'Low Stock') { %>
                  <span class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md bg-yellow-100 text-yellow-700">
                    Low Stock
                  </span>
                <% } else { %>
                  <span class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md bg-red-100 text-red-700">
                    Out of Stock
                  </span>
                <% } %>
              </td>
              <!-- Actions -->
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" 
                          onclick="editStock('<%= item._id %>', '<%= item.variant._id %>', <%= item.variant.stock %>)" 
                          class="p-2 bg-brand-gray-100 text-brand-black border border-brand-gray-200 rounded-md hover:bg-brand-gray-200 transition-colors"
                          title="Quick Update Stock">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No inventory records found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-sm text-brand-gray-500 text-center sm:text-left">
        Showing <%= ((currentPage - 1) * 10) + 1 %> to <%= Math.min(currentPage * 10, totalEntries) %> of <%= totalEntries %> entries
      </p>
      <div class="flex items-center justify-between w-full sm:w-auto gap-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&stockStatus=<%= encodeURIComponent(stockStatusFilter) %>&category=<%= encodeURIComponent(categoryFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Previous
          </a>
        <% } %>
        <div class="hidden sm:flex items-center gap-1">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="w-8 h-8 flex items-center justify-center bg-brand-gray-100 rounded-md font-medium text-brand-black"><%= i %></span>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <a href="?page=<%= i %>&search=<%= encodeURIComponent(searchQuery) %>&stockStatus=<%= encodeURIComponent(stockStatusFilter) %>&category=<%= encodeURIComponent(categoryFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="w-8 h-8 flex items-center justify-center border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors"><%= i %></a>
            <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
              <span class="w-8 h-8 flex items-center justify-center text-brand-gray-400">...</span>
            <% } %>
          <% } %>
        </div>
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&stockStatus=<%= encodeURIComponent(stockStatusFilter) %>&category=<%= encodeURIComponent(categoryFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const clearSearchBtn = document.getElementById('clear-search-btn');
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }

  async function editStock(productId, variantId, currentStock) {
    const { value: newStock } = await Swal.fire({
      title: 'Update Stock',
      input: 'number',
      inputLabel: 'Enter new stock quantity',
      inputValue: currentStock,
      showCancelButton: true,
      confirmButtonColor: '#111111',
      cancelButtonColor: '#636360',
      confirmButtonText: 'Update',
      cancelButtonText: 'Cancel',
      inputValidator: (value) => {
        if (value === null || value === '' || isNaN(value) || parseInt(value, 10) < 0 || !Number.isInteger(parseFloat(value))) {
          return 'Please enter a valid non-negative integer!';
        }
      },
      customClass: { popup: 'rounded-xl font-sans' }
    });

    if (newStock !== undefined && newStock !== null && newStock !== '') {
      try {
        const response = await axios.post('/admin/inventory/update', {
          productId,
          variantId,
          newStock: parseInt(newStock, 10)
        });
        if (response.data.success) {
          Swal.fire({
            title: 'Success!',
            text: response.data.message || 'Stock updated successfully.',
            icon: 'success',
            timer: 1500,
            showConfirmButton: false
          }).then(() => {
            window.location.reload();
          });
        }
      } catch (error) {
        Swal.fire({
          title: 'Error!',
          text: error.response?.data?.message || 'Something went wrong.',
          icon: 'error'
        });
      }
    }
  }
</script>
