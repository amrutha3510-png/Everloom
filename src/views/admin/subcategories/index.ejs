<!-- Title & Header Action -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
    </svg>
    Subcategory Management
  </h1>
  <div class="flex items-center gap-3">
    <a href="/admin/subcategories/deleted" class="inline-flex items-center justify-center gap-2 bg-brand-gray-100 text-brand-black px-5 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors shadow-sm border border-brand-gray-200">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Deleted Subcategories
    </a>
    <a href="/admin/subcategories/add" class="inline-flex items-center justify-center gap-2 bg-brand-black text-white px-5 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors shadow-sm">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
      </svg>
      Add Subcategory
    </a>
  </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Total<br>Subcategories</p>
      <div class="p-2 bg-brand-gray-50 rounded-full">
        <svg class="w-4 h-4 text-brand-gray-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
        </svg>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.total %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Active Subcategories</p>
      <div class="p-2 bg-green-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-green-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.active %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Inactive Subcategories</p>
      <div class="p-2 bg-gray-100 rounded-full">
        <div class="w-2.5 h-2.5 bg-gray-400 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.inactive %></h3>
  </div>
</div>

<!-- Subcategory Directory Card -->
<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Subcategory Directory</h2>
    
    <form id="filter-form" action="/admin/subcategories" method="GET" class="flex flex-col lg:flex-row gap-4">
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search by subcategory or category name..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>
      
      <div class="relative w-full lg:w-44">
        <select id="status-filter" name="status" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="All Status" <%= statusFilter === 'All Status' ? 'selected' : '' %>>All Status</option>
          <option value="Active" <%= statusFilter === 'Active' ? 'selected' : '' %>>Active</option>
          <option value="Inactive" <%= statusFilter === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>

      <div class="relative w-full lg:w-48">
        <select id="category-filter" name="category" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="All Categories" <%= (typeof categoryFilter !== 'undefined' && categoryFilter === 'All Categories') ? 'selected' : '' %>>All Categories</option>
          <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>" <%= (typeof categoryFilter !== 'undefined' && categoryFilter === cat._id.toString()) ? 'selected' : '' %>><%= cat.name %></option>
            <% }) %>
          <% } %>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>

      <div class="relative w-full lg:w-48">
        <select id="sort-filter" name="sort" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="newest" <%= sortOption === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="oldest" <%= sortOption === 'oldest' ? 'selected' : '' %>>Oldest First</option>
          <option value="az" <%= sortOption === 'az' ? 'selected' : '' %>>A-Z</option>
          <option value="za" <%= sortOption === 'za' ? 'selected' : '' %>>Z-A</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <div class="flex gap-2 w-full lg:w-auto">
        <button type="submit" class="flex-1 lg:flex-initial bg-brand-black text-white px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        <% if (searchQuery || statusFilter !== 'All Status' || sortOption !== 'newest' || (typeof categoryFilter !== 'undefined' && categoryFilter !== 'All Categories')) { %>
          <a href="/admin/subcategories" class="flex-1 lg:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center" title="Clear all search and filters">
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50/50">
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Subcategory Name</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Created Date</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-50">
        <% if (subcategories && subcategories.length > 0) { %>
          <% subcategories.forEach(sub => { %>
            <tr class="hover:bg-brand-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-none overflow-hidden bg-brand-gray-100 border border-brand-gray-200 flex-shrink-0">
                    <% if (sub.image) { %>
                      <img src="<%= sub.image %>" alt="<%= sub.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center font-serif text-sm font-bold text-brand-gray-400 bg-brand-gray-200">
                        <%= sub.name.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                  </div>
                  <span class="font-sans font-medium text-brand-black text-sm"><%= sub.name %></span>
                </div>
              </td>
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500">
                <%= sub.category?.name || '—' %>
              </td>
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500 max-w-xs truncate" title="<%= sub.description %>">
                <%= sub.description || '—' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md <%= sub.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
                  <%= sub.status %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap font-sans text-sm text-brand-gray-500">
                <%= new Date(sub.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="/admin/subcategories/edit/<%= sub._id %>" 
                     class="p-2 bg-brand-gray-100 text-brand-black border border-brand-gray-200 rounded-md hover:bg-brand-gray-200 transition-colors"
                     title="Edit Subcategory">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                    </svg>
                  </a>
                  <button class="soft-delete-subcategory-btn p-2 rounded-md border transition-colors bg-red-50 text-red-600 border-red-200 hover:bg-red-100"
                          data-id="<%= sub._id %>"
                          title="Soft Delete Subcategory">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No subcategories found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-sm text-brand-gray-500 text-center sm:text-left">
        Showing <%= ((currentPage - 1) * 10) + 1 %> to <%= Math.min(currentPage * 10, totalEntries) %> of <%= totalEntries %> entries
      </p>
      <div class="flex items-center justify-between w-full sm:w-auto gap-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&category=<%= typeof categoryFilter !== 'undefined' ? encodeURIComponent(categoryFilter) : 'All Categories' %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Previous
          </a>
        <% } %>
        <div class="hidden sm:flex items-center gap-1">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="w-8 h-8 flex items-center justify-center bg-brand-gray-100 rounded-md font-medium text-brand-black"><%= i %></span>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <a href="?page=<%= i %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&category=<%= typeof categoryFilter !== 'undefined' ? encodeURIComponent(categoryFilter) : 'All Categories' %>&sort=<%= encodeURIComponent(sortOption) %>" class="w-8 h-8 flex items-center justify-center border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors"><%= i %></a>
            <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
              <span class="w-8 h-8 flex items-center justify-center text-brand-gray-400">...</span>
            <% } %>
          <% } %>
        </div>
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&category=<%= typeof categoryFilter !== 'undefined' ? encodeURIComponent(categoryFilter) : 'All Categories' %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const clearSearchBtn = document.getElementById('clear-search-btn');
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }

  document.querySelectorAll('.soft-delete-subcategory-btn').forEach(button => {
    button.addEventListener('click', async function() {
      const id = this.getAttribute('data-id');

      const result = await Swal.fire({
        title: 'Delete Subcategory?',
        text: 'Are you sure you want to soft delete this subcategory?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'Cancel',
        customClass: { popup: 'rounded-xl font-sans' }
      });

      if (result.isConfirmed) {
        try {
          const response = await axios.post(`/admin/subcategories/soft-delete/${id}`);
          if (response.data.success) {
            Swal.fire({
              title: 'Success!',
              text: response.data.message || 'Subcategory deleted.',
              icon: 'success',
              timer: 1500,
              showConfirmButton: false
            }).then(() => {
              window.location.reload();
            });
          }
        } catch (error) {
          Swal.fire({
            title: 'Error!',
            text: error.response?.data?.message || 'Something went wrong.',
            icon: 'error'
          });
        }
      }
    });
  });
</script>
