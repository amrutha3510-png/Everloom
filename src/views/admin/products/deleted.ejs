<!-- Title & Header Action -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <a href="/admin/products" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-gray-500 hover:text-brand-black transition-colors mb-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      Back to Products
    </a>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Deleted Products
    </h1>
  </div>
</div>

<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Deleted Products</h2>
    
    <form id="filter-form" action="/admin/products/deleted" method="GET" class="flex flex-col lg:flex-row gap-4">
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search deleted product by name..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>

      <div class="relative w-full lg:w-48">
        <select id="sort-filter" name="sort" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="newest" <%= sortOption === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="oldest" <%= sortOption === 'oldest' ? 'selected' : '' %>>Oldest First</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <div class="flex gap-2 w-full lg:w-auto">
        <button type="submit" class="flex-1 lg:flex-initial bg-brand-black text-white px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        
        <% if (searchQuery || sortOption !== 'newest') { %>
          <a href="/admin/products/deleted" class="flex-1 lg:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center" title="Clear all search and filters">
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50/50">
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Product</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Subcategory</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-50">
        <% if (products && products.length > 0) { %>
          <% products.forEach(product => { %>
            <tr class="hover:bg-brand-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-none overflow-hidden bg-brand-gray-100 border border-brand-gray-200 flex-shrink-0">
                    <% if (product.images && product.images.length > 0) { %>
                      <img src="<%= product.images[0] %>" alt="<%= product.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center font-serif text-sm font-bold text-brand-gray-400 bg-brand-gray-200">
                        <%= product.name.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                  </div>
                  <span class="font-sans font-medium text-brand-black text-sm max-w-[200px] truncate" title="<%= product.name %>"><%= product.name %></span>
                </div>
              </td>
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500 max-w-[150px] truncate" title="<%= product.category?.name %>">
                <%= product.category?.name || '—' %>
              </td>
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500 max-w-[150px] truncate" title="<%= product.subcategory?.name %>">
                <%= product.subcategory?.name || '—' %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md bg-red-100 text-red-700">
                  Deleted
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <button class="restore-product-btn p-2 rounded-md border transition-colors bg-green-50 text-green-600 border-green-200 hover:bg-green-100"
                          data-id="<%= product._id %>"
                          title="Restore Product">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No deleted products found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% if (totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-sm text-brand-gray-500 text-center sm:text-left">
        Showing <%= ((currentPage - 1) * 10) + 1 %> to <%= Math.min(currentPage * 10, totalEntries) %> of <%= totalEntries %> entries
      </p>
      <div class="flex items-center justify-between w-full sm:w-auto gap-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Previous
          </a>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const clearSearchBtn = document.getElementById('clear-search-btn');
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }

  document.querySelectorAll('.restore-product-btn').forEach(button => {
    button.addEventListener('click', async function() {
      const id = this.getAttribute('data-id');

      const result = await Swal.fire({
        title: 'Restore Product?',
        text: 'Are you sure you want to restore this product?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#16a34a',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, restore it!',
        cancelButtonText: 'Cancel',
        customClass: { popup: 'rounded-xl font-sans' }
      });

      if (result.isConfirmed) {
        try {
          const response = await axios.post(`/admin/products/restore/${id}`);
          if (response.data.success) {
            Swal.fire({
              title: 'Success!',
              text: response.data.message || 'Product restored.',
              icon: 'success',
              timer: 1500,
              showConfirmButton: false
            }).then(() => {
              window.location.reload();
            });
          }
        } catch (error) {
          Swal.fire({
            title: 'Error!',
            text: error.response?.data?.message || 'Something went wrong.',
            icon: 'error'
          });
        }
      }
    });
  });
</script>
