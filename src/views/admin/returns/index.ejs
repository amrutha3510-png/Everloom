<!-- Header with Back Link -->
<div class="max-w-6xl mx-auto mb-8 flex items-center justify-between">
  <div>
    <a href="/admin/orders" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-gray-500 hover:text-brand-black transition-colors mb-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back to Orders
    </a>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 15v-1a4 4 0 00-4-4H4m0 0l4-4m-4 4l4 4m6 4v1a3 3 0 003 3h3a3 3 0 003-3v-3a3 3 0 00-3-3h-3" />
      </svg>
      Return Requests Management
    </h1>
  </div>
</div>

<!-- Return Requests Table Card -->
<div class="max-w-6xl mx-auto bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Existing Return Requests</h2>
    
    <form id="filter-form" action="/admin/returns" method="GET" class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search by Order ID, customer name, or email..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>
      
      <!-- Status Filter -->
      <div class="relative w-full md:w-48">
        <select id="status-filter" name="status" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none" onchange="this.form.submit()">
          <option value="All" <%= statusFilter === 'All' ? 'selected' : '' %>>All Statuses</option>
          <option value="Pending" <%= statusFilter === 'Pending' ? 'selected' : '' %>>Pending</option>
          <option value="Approved" <%= statusFilter === 'Approved' ? 'selected' : '' %>>Approved</option>
          <option value="Declined" <%= statusFilter === 'Declined' ? 'selected' : '' %>>Declined</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <div class="flex gap-2 w-full md:w-auto">
        <button type="submit" class="flex-1 md:flex-initial bg-brand-black text-white px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        
        <% if (searchQuery || statusFilter !== 'All') { %>
          <a href="/admin/returns" class="flex-1 md:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center">
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Desktop Table View -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50 text-[10px] font-sans font-bold text-brand-gray-500 uppercase tracking-widest2">
          <th class="px-6 py-4">Order ID</th>
          <th class="px-6 py-4">User Details</th>
          <th class="px-6 py-4">Product Details</th>
          <th class="px-6 py-4">Return Reason</th>
          <th class="px-6 py-4">Request Date</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-100 font-sans text-sm text-brand-black">
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <% 
              const currentReturnStatus = order.returnStatus === 'Declined' ? 'Declined' : 
                                        (order.returnStatus === 'Approved' || order.status === 'Returned' ? 'Approved' : 'Pending');
            %>
            <tr class="hover:bg-brand-gray-50/50 transition-colors">
              <!-- Order ID -->
              <td class="px-6 py-4 font-semibold whitespace-nowrap">
                <a href="/admin/orders/<%= order._id %>" class="text-brand-black underline hover:text-brand-gray-600">
                  #<%= order.orderId || order._id %>
                </a>
              </td>

              <!-- User Details -->
              <td class="px-6 py-4">
                <div class="font-medium text-brand-black"><%= order.user ? order.user.fullName : (order.shippingAddress.fullName || 'Guest') %></div>
                <div class="text-xs text-brand-gray-500"><%= order.user ? order.user.email : 'N/A' %></div>
                <div class="text-xs text-brand-gray-400"><%= order.shippingAddress ? order.shippingAddress.phone : '' %></div>
              </td>

              <!-- Products -->
              <td class="px-6 py-4">
                <div class="space-y-2 max-w-xs">
                  <% order.items.forEach(item => { %>
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-12 bg-brand-gray-50 border border-brand-gray-200 rounded overflow-hidden flex-shrink-0">
                        <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                          <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" class="w-full h-full object-cover">
                        <% } else { %>
                          <div class="w-full h-full flex items-center justify-center text-brand-gray-400 text-[9px]">No img</div>
                        <% } %>
                      </div>
                      <div class="text-xs min-w-0">
                        <p class="font-semibold text-brand-black truncate"><%= item.product ? item.product.name : 'Unknown Product' %></p>
                        <p class="text-[10px] text-brand-gray-500">Size: <%= item.variant.size %> | Color: <%= item.variant.color %> | Qty: <%= item.quantity %></p>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </td>

              <!-- Return Reason -->
              <td class="px-6 py-4 text-xs text-brand-gray-600 max-w-xs">
                <%= order.returnReason || 'No reason provided' %>
              </td>

              <!-- Request Date -->
              <td class="px-6 py-4 text-xs text-brand-gray-600 whitespace-nowrap">
                <%= new Date(order.updatedAt || order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                <span class="block text-[10px] text-brand-gray-400">
                  <%= new Date(order.updatedAt || order.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %>
                </span>
              </td>

              <!-- Status -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-md 
                  <%= currentReturnStatus === 'Approved' ? 'bg-green-100 text-green-700' : 
                      currentReturnStatus === 'Declined' ? 'bg-red-100 text-red-700' : 
                      'bg-yellow-100 text-yellow-700' %>">
                  <%= currentReturnStatus %>
                </span>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 text-right whitespace-nowrap">
                <% if (currentReturnStatus === 'Pending') { %>
                  <div class="flex flex-col gap-1.5 items-end">
                    <form action="/admin/orders/<%= order._id %>/update-status" method="POST" class="inline">
                      <input type="hidden" name="status" value="Returned">
                      <input type="hidden" name="restockOption" value="restock">
                      <button type="submit" class="px-3 py-1 bg-brand-black text-white text-[11px] font-semibold uppercase tracking-wider rounded hover:bg-brand-gray-600 transition-colors">
                        Approve &amp; Restock
                      </button>
                    </form>

                    <form action="/admin/orders/<%= order._id %>/update-status" method="POST" class="inline">
                      <input type="hidden" name="status" value="Returned">
                      <input type="hidden" name="restockOption" value="no_restock">
                      <button type="submit" class="px-3 py-1 bg-white border border-brand-gray-200 text-brand-black text-[11px] font-semibold uppercase tracking-wider rounded hover:bg-brand-gray-50 transition-colors">
                        Approve (No Restock)
                      </button>
                    </form>

                    <button type="button" onclick="openDeclineModal('/admin/returns/<%= order._id %>/decline')" class="px-3 py-1 bg-red-600 text-white text-[11px] font-semibold uppercase tracking-wider rounded hover:bg-red-700 transition-colors">
                      Decline
                    </button>
                  </div>
                <% } else if (currentReturnStatus === 'Declined') { %>
                  <span class="text-xs text-red-600 font-semibold">Return Declined</span>
                <% } else { %>
                  <span class="text-xs text-green-600 font-semibold">Return Approved</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-10 text-center text-brand-gray-400 font-sans text-sm">No return requests found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (orders && orders.length > 0 && totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 bg-brand-gray-50/50">
      <p class="font-sans text-xs text-brand-gray-500">
        Showing Page <span class="font-semibold text-brand-black"><%= currentPage %></span> of <span class="font-semibold text-brand-black"><%= totalPages %></span> pages.
      </p>
      
      <div class="flex items-center justify-between w-full sm:w-auto gap-2 font-sans text-xs">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1">
            Previous
          </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1">
            Next
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<!-- Decline Return Request Modal -->
<div id="decline-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeDeclineModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Decline Return Request</h3>
        <button type="button" onclick="closeDeclineModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="decline-form" action="" method="POST" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-2">Reason for declining <span class="text-red-500">*</span></label>
          <textarea id="declineReasonInput" name="declineReason" rows="3" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black bg-white placeholder-brand-gray-400 transition-colors" placeholder="Please state why the return is being declined..."></textarea>
          <p class="hidden text-red-500 text-xs mt-1.5 font-sans pl-1" id="declineReasonError">Reason is mandatory.</p>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeDeclineModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Cancel</button>
          <button type="submit" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-sans font-bold uppercase tracking-wider text-xs transition-colors">Confirm Decline</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const clearBtn = document.getElementById('clear-search-btn');
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }

  function openDeclineModal(actionUrl) {
    const form = document.getElementById('decline-form');
    form.action = actionUrl;
    const input = document.getElementById('declineReasonInput');
    const err = document.getElementById('declineReasonError');
    input.value = '';
    if (err) err.classList.add('hidden');
    input.classList.remove('border-red-500', 'focus:border-red-500');
    input.classList.add('border-brand-gray-200', 'focus:ring-brand-black');
    document.getElementById('decline-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDeclineModal() {
    document.getElementById('decline-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.getElementById('decline-form').addEventListener('submit', function(e) {
    const input = document.getElementById('declineReasonInput');
    const err = document.getElementById('declineReasonError');
    const val = input ? input.value.trim() : '';

    if (!val) {
      e.preventDefault();
      if (err) {
        err.textContent = 'Reason is mandatory.';
        err.classList.remove('hidden');
      }
      if (input) {
        input.classList.remove('border-brand-gray-200', 'focus:ring-brand-black');
        input.classList.add('border-red-500', 'focus:border-red-500');
        input.focus();
      }
    }
  });

  const inputEl = document.getElementById('declineReasonInput');
  if (inputEl) {
    inputEl.addEventListener('input', function() {
      if (this.value.trim()) {
        this.classList.remove('border-red-500', 'focus:border-red-500');
        this.classList.add('border-brand-gray-200', 'focus:ring-brand-black');
        const err = document.getElementById('declineReasonError');
        if (err) err.classList.add('hidden');
      }
    });
  }
</script>
