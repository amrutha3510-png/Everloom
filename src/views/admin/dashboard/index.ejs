<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Dashboard Header -->
<div class="mb-8">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
      <h1 class="font-serif text-3xl font-bold text-brand-black">Admin Dashboard</h1>
      <p class="font-sans text-brand-gray-500 text-xs mt-1">Real-time sales analytics, visual charts, top selling performance, and ledger book.</p>
    </div>

    <a href="/admin/sales-report" class="px-4 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 rounded-md font-sans text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-2 shadow-sm">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      Full Sales Report
    </a>
  </div>
</div>

<!-- 1. TOP: Existing Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 font-sans">
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm">
    <span id="cardLabelNetRevenue" class="text-[10px] font-bold text-brand-gray-400 uppercase tracking-widest2 block mb-1">
      <%= salesChart.filter === 'daily' ? 'Daily Net Revenue' : (salesChart.filter === 'weekly' ? 'Weekly Net Revenue' : (salesChart.filter === 'yearly' ? 'Yearly Net Revenue' : (salesChart.filter === 'custom' ? 'Net Revenue' : 'Monthly Net Revenue'))) %>
    </span>
    <h3 id="summaryNetRevenue" class="font-serif text-3xl font-bold text-brand-black">₹<%= summary.finalSalesAmount.toLocaleString('en-IN') %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm">
    <span id="cardLabelSalesCount" class="text-[10px] font-bold text-brand-gray-400 uppercase tracking-widest2 block mb-1">
      <%= salesChart.filter === 'daily' ? 'Daily Sales Count' : (salesChart.filter === 'weekly' ? 'Weekly Sales Count' : (salesChart.filter === 'yearly' ? 'Yearly Sales Count' : (salesChart.filter === 'custom' ? 'Sales Count' : 'Monthly Sales Count'))) %>
    </span>
    <h3 id="summarySalesCount" class="font-serif text-3xl font-bold text-brand-black"><%= summary.totalSalesCount %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm">
    <span id="cardLabelCouponDeductions" class="text-[10px] font-bold text-brand-gray-400 uppercase tracking-widest2 block mb-1">Coupon Deductions</span>
    <h3 id="summaryCouponDeductions" class="font-serif text-3xl font-bold text-green-600">₹<%= summary.couponDeductions.toLocaleString('en-IN') %></h3>
  </div>

  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm">
    <span id="cardLabelGrossAmount" class="text-[10px] font-bold text-brand-gray-400 uppercase tracking-widest2 block mb-1">Gross Order Amount</span>
    <h3 id="summaryGrossAmount" class="font-serif text-3xl font-bold text-brand-black">₹<%= summary.totalOrderAmount.toLocaleString('en-IN') %></h3>
  </div>
</div>

<!-- 2. MIDDLE: Sales Line Chart -->
<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm p-6 mb-8">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="font-serif text-xl font-bold text-brand-black">1. Sales Revenue Line Graph</h2>
      <p class="font-sans text-xs text-brand-gray-500 mt-0.5">Real revenue trends based on MongoDB order data (excluding Cancelled &amp; Returned orders).</p>
    </div>

    <!-- Filter Bar -->
    <div class="flex flex-wrap items-center gap-3 font-sans text-xs">
      <div class="flex items-center gap-2">
        <label for="salesPeriodSelect" class="font-semibold text-brand-gray-500 uppercase tracking-wider">Period:</label>
        <select id="salesPeriodSelect" onchange="handleSalesPeriodChange()" class="px-3 py-2 border border-brand-gray-200 rounded-md font-medium bg-white focus:outline-none focus:ring-1 focus:ring-brand-black">
          <option value="daily" <%= salesChart.filter === 'daily' ? 'selected' : '' %>>Daily (Today)</option>
          <option value="weekly" <%= salesChart.filter === 'weekly' ? 'selected' : '' %>>Weekly (This Week)</option>
          <option value="monthly" <%= salesChart.filter === 'monthly' ? 'selected' : '' %>>Monthly (This Year)</option>
          <option value="yearly" <%= salesChart.filter === 'yearly' ? 'selected' : '' %>>Yearly (5 Years)</option>
          <option value="custom" <%= salesChart.filter === 'custom' ? 'selected' : '' %>>Custom Date Range</option>
        </select>
      </div>

      <!-- Custom Date Pickers -->
      <% const todayDateStr = new Date().toISOString().split('T')[0]; %>
      <div id="custom-sales-dates" class="<%= salesChart.filter === 'custom' ? 'flex' : 'hidden' %> items-center gap-2">
        <input type="date" id="salesStartDate" max="<%= todayDateStr %>" class="px-2.5 py-1.5 border border-brand-gray-200 rounded-md bg-white">
        <span class="text-brand-gray-400">to</span>
        <input type="date" id="salesEndDate" max="<%= todayDateStr %>" class="px-2.5 py-1.5 border border-brand-gray-200 rounded-md bg-white">
        <button type="button" onclick="applyCustomSalesFilter()" class="px-3 py-1.5 bg-brand-black text-white rounded-md font-bold uppercase tracking-wider hover:bg-brand-gray-600 transition-colors">Apply</button>
      </div>
    </div>
  </div>

  <div class="relative w-full h-80">
    <canvas id="salesLineChartCanvas"></canvas>
    <div id="sales-no-data-msg" class="absolute inset-0 flex items-center justify-center bg-white/80 hidden">
      <p class="font-sans text-xs text-brand-gray-400 font-medium">No sales data available for the selected period.</p>
    </div>
  </div>
</div>

<!-- 3. BELOW: Side-by-Side Charts (Best Selling Bar Chart & Payment Method Pie/Donut Chart) -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  
  <!-- Best Selling Products Bar Graph -->
  <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm p-6 flex flex-col">
    <div class="mb-4">
      <h2 class="font-serif text-xl font-bold text-brand-black">2. <%= (topProductsBar && topProductsBar.labels && topProductsBar.labels.length > 0) ? ('Top ' + topProductsBar.labels.length) : 'Top' %> Best Selling Items (Bar Chart)</h2>
      <p class="font-sans text-xs text-brand-gray-500 mt-0.5">Quantity of successfully sold products from order data.</p>
    </div>

    <div class="relative w-full h-72 flex-1">
      <canvas id="bestSellingBarCanvas"></canvas>
      <div id="bar-no-data-msg" class="absolute inset-0 flex items-center justify-center bg-white/80 hidden">
        <p class="font-sans text-xs text-brand-gray-400 font-medium">No product sales recorded yet.</p>
      </div>
    </div>
  </div>

  <!-- Payment Method Distribution Donut/Pie Chart -->
  <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm p-6 flex flex-col">
    <div class="mb-4">
      <h2 class="font-serif text-xl font-bold text-brand-black">3. Payment Method Distribution (Donut Chart)</h2>
      <p class="font-sans text-xs text-brand-gray-500 mt-0.5">Order distribution across Cash on Delivery, Razorpay, and Wallet.</p>
    </div>

    <div class="relative w-full h-72 flex flex-center items-center justify-center flex-1">
      <canvas id="paymentPieCanvas"></canvas>
      <div id="pie-no-data-msg" class="absolute inset-0 flex items-center justify-center bg-white/80 hidden">
        <p class="font-sans text-xs text-brand-gray-400 font-medium">No valid payment records available.</p>
      </div>
    </div>
  </div>

</div>

<!-- 4. BOTTOM: Top Products & Top Categories Leaderboards -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8 font-sans">
  
  <!-- Top 5 Best Selling Products -->
  <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden flex flex-col">
    <div class="p-5 border-b border-brand-gray-100 bg-brand-gray-50/50">
      <h3 class="font-serif text-lg font-bold text-brand-black"><%= (topProducts && topProducts.length > 0) ? ('Top ' + Math.min(topProducts.length, 5)) : 'Top 5' %> Best Selling Products</h3>
      <p class="text-[11px] text-brand-gray-500 mt-0.5">Ranked by actual product sales volume</p>
    </div>
    <div class="divide-y divide-brand-gray-100 overflow-y-auto max-h-80 flex-1">
      <% if (topProducts && topProducts.length > 0) { %>
        <% topProducts.slice(0, 5).forEach((prod, index) => { %>
          <div class="p-4 flex items-center justify-between gap-3 hover:bg-brand-gray-50/50 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-6 h-6 rounded-full bg-brand-gray-100 font-mono font-bold text-xs flex items-center justify-center text-brand-black flex-shrink-0">
                <%= index + 1 %>
              </span>
              <div class="min-w-0">
                <h4 class="font-bold text-xs text-brand-black truncate"><%= prod.name %></h4>
                <span class="text-[10px] text-brand-gray-500 font-medium">₹<%= prod.totalRevenue.toLocaleString('en-IN') %> revenue</span>
              </div>
            </div>
            <span class="px-2.5 py-1 bg-brand-gray-100 text-brand-black font-bold text-xs rounded-full flex-shrink-0">
              <%= prod.totalQuantitySold %> sold
            </span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="p-8 text-center text-brand-gray-400 text-xs">No product sales recorded yet.</div>
      <% } %>
    </div>
  </div>

  <!-- Top 5 Best Selling Categories -->
  <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden flex flex-col">
    <div class="p-5 border-b border-brand-gray-100 bg-brand-gray-50/50">
      <h3 class="font-serif text-lg font-bold text-brand-black"><%= (topCategories && topCategories.length > 0) ? ('Top ' + Math.min(topCategories.length, 5)) : 'Top 5' %> Best Selling Categories</h3>
      <p class="text-[11px] text-brand-gray-500 mt-0.5">Ranked by actual product sales volume</p>
    </div>
    <div class="divide-y divide-brand-gray-100 overflow-y-auto max-h-80 flex-1">
      <% if (topCategories && topCategories.length > 0) { %>
        <% topCategories.slice(0, 5).forEach((cat, index) => { %>
          <div class="p-4 flex items-center justify-between gap-3 hover:bg-brand-gray-50/50 transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-6 h-6 rounded-full bg-brand-gray-100 font-mono font-bold text-xs flex items-center justify-center text-brand-black flex-shrink-0">
                <%= index + 1 %>
              </span>
              <div class="min-w-0">
                <h4 class="font-bold text-xs text-brand-black truncate"><%= cat.name %></h4>
                <span class="text-[10px] text-brand-gray-500 font-medium">₹<%= cat.totalRevenue.toLocaleString('en-IN') %> revenue</span>
              </div>
            </div>
            <span class="px-2.5 py-1 bg-brand-gray-100 text-brand-black font-bold text-xs rounded-full flex-shrink-0">
              <%= cat.totalQuantitySold %> sold
            </span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="p-8 text-center text-brand-gray-400 text-xs">No category sales recorded yet.</div>
      <% } %>
    </div>
  </div>

</div>

<!-- Ledger Book Table -->
<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden mb-12">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black">Ledger Book (Recent Transactions)</h2>
    <p class="font-sans text-xs text-brand-gray-500 mt-0.5">Financial debit &amp; credit ledger entries derived from real order and refund records.</p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse font-sans text-sm">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50 text-[10px] font-bold text-brand-gray-500 uppercase tracking-widest2">
          <th class="px-6 py-4">Date</th>
          <th class="px-6 py-4">Ref ID</th>
          <th class="px-6 py-4">Description</th>
          <th class="px-6 py-4">Type</th>
          <th class="px-6 py-4 text-right">Amount</th>
          <th class="px-6 py-4 text-right">Running Balance</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-100 text-brand-black">
        <% if (ledgerEntries && ledgerEntries.length > 0) { %>
          <% ledgerEntries.forEach(entry => { %>
            <tr class="hover:bg-brand-gray-50/50 transition-colors">
              <td class="px-6 py-4 text-xs text-brand-gray-500"><%= entry.date %></td>
              <td class="px-6 py-4 font-mono font-bold text-xs"><%= entry.ref %></td>
              <td class="px-6 py-4 font-medium"><%= entry.description %></td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-bold uppercase rounded-md <%= entry.type === 'Credit' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                  <%= entry.type %>
                </span>
              </td>
              <td class="px-6 py-4 text-right font-bold <%= entry.type === 'Credit' ? 'text-green-600' : 'text-red-600' %>">
                <%= entry.type === 'Credit' ? '+' : '-' %>₹<%= entry.amount.toLocaleString('en-IN') %>
              </td>
              <td class="px-6 py-4 text-right font-medium text-brand-gray-600">
                ₹<%= entry.runningBalance.toLocaleString('en-IN') %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-10 text-center text-brand-gray-400 text-xs">No ledger records found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Chart Initialization Script -->
<script>
  let salesLineChartInstance = null;
  let bestSellingBarChartInstance = null;
  let paymentPieChartInstance = null;

  document.addEventListener('DOMContentLoaded', () => {
    initSalesLineChart();
    initBestSellingBarChart();
    initPaymentPieChart();
  });

  // 1. SALES REVENUE LINE CHART
  function initSalesLineChart() {
    const canvas = document.getElementById('salesLineChartCanvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const chartLabels = <%- JSON.stringify(salesChart.labels || []) %>;
    const chartData = <%- JSON.stringify(salesChart.data || []) %>;

    checkSalesNoData(chartData);

    salesLineChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: chartLabels,
        datasets: [{
          label: 'Revenue (₹)',
          data: chartData,
          borderColor: '#111111',
          backgroundColor: 'rgba(17, 17, 17, 0.05)',
          borderWidth: 2,
          fill: true,
          tension: 0.3,
          pointBackgroundColor: '#111111',
          pointRadius: 4,
          pointHoverRadius: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                return ' Sales: ₹' + ctx.parsed.y.toLocaleString('en-IN');
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { font: { family: 'sans-serif', size: 10 } }
          },
          y: {
            beginAtZero: true,
            grid: { color: '#F3F4F6' },
            ticks: {
              font: { family: 'sans-serif', size: 10 },
              callback: function(val) {
                return '₹' + val.toLocaleString('en-IN');
              }
            }
          }
        }
      }
    });
  }

  function checkSalesNoData(dataArr) {
    const noDataEl = document.getElementById('sales-no-data-msg');
    const hasValue = dataArr && dataArr.some(v => v > 0);
    if (!hasValue) {
      if (noDataEl) noDataEl.classList.remove('hidden');
    } else {
      if (noDataEl) noDataEl.classList.add('hidden');
    }
  }

  function handleSalesPeriodChange() {
    const period = document.getElementById('salesPeriodSelect').value;
    const customContainer = document.getElementById('custom-sales-dates');

    if (period === 'custom') {
      customContainer.classList.remove('hidden');
      customContainer.classList.add('flex');
    } else {
      customContainer.classList.add('hidden');
      customContainer.classList.remove('flex');
      fetchSalesChartData(period);
    }
  }

  function applyCustomSalesFilter() {
    const start = document.getElementById('salesStartDate').value;
    const end = document.getElementById('salesEndDate').value;
    if (!start || !end) {
      alert('Please select both start and end dates.');
      return;
    }
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    const todayStr = `${y}-${m}-${d}`;

    if (start > todayStr || end > todayStr) {
      alert('Future dates are not allowed.');
      return;
    }
    if (start > end) {
      alert('Start Date must be before or equal to End Date.');
      return;
    }
    fetchSalesChartData('custom', start, end);
  }

  async function fetchSalesChartData(filter, startDate = null, endDate = null) {
    try {
      let url = `/admin/dashboard/api/chart-data?filter=${filter}`;
      if (startDate && endDate) {
        url += `&startDate=${startDate}&endDate=${endDate}`;
      }

      const res = await fetch(url);
      const data = await res.json();

      if (res.ok && data.success) {
        // 1. Update Chart
        if (salesLineChartInstance && data.salesChart) {
          salesLineChartInstance.data.labels = data.salesChart.labels;
          salesLineChartInstance.data.datasets[0].data = data.salesChart.data;
          salesLineChartInstance.update();
          checkSalesNoData(data.salesChart.data);
        }

        // 2. Update Summary Cards
        if (data.summary) {
          const netEl = document.getElementById('summaryNetRevenue');
          const countEl = document.getElementById('summarySalesCount');
          const couponEl = document.getElementById('summaryCouponDeductions');
          const grossEl = document.getElementById('summaryGrossAmount');

          if (netEl) netEl.textContent = '₹' + Number(data.summary.finalSalesAmount || 0).toLocaleString('en-IN');
          if (countEl) countEl.textContent = Number(data.summary.totalSalesCount || 0).toLocaleString('en-IN');
          if (couponEl) couponEl.textContent = '₹' + Number(data.summary.couponDeductions || 0).toLocaleString('en-IN');
          if (grossEl) grossEl.textContent = '₹' + Number(data.summary.totalOrderAmount || 0).toLocaleString('en-IN');

          const labelNetEl = document.getElementById('cardLabelNetRevenue');
          const labelCountEl = document.getElementById('cardLabelSalesCount');
          const prefix = filter === 'daily' ? 'Daily' : filter === 'weekly' ? 'Weekly' : filter === 'monthly' ? 'Monthly' : filter === 'yearly' ? 'Yearly' : '';
          if (labelNetEl) labelNetEl.textContent = prefix ? `${prefix} Net Revenue` : 'Net Revenue';
          if (labelCountEl) labelCountEl.textContent = prefix ? `${prefix} Sales Count` : 'Sales Count';
        }
      } else if (data && data.message) {
        alert(data.message);
      }
    } catch (err) {
      console.error('AJAX chart update error:', err);
    }
  }

  // 2. BEST SELLING PRODUCTS BAR GRAPH
  function initBestSellingBarChart() {
    const canvas = document.getElementById('bestSellingBarCanvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const barLabels = <%- JSON.stringify(topProductsBar.labels || []) %>;
    const barData = <%- JSON.stringify(topProductsBar.data || []) %>;

    const noDataEl = document.getElementById('bar-no-data-msg');
    if (!barData || barData.length === 0 || !barData.some(v => v > 0)) {
      if (noDataEl) noDataEl.classList.remove('hidden');
    }

    bestSellingBarChartInstance = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: barLabels,
        datasets: [{
          label: 'Quantity Sold',
          data: barData,
          backgroundColor: '#111111',
          borderRadius: 4,
          maxBarThickness: 32
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                return ' Sold: ' + ctx.parsed.y + ' units';
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              font: { family: 'sans-serif', size: 10 },
              callback: function(val, index) {
                const label = this.getLabelForValue(index);
                return label.length > 12 ? label.substring(0, 12) + '...' : label;
              }
            }
          },
          y: {
            beginAtZero: true,
            grid: { color: '#F3F4F6' },
            ticks: {
              stepSize: 1,
              font: { family: 'sans-serif', size: 10 }
            }
          }
        }
      }
    });
  }

  // 3. PAYMENT METHOD DONUT/PIE CHART
  function initPaymentPieChart() {
    const canvas = document.getElementById('paymentPieCanvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const pieLabels = <%- JSON.stringify(paymentChart.labels || []) %>;
    const pieData = <%- JSON.stringify(paymentChart.data || [0,0,0]) %>;

    const noDataEl = document.getElementById('pie-no-data-msg');
    if (!pieData || !pieData.some(v => v > 0)) {
      if (noDataEl) noDataEl.classList.remove('hidden');
    }

    paymentPieChartInstance = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: pieLabels,
        datasets: [{
          data: pieData,
          backgroundColor: ['#111111', '#4B5563', '#9CA3AF'],
          borderWidth: 2,
          borderColor: '#FFFFFF'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '65%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              font: { family: 'sans-serif', size: 11 },
              usePointStyle: true,
              padding: 16
            }
          },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                const val = ctx.parsed;
                const pct = total > 0 ? Math.round((val / total) * 100) : 0;
                return ` ${ctx.label}: ${val} orders (${pct}%)`;
              }
            }
          }
        }
      }
    });
  }
</script>
