<!-- Title & Create Offer Button -->
<div class="max-w-6xl mx-auto mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      <svg class="w-6 h-6 text-brand-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      Offer Management
    </h1>
    <p class="font-sans text-xs text-brand-gray-500 mt-1">Manage Product-specific and Category-level promotional offers.</p>
  </div>

  <button type="button" onclick="openCreateOfferModal()" class="px-4 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 rounded-md font-sans text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-2 shadow-sm">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    Create New Offer
  </button>
</div>

<!-- Offers Table Card -->
<div class="max-w-6xl mx-auto bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100 flex items-center justify-between">
    <h2 class="font-serif text-xl font-bold text-brand-black">Active &amp; Inactive Offers</h2>
    <span class="font-sans text-xs text-brand-gray-500 font-medium">Total: <%= offers.length %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse font-sans text-sm">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50 text-[10px] font-bold text-brand-gray-500 uppercase tracking-widest2">
          <th class="px-6 py-4">Offer Name</th>
          <th class="px-6 py-4">Target Type</th>
          <th class="px-6 py-4">Target Detail</th>
          <th class="px-6 py-4">Discount</th>
          <th class="px-6 py-4">Expiry Date</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-100 text-brand-black">
        <% if (offers && offers.length > 0) { %>
          <% offers.forEach(offer => { %>
            <tr class="hover:bg-brand-gray-50/50 transition-colors">
              <td class="px-6 py-4 font-semibold text-brand-black">
                <%= offer.name %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-bold uppercase rounded-md <%= offer.targetType === 'Product' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                  <%= offer.targetType %>
                </span>
              </td>
              <td class="px-6 py-4 font-medium text-xs">
                <% if (offer.targetType === 'Product' && offer.product) { %>
                  <%= offer.product.name %>
                <% } else if (offer.targetType === 'Category' && offer.category) { %>
                  <%= offer.category.name %>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td class="px-6 py-4 font-bold text-brand-black">
                <%= offer.discountType === 'PERCENTAGE' ? offer.discountValue + '%' : '₹' + offer.discountValue %>
              </td>
              <td class="px-6 py-4 text-xs text-brand-gray-500">
                <%= new Date(offer.endDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-md <%= offer.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                  <%= offer.status %>
                </span>
              </td>
              <td class="px-6 py-4 text-right whitespace-nowrap space-x-2">
                <button type="button" onclick="toggleOfferStatus('<%= offer._id %>')" class="px-3 py-1.5 border border-brand-gray-200 text-brand-black text-xs font-semibold rounded hover:bg-brand-gray-50 transition-colors">
                  <%= offer.status === 'Active' ? 'Deactivate' : 'Activate' %>
                </button>
                <button type="button" onclick="deleteOffer('<%= offer._id %>')" class="px-3 py-1.5 bg-red-600 text-white text-xs font-semibold rounded hover:bg-red-700 transition-colors">
                  Delete
                </button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No offers created yet. Click "Create New Offer" to add one.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create Offer Modal -->
<div id="offer-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeCreateOfferModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Create New Offer</h3>
        <button type="button" onclick="closeCreateOfferModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="offer-form" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Offer Title <span class="text-red-500">*</span></label>
          <input type="text" id="offer-name" required placeholder="e.g. Festive Product Special" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
          <p class="hidden text-red-500 text-xs mt-1" id="offer-name-err"></p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Target Type <span class="text-red-500">*</span></label>
            <select id="offer-targetType" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black" onchange="handleTargetTypeChange()">
              <option value="Product">Product Offer</option>
              <option value="Category">Category Offer</option>
            </select>
          </div>
          
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Discount Type</label>
            <select id="offer-discountType" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
              <option value="PERCENTAGE">Percentage (%)</option>
              <option value="FIXED">Fixed Amount (₹)</option>
            </select>
          </div>
        </div>

        <!-- Target Product Select -->
        <div id="target-product-container">
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Select Product <span class="text-red-500">*</span></label>
          <select id="offer-productId" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
            <option value="">-- Choose Product --</option>
            <% products.forEach(prod => { %>
              <option value="<%= prod._id %>"><%= prod.name %></option>
            <% }) %>
          </select>
        </div>

        <!-- Target Category Select -->
        <div id="target-category-container" class="hidden">
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Select Category <span class="text-red-500">*</span></label>
          <select id="offer-categoryId" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
            <option value="">-- Choose Category --</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat._id %>"><%= cat.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Discount Value <span class="text-red-500">*</span></label>
            <input type="number" id="offer-discountValue" min="1" required placeholder="e.g. 15" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
            <p class="hidden text-red-500 text-xs mt-1" id="offer-discountValue-err"></p>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-1">Expiry Date <span class="text-red-500">*</span></label>
            <input type="date" id="offer-endDate" required class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black">
            <p class="hidden text-red-500 text-xs mt-1" id="offer-endDate-err"></p>
          </div>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeCreateOfferModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Cancel</button>
          <button type="submit" class="flex-1 py-2.5 bg-brand-black text-white hover:bg-brand-gray-600 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Save Offer</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openCreateOfferModal() {
    document.getElementById('offer-form').reset();
    handleTargetTypeChange();
    document.getElementById('offer-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeCreateOfferModal() {
    document.getElementById('offer-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  function handleTargetTypeChange() {
    const targetType = document.getElementById('offer-targetType').value;
    const prodContainer = document.getElementById('target-product-container');
    const catContainer = document.getElementById('target-category-container');

    if (targetType === 'Product') {
      prodContainer.classList.remove('hidden');
      catContainer.classList.add('hidden');
    } else {
      catContainer.classList.remove('hidden');
      prodContainer.classList.add('hidden');
    }
  }

  document.getElementById('offer-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const name = document.getElementById('offer-name').value.trim();
    const targetType = document.getElementById('offer-targetType').value;
    const discountType = document.getElementById('offer-discountType').value;
    const discountValue = Number(document.getElementById('offer-discountValue').value);
    const endDate = document.getElementById('offer-endDate').value;

    const targetId = targetType === 'Product' ? 
      document.getElementById('offer-productId').value : 
      document.getElementById('offer-categoryId').value;

    let valid = true;

    if (!name) {
      alert('Offer title is required');
      return;
    }

    if (!targetId) {
      alert(`Please select a ${targetType.toLowerCase()}`);
      return;
    }

    if (isNaN(discountValue) || discountValue <= 0) {
      alert('Discount value must be greater than 0');
      return;
    }

    if (discountType === 'PERCENTAGE' && discountValue > 90) {
      alert('Percentage discount cannot exceed 90%');
      return;
    }

    if (!endDate) {
      alert('Expiry date is required');
      return;
    }

    try {
      const res = await fetch('/admin/offers/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          targetType,
          targetId,
          discountType,
          discountValue,
          endDate
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to create offer');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred while saving offer');
    }
  });

  async function toggleOfferStatus(offerId) {
    try {
      const res = await fetch(`/admin/offers/${offerId}/toggle-status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to toggle status');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred');
    }
  }

  async function deleteOffer(offerId) {
    if (!confirm('Are you sure you want to delete this offer?')) return;

    try {
      const res = await fetch(`/admin/offers/${offerId}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.message || 'Failed to delete offer');
      }
    } catch (err) {
      console.error(err);
      alert('Network error occurred');
    }
  }
</script>
