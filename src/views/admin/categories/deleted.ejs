<!-- Title & Header Action -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div>
    <a href="/admin/categories" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-gray-500 hover:text-brand-black transition-colors mb-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
      </svg>
      Back to Categories
    </a>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Deleted Categories
    </h1>
  </div>
</div>

<!-- Category Directory Card -->
<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Deleted Categories</h2>
    
    <form id="filter-form" action="/admin/categories/deleted" method="GET" class="flex flex-col lg:flex-row gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search deleted category by name..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>

      <!-- Sort Filter Dropdown -->
      <div class="relative w-full lg:w-48">
        <select id="sort-filter" name="sort" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="newest" <%= sortOption === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="oldest" <%= sortOption === 'oldest' ? 'selected' : '' %>>Oldest First</option>
          <option value="az" <%= sortOption === 'az' ? 'selected' : '' %>>A-Z</option>
          <option value="za" <%= sortOption === 'za' ? 'selected' : '' %>>Z-A</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <div class="flex gap-2 w-full lg:w-auto">
        <!-- Search Button -->
        <button type="submit" class="flex-1 lg:flex-initial bg-brand-black text-white px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        
        <% if (searchQuery || sortOption !== 'newest') { %>
          <!-- Clear Filters Button -->
          <a href="/admin/categories/deleted" class="flex-1 lg:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center" title="Clear all search and filters">
            Clear Filters
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Mobile Card View (visible on < md screens) -->
  <div class="block md:hidden divide-y divide-brand-gray-100">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <div class="p-5 flex flex-col gap-4 hover:bg-brand-gray-50 transition-colors">
          <div class="flex gap-4 items-start">
            <div class="w-16 h-16 rounded-none overflow-hidden bg-brand-gray-100 flex-shrink-0 border border-brand-gray-200">
              <% if (category.image) { %>
                <img src="<%= category.image %>" alt="<%= category.name %>" class="w-full h-full object-cover">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center font-serif text-lg font-bold text-brand-gray-400 bg-brand-gray-200">
                  <%= category.name.charAt(0).toUpperCase() %>
                </div>
              <% } %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-sans font-semibold text-brand-black text-base truncate"><%= category.name %></h3>
                <span class="px-2.5 py-0.5 inline-flex text-[10px] leading-5 font-semibold rounded-md bg-red-100 text-red-700">
                  Deleted
                </span>
              </div>
              <p class="font-sans text-xs text-brand-gray-500 mt-1 line-clamp-2"><%= category.description || 'No description.' %></p>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs pt-2 border-t border-brand-gray-50">
            <div>
              <span class="block text-[10px] text-brand-gray-400 uppercase tracking-wider">Created Date</span>
              <span class="font-medium text-brand-black"><%= new Date(category.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
            </div>

            <!-- Action Icon Buttons -->
            <div class="flex items-center gap-1.5">
              <!-- Restore Icon Button -->
              <button class="restore-category-btn p-2 rounded-md border transition-colors bg-green-50 text-green-600 border-green-200 hover:bg-green-100"
                      data-id="<%= category._id %>"
                      title="Restore Category">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="p-8 text-center text-brand-gray-400 font-sans text-sm">
        No deleted categories found.
      </div>
    <% } %>
  </div>

  <!-- Desktop Table View (visible on >= md screens) -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50/50">
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Category Name</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Created Date</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-50">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(category => { %>
            <tr class="hover:bg-brand-gray-50 transition-colors">
              <!-- Name & Image Column -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-none overflow-hidden bg-brand-gray-100 border border-brand-gray-200 flex-shrink-0 opacity-60 grayscale">
                    <% if (category.image) { %>
                      <img src="<%= category.image %>" alt="<%= category.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center font-serif text-sm font-bold text-brand-gray-400 bg-brand-gray-200">
                        <%= category.name.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                  </div>
                  <span class="font-sans font-medium text-brand-black text-sm"><%= category.name %></span>
                </div>
              </td>
              <!-- Description Column -->
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500 max-w-xs truncate" title="<%= category.description %>">
                <%= category.description || '—' %>
              </td>
              <!-- Status Column -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md bg-red-100 text-red-700">
                  Deleted
                </span>
              </td>
              <!-- Created Date Column -->
              <td class="px-6 py-4 whitespace-nowrap font-sans text-sm text-brand-gray-500">
                <%= new Date(category.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <!-- Action Icon Buttons Column -->
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <!-- Restore Icon Button -->
                  <button class="restore-category-btn p-2 rounded-md border transition-colors bg-green-50 text-green-600 border-green-200 hover:bg-green-100"
                          data-id="<%= category._id %>"
                          title="Restore Category">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No deleted categories found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-sm text-brand-gray-500 text-center sm:text-left">
        Showing <%= ((currentPage - 1) * 10) + 1 %> to <%= Math.min(currentPage * 10, totalEntries) %> of <%= totalEntries %> entries
      </p>
      
      <div class="flex items-center justify-between w-full sm:w-auto gap-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Previous
          </a>
        <% } else { %>
          <span class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-300 flex items-center gap-1 cursor-not-allowed text-xs sm:text-sm">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Previous
          </span>
        <% } %>

        <!-- Page Numbers -->
        <div class="hidden sm:flex items-center gap-1">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="w-8 h-8 flex items-center justify-center bg-brand-gray-100 rounded-md font-medium text-brand-black"><%= i %></span>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <a href="?page=<%= i %>&search=<%= encodeURIComponent(searchQuery) %>&sort=<%= encodeURIComponent(sortOption) %>" class="w-8 h-8 flex items-center justify-center border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors"><%= i %></a>
            <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
              <span class="w-8 h-8 flex items-center justify-center text-brand-gray-400">...</span>
            <% } %>
          <% } %>
        </div>

        <!-- Mobile Page Indicator -->
        <span class="sm:hidden font-sans text-xs text-brand-gray-500 font-medium">
          Page <%= currentPage %> of <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Next
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        <% } else { %>
          <span class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-300 flex items-center gap-1 cursor-not-allowed text-xs sm:text-sm">
            Next
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </span>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  const clearSearchBtn = document.getElementById('clear-search-btn');
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }

  // Restore Category
  document.querySelectorAll('.restore-category-btn').forEach(button => {
    button.addEventListener('click', async function() {
      const categoryId = this.getAttribute('data-id');

      const result = await Swal.fire({
        title: 'Restore Category?',
        text: 'Are you sure you want to restore this category?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#16a34a',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, restore it!',
        cancelButtonText: 'Cancel',
        customClass: { popup: 'rounded-xl font-sans' }
      });

      if (result.isConfirmed) {
        try {
          const response = await axios.post(`/admin/categories/restore/${categoryId}`);
          if (response.data.success) {
            Swal.fire({
              title: 'Success!',
              text: response.data.message || 'Category restored.',
              icon: 'success',
              timer: 1500,
              showConfirmButton: false
            }).then(() => {
              window.location.reload();
            });
          }
        } catch (error) {
          Swal.fire({
            title: 'Error!',
            text: error.response?.data?.message || 'Something went wrong.',
            icon: 'error'
          });
        }
      }
    });
  });
</script>
