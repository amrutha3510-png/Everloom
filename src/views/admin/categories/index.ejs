<!-- Title & Header Action -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
    </svg>
    Category Management
  </h1>
  <a href="/admin/categories/add" class="inline-flex items-center justify-center gap-2 bg-brand-black text-white px-5 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors shadow-sm">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    Add Category
  </a>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
  <!-- Total Categories -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Total<br>Categories</p>
      <div class="p-2 bg-brand-gray-50 rounded-full">
        <svg class="w-4 h-4 text-brand-gray-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
        </svg>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.total %></h3>
  </div>

  <!-- Active Categories -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Active Categories</p>
      <div class="p-2 bg-green-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-green-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.active %></h3>
  </div>

  <!-- Inactive Categories -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Inactive Categories</p>
      <div class="p-2 bg-gray-100 rounded-full">
        <div class="w-2.5 h-2.5 bg-gray-400 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.inactive %></h3>
  </div>
</div>

<!-- Category Directory Card -->
<div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Category Directory</h2>
    
    <form id="filter-form" action="/admin/categories" method="GET" class="flex flex-col lg:flex-row gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search category by name..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>
      
      <!-- Status Filter -->
      <div class="relative w-full lg:w-44">
        <select id="status-filter" name="status" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="All Status" <%= statusFilter === 'All Status' ? 'selected' : '' %>>All Status</option>
          <option value="Active" <%= statusFilter === 'Active' ? 'selected' : '' %>>Active</option>
          <option value="Inactive" <%= statusFilter === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>

      <!-- Sort Filter Dropdown -->
      <div class="relative w-full lg:w-48">
        <select id="sort-filter" name="sort" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
          <option value="newest" <%= sortOption === 'newest' ? 'selected' : '' %>>Newest First</option>
          <option value="oldest" <%= sortOption === 'oldest' ? 'selected' : '' %>>Oldest First</option>
          <option value="az" <%= sortOption === 'az' ? 'selected' : '' %>>A-Z</option>
          <option value="za" <%= sortOption === 'za' ? 'selected' : '' %>>Z-A</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <div class="flex gap-2 w-full lg:w-auto">
        <!-- Search Button -->
        <button type="submit" class="flex-1 lg:flex-initial bg-brand-black text-white px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        
        <% if (searchQuery || statusFilter !== 'All Status' || sortOption !== 'newest') { %>
          <!-- Clear Filters Button -->
          <a href="/admin/categories" class="flex-1 lg:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center" title="Clear all search and filters">
            Clear Filters
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Mobile Card View (visible on < md screens) -->
  <div class="block md:hidden divide-y divide-brand-gray-100">
    <% if (categories && categories.length > 0) { %>
      <% categories.forEach(category => { %>
        <div class="p-5 flex flex-col gap-4 hover:bg-brand-gray-50 transition-colors">
          <div class="flex gap-4 items-start">
            <div class="w-16 h-16 rounded-lg overflow-hidden bg-brand-gray-100 flex-shrink-0 border border-brand-gray-200">
              <% if (category.image) { %>
                <img src="<%= category.image %>" alt="<%= category.name %>" class="w-full h-full object-cover">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center font-serif text-lg font-bold text-brand-gray-400 bg-brand-gray-200">
                  <%= category.name.charAt(0).toUpperCase() %>
                </div>
              <% } %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-sans font-semibold text-brand-black text-base truncate"><%= category.name %></h3>
                <span id="status-badge-mobile-<%= category._id %>" class="px-2.5 py-0.5 inline-flex text-[10px] leading-5 font-semibold rounded-md 
                  <%= category.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
                  <%= category.status %>
                </span>
              </div>
              <p class="font-sans text-xs text-brand-gray-500 mt-1 line-clamp-2"><%= category.description || 'No description.' %></p>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs pt-2 border-t border-brand-gray-50">
            <div>
              <span class="block text-[10px] text-brand-gray-400 uppercase tracking-wider">Created Date</span>
              <span class="font-medium text-brand-black"><%= new Date(category.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
            </div>

            <!-- Action Icon Buttons -->
            <div class="flex items-center gap-1.5">
              <!-- Edit Icon Button -->
              <a href="/admin/categories/edit/<%= category._id %>" 
                 class="p-2 bg-brand-gray-100 text-brand-black border border-brand-gray-200 rounded-md hover:bg-brand-gray-200 transition-colors"
                 title="Edit Category">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                </svg>
              </a>

              <!-- Block / Unblock Icon Button -->
              <button class="toggle-category-status-btn p-2 rounded-md border transition-colors <%= category.status === 'Active' ? 'bg-red-50 text-red-600 border-red-200 hover:bg-red-100' : 'bg-green-50 text-green-600 border-green-200 hover:bg-green-100' %>"
                      data-id="<%= category._id %>"
                      data-current-status="<%= category.status %>"
                      title="<%= category.status === 'Active' ? 'Block Category' : 'Unblock Category' %>">
                <% if (category.status === 'Active') { %>
                  <!-- Block: Closed Lock -->
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                <% } else { %>
                  <!-- Unblock: Open Lock -->
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>
                  </svg>
                <% } %>
              </button>

            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="p-8 text-center text-brand-gray-400 font-sans text-sm">
        No categories found.
      </div>
    <% } %>
  </div>

  <!-- Desktop Table View (visible on >= md screens) -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50/50">
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Category Name</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Description</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Active Visibility</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider">Created Date</th>
          <th class="px-6 py-4 font-sans text-xs font-semibold text-brand-gray-500 uppercase tracking-wider text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-50">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(category => { %>
            <tr class="hover:bg-brand-gray-50 transition-colors">
              <!-- Name & Image Column -->
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full overflow-hidden bg-brand-gray-100 border border-brand-gray-200 flex-shrink-0">
                    <% if (category.image) { %>
                      <img src="<%= category.image %>" alt="<%= category.name %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center font-serif text-sm font-bold text-brand-gray-400 bg-brand-gray-200">
                        <%= category.name.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                  </div>
                  <span class="font-sans font-medium text-brand-black text-sm"><%= category.name %></span>
                </div>
              </td>
              <!-- Description Column -->
              <td class="px-6 py-4 font-sans text-sm text-brand-gray-500 max-w-xs truncate" title="<%= category.description %>">
                <%= category.description || '—' %>
              </td>
              <!-- Active Visibility Column -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span id="status-badge-<%= category._id %>" class="px-3 py-1 inline-flex text-[11px] leading-5 font-semibold rounded-md 
                  <%= category.status === 'Active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
                  <%= category.status %>
                </span>
              </td>
              <!-- Created Date Column -->
              <td class="px-6 py-4 whitespace-nowrap font-sans text-sm text-brand-gray-500">
                <%= new Date(category.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <!-- Action Icon Buttons Column -->
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <div class="flex items-center justify-end gap-2">
                  <!-- Edit Icon Button -->
                  <a href="/admin/categories/edit/<%= category._id %>" 
                     class="p-2 bg-brand-gray-100 text-brand-black border border-brand-gray-200 rounded-md hover:bg-brand-gray-200 transition-colors"
                     title="Edit Category">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/>
                    </svg>
                  </a>

                  <!-- Block / Unblock Toggle Icon Button -->
                  <button class="toggle-category-status-btn p-2 rounded-md border transition-colors <%= category.status === 'Active' ? 'bg-red-50 text-red-600 border-red-200 hover:bg-red-100' : 'bg-green-50 text-green-600 border-green-200 hover:bg-green-100' %>"
                          data-id="<%= category._id %>"
                          data-current-status="<%= category.status %>"
                          title="<%= category.status === 'Active' ? 'Block Category' : 'Unblock Category' %>">
                    <% if (category.status === 'Active') { %>
                      <!-- Block: Closed Lock -->
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                      </svg>
                    <% } else { %>
                      <!-- Unblock: Open Lock -->
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>
                      </svg>
                    <% } %>
                  </button>

                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-brand-gray-400 font-sans text-sm">
              No categories found.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-sm text-brand-gray-500 text-center sm:text-left">
        Showing <%= ((currentPage - 1) * 10) + 1 %> to <%= Math.min(currentPage * 10, totalEntries) %> of <%= totalEntries %> entries
      </p>
      
      <div class="flex items-center justify-between w-full sm:w-auto gap-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Previous
          </a>
        <% } else { %>
          <span class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-300 flex items-center gap-1 cursor-not-allowed text-xs sm:text-sm">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Previous
          </span>
        <% } %>

        <!-- Page Numbers -->
        <div class="hidden sm:flex items-center gap-1">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="w-8 h-8 flex items-center justify-center bg-brand-gray-100 rounded-md font-medium text-brand-black"><%= i %></span>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <a href="?page=<%= i %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="w-8 h-8 flex items-center justify-center border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors"><%= i %></a>
            <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
              <span class="w-8 h-8 flex items-center justify-center text-brand-gray-400">...</span>
            <% } %>
          <% } %>
        </div>

        <!-- Mobile Page Indicator -->
        <span class="sm:hidden font-sans text-xs text-brand-gray-500 font-medium">
          Page <%= currentPage %> of <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Next
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        <% } else { %>
          <span class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-300 flex items-center gap-1 cursor-not-allowed text-xs sm:text-sm">
            Next
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </span>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Auto-submit on filter change has been intentionally removed per requirements.
  // The user must click the "Search" button to apply filters.

  // Clear search button handler
  const clearSearchBtn = document.getElementById('clear-search-btn');
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }

  // Toggle Category Status (Block / Unblock Active Visibility)
  document.querySelectorAll('.toggle-category-status-btn').forEach(button => {
    button.addEventListener('click', async function() {
      const categoryId = this.getAttribute('data-id');
      const currentStatus = this.getAttribute('data-current-status');
      const actionText = currentStatus === 'Active' ? 'block' : 'unblock';
      const actionTitle = actionText.charAt(0).toUpperCase() + actionText.slice(1);
      const confirmColor = currentStatus === 'Active' ? '#f59e0b' : '#16a34a';

      const result = await Swal.fire({
        title: `${actionTitle} Category?`,
        text: `Are you sure you want to ${actionText} this category?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: confirmColor,
        cancelButtonColor: '#6b7280',
        confirmButtonText: `Yes, ${actionText} it!`,
        cancelButtonText: 'Cancel',
        customClass: { popup: 'rounded-xl font-sans' }
      });

      if (result.isConfirmed) {
        try {
          const response = await axios.post(`/admin/categories/toggle-status/${categoryId}`);
          if (response.data.success) {
            Swal.fire({
              title: 'Success!',
              text: response.data.message || 'Category status updated.',
              icon: 'success',
              timer: 1500,
              showConfirmButton: false
            }).then(() => {
              window.location.reload();
            });
          }
        } catch (error) {
          Swal.fire({
            title: 'Error!',
            text: error.response?.data?.message || 'Something went wrong.',
            icon: 'error'
          });
        }
      }
    });
  });


</script>
