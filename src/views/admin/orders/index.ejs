<!-- Title & Return Requests Button -->
<div class="max-w-6xl mx-auto mb-8 flex items-center justify-between">
  <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
    </svg>
    Order Management
  </h1>

  <a href="/admin/returns" class="px-4 py-2.5 bg-white border border-brand-gray-200 text-brand-black hover:bg-brand-gray-50 rounded-md font-sans text-xs font-bold uppercase tracking-wider transition-colors flex items-center gap-2 shadow-sm">
    <svg class="w-4 h-4 text-brand-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 15v-1a4 4 0 00-4-4H4m0 0l4-4m-4 4l4 4m6 4v1a3 3 0 003 3h3a3 3 0 003-3v-3a3 3 0 00-3-3h-3" />
    </svg>
    Return Requests
  </a>
</div>

<!-- Stats Cards -->
<div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-4 gap-6 mb-8">
  <!-- Total -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Total<br>Orders</p>
      <div class="p-2 bg-brand-gray-50 rounded-full">
        <svg class="w-4 h-4 text-brand-gray-600" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 110-2H7zm3 0a1 1 0 100 2h3a1 1 0 110-2h-3z" clip-rule="evenodd"/></svg>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.total %></h3>
  </div>

  <!-- Pending -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Pending</p>
      <div class="p-2 bg-yellow-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-yellow-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.pending %></h3>
  </div>

  <!-- Delivered -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Delivered</p>
      <div class="p-2 bg-green-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-green-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.delivered %></h3>
  </div>

  <!-- Cancelled -->
  <div class="bg-white p-6 border border-brand-gray-100 rounded-xl shadow-sm flex flex-col justify-between">
    <div class="flex items-start justify-between mb-2">
      <p class="font-sans text-sm text-brand-gray-500">Cancelled</p>
      <div class="p-2 bg-red-50 rounded-full flex items-center justify-center">
        <div class="w-2.5 h-2.5 bg-red-500 rounded-full"></div>
      </div>
    </div>
    <h3 class="font-serif text-4xl font-bold text-brand-black"><%= stats.cancelled %></h3>
  </div>
</div>

<!-- Order Table Card -->
<div class="max-w-6xl mx-auto bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden">
  <div class="p-6 border-b border-brand-gray-100">
    <h2 class="font-serif text-xl font-bold text-brand-black mb-6">Orders List</h2>
    
    <form id="filter-form" action="/admin/orders" method="GET" class="flex flex-col md:flex-row gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="text" id="search-input" name="search" value="<%= searchQuery || '' %>" placeholder="Search order by ID, user name, or email..." 
               class="w-full pl-10 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black">
        <% if (searchQuery) { %>
          <button type="button" id="clear-search-btn" class="absolute inset-y-0 right-0 pr-3 flex items-center text-brand-gray-400 hover:text-brand-black" title="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        <% } %>
      </div>
      
      <!-- Status Filter -->
      <div class="relative w-full md:w-48">
        <select id="status-filter" name="status" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none" onchange="this.form.submit()">
          <option value="All" <%= statusFilter === 'All' ? 'selected' : '' %>>All Statuses</option>
          <option value="Pending" <%= statusFilter === 'Pending' ? 'selected' : '' %>>Pending</option>
          <option value="Shipped" <%= statusFilter === 'Shipped' ? 'selected' : '' %>>Shipped</option>
          <option value="Out for Delivery" <%= statusFilter === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
          <option value="Delivered" <%= statusFilter === 'Delivered' ? 'selected' : '' %>>Delivered</option>
          <option value="Cancelled" <%= statusFilter === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>

      <!-- Sort Filter -->
      <div class="relative w-full md:w-48">
        <select id="sort-filter" name="sort" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none" onchange="this.form.submit()">
          <option value="Newest First" <%= sortOption === 'Newest First' ? 'selected' : '' %>>Newest First</option>
          <option value="Oldest First" <%= sortOption === 'Oldest First' ? 'selected' : '' %>>Oldest First</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
          <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
          </svg>
        </div>
      </div>
      
      <div class="flex gap-2 w-full md:w-auto">
        <!-- Search Button -->
        <button type="submit" class="flex-1 md:flex-initial bg-brand-black text-white px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-600 transition-colors">
          Search
        </button>
        
        <% if (searchQuery || statusFilter !== 'All' || sortOption !== 'Newest First') { %>
          <!-- Clear Filters Button -->
          <a href="/admin/orders" class="flex-1 md:flex-initial bg-brand-gray-100 text-brand-black border border-brand-gray-200 px-6 py-2.5 rounded-md font-sans font-medium text-sm hover:bg-brand-gray-200 transition-colors flex items-center justify-center" title="Clear all search and filters">
            Clear
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Mobile Card View (visible on < md screens) -->
  <div class="block md:hidden divide-y divide-brand-gray-100">
    <% if (orders && orders.length > 0) { %>
      <% orders.forEach(order => { %>
        <div class="p-5 flex flex-col gap-4 hover:bg-brand-gray-50 transition-colors">
          <div class="flex justify-between items-start">
            <div class="min-w-0">
              <span class="block text-[10px] text-brand-gray-400 uppercase tracking-wider">Order ID</span>
              <span class="font-sans font-semibold text-brand-black text-sm block truncate">#<%= order._id %></span>
            </div>
            <div>
              <span class="px-2.5 py-0.5 inline-flex text-[10px] leading-5 font-semibold rounded-md 
                <%= order.status === 'Delivered' ? 'bg-green-100 text-green-700' : 
                    order.status === 'Cancelled' ? 'bg-red-100 text-red-700' : 
                    order.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 'bg-blue-100 text-blue-700' %>">
                <%= order.status %>
              </span>
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-2 text-xs border-t border-brand-gray-50 pt-2">
            <div>
              <span class="block text-[10px] text-brand-gray-400 uppercase tracking-wider">User</span>
              <span class="font-medium text-brand-black truncate block"><%= order.user ? order.user.fullName : 'Guest' %></span>
            </div>
            <div>
              <span class="block text-[10px] text-brand-gray-400 uppercase tracking-wider">Total Amount</span>
              <span class="font-medium text-brand-black">₹<%= order.totalAmount %></span>
            </div>
            <div class="col-span-2 mt-1">
              <span class="block text-[10px] text-brand-gray-400 uppercase tracking-wider">Order Date</span>
              <span class="font-medium text-brand-black"><%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit' }) %></span>
            </div>
          </div>
          
          <div class="pt-2 flex justify-end">
            <a href="/admin/orders/<%= order._id %>" class="bg-white border border-brand-gray-200 text-brand-black px-4 py-2 rounded-md font-sans text-xs font-semibold hover:bg-brand-gray-50 transition-colors flex items-center justify-center gap-1">
              View Details
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="p-6 text-center text-brand-gray-400 font-sans text-sm">No orders found.</div>
    <% } %>
  </div>

  <!-- Desktop Table View (visible on >= md screens) -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-brand-gray-100 bg-brand-gray-50 text-[10px] font-sans font-bold text-brand-gray-500 uppercase tracking-widest2">
          <th class="px-6 py-4">Order ID</th>
          <th class="px-6 py-4">Order Date</th>
          <th class="px-6 py-4">User</th>
          <th class="px-6 py-4">Total Amount</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-brand-gray-100 font-sans text-sm text-brand-black">
        <% if (orders && orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr class="hover:bg-brand-gray-50/50 transition-colors">
              <td class="px-6 py-4 font-semibold">#<%= order._id %></td>
              <td class="px-6 py-4 text-brand-gray-600">
                <%= new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                <span class="block text-[10px] text-brand-gray-400"><%= new Date(order.createdAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></span>
              </td>
              <td class="px-6 py-4">
                <div class="font-medium"><%= order.user ? order.user.fullName : 'Guest' %></div>
                <div class="text-xs text-brand-gray-400"><%= order.user ? order.user.email : '' %></div>
              </td>
              <td class="px-6 py-4 font-medium">₹<%= order.totalAmount %></td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-md 
                  <%= order.status === 'Delivered' ? 'bg-green-100 text-green-700' : 
                      order.status === 'Cancelled' ? 'bg-red-100 text-red-700' : 
                      order.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 'bg-blue-100 text-blue-700' %>">
                  <%= order.status %>
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <a href="/admin/orders/<%= order._id %>" class="bg-white border border-brand-gray-200 text-brand-black px-3.5 py-1.5 rounded-md text-xs font-semibold hover:bg-brand-gray-50 hover:border-brand-black transition-all">
                  View Details
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-10 text-center text-brand-gray-400 font-sans text-sm">No orders found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if (orders && orders.length > 0 && totalPages > 1) { %>
    <div class="px-6 py-4 border-t border-brand-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 bg-brand-gray-50/50">
      <p class="font-sans text-xs text-brand-gray-500">
        Showing Page <span class="font-semibold text-brand-black"><%= currentPage %></span> of <span class="font-semibold text-brand-black"><%= totalPages %></span> pages.
      </p>
      
      <div class="flex items-center justify-between w-full sm:w-auto gap-2">
        <% if (currentPage > 1) { %>
          <a href="?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Previous
          </a>
        <% } else { %>
          <span class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-300 flex items-center gap-1 cursor-not-allowed text-xs sm:text-sm">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Previous
          </span>
        <% } %>

        <div class="hidden sm:flex items-center gap-1">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="w-8 h-8 flex items-center justify-center bg-brand-gray-100 rounded-md font-medium text-brand-black"><%= i %></span>
            <% } else if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <a href="?page=<%= i %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="w-8 h-8 flex items-center justify-center border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors"><%= i %></a>
            <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
              <span class="w-8 h-8 flex items-center justify-center text-brand-gray-400">...</span>
            <% } %>
          <% } %>
        </div>

        <span class="sm:hidden font-sans text-xs text-brand-gray-500 font-medium">
          Page <%= currentPage %> of <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a href="?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(searchQuery) %>&status=<%= encodeURIComponent(statusFilter) %>&sort=<%= encodeURIComponent(sortOption) %>" class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-600 hover:bg-brand-gray-50 transition-colors flex items-center gap-1 text-xs sm:text-sm">
            Next
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        <% } else { %>
          <span class="px-3 py-1.5 border border-brand-gray-200 rounded-md text-brand-gray-300 flex items-center gap-1 cursor-not-allowed text-xs sm:text-sm">
            Next
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </span>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script>
  // Filter form auto-submit clear logic
  const clearSearchBtn = document.getElementById('clear-search-btn');
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      document.getElementById('search-input').value = '';
      document.getElementById('filter-form').submit();
    });
  }
</script>
