<!-- Header with Back Link -->
<div class="max-w-5xl mx-auto mb-8 flex items-center justify-between">
  <div>
    <a href="/admin/orders" class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-gray-500 hover:text-brand-black transition-colors mb-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back to Orders
    </a>
    <h1 class="text-2xl font-serif font-bold text-brand-black flex items-center gap-2">
      Order Details: #<%= order._id %>
    </h1>
  </div>
  <div>
    <span class="px-3 py-1 inline-flex text-xs font-semibold rounded-md 
      <%= order.status === 'Delivered' ? 'bg-green-100 text-green-700' : 
          order.status === 'Cancelled' ? 'bg-red-100 text-red-700' : 
          order.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : 
          order.status === 'Cancellation Requested' ? 'bg-orange-100 text-orange-700 font-bold' : 'bg-blue-100 text-blue-700' %>">
      <%= order.status %>
    </span>
  </div>
</div>

<div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">
  <!-- Left Side: Order Items and Info -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Items Card -->
    <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm overflow-hidden p-6">
      <h3 class="font-serif text-lg font-bold text-brand-black mb-4">Ordered Products</h3>
      <div class="divide-y divide-brand-gray-100">
        <% order.items.forEach(item => { %>
          <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex gap-4 items-center flex-1 min-w-0">
              <!-- Product Image -->
              <div class="w-16 h-16 rounded-md overflow-hidden bg-brand-gray-50 border border-brand-gray-100 flex-shrink-0 flex items-center justify-center">
                <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                  <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>" class="w-full h-full object-cover">
                <% } else { %>
                  <svg class="w-6 h-6 text-brand-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <% } %>
              </div>
              
              <!-- Product Details -->
              <div class="flex-1 min-w-0 font-sans">
                <h4 class="font-semibold text-brand-black text-sm truncate"><%= item.product ? item.product.name : 'Unknown Product' %></h4>
                <p class="text-xs text-brand-gray-500 mt-0.5">
                  Size: <span class="font-semibold text-brand-black"><%= item.variant.size %></span> | 
                  Color: <span class="font-semibold text-brand-black"><%= item.variant.color %></span>
                </p>
                <p class="text-xs text-brand-gray-500 mt-0.5">
                  Quantity: <span class="font-semibold text-brand-black"><%= item.quantity %></span>
                </p>
                <% if (item.status) { %>
                  <div class="mt-1 flex items-center gap-2">
                    <span class="px-2 py-0.5 inline-flex text-[10px] font-bold rounded 
                      <%= item.status === 'Cancelled' ? 'bg-red-100 text-red-700' : 
                          item.status === 'Cancellation Requested' ? 'bg-orange-100 text-orange-700' : 'bg-gray-100 text-gray-700' %>">
                      <%= item.status %>
                    </span>
                  </div>
                  <% if (item.cancellationReason) { %>
                    <p class="text-[11px] text-orange-700 mt-0.5"><span class="font-semibold">Reason:</span> <%= item.cancellationReason %></p>
                  <% } %>
                <% } %>
              </div>
            </div>
            
            <!-- Price Info & Item Action -->
            <div class="flex items-center justify-between sm:justify-end gap-4 font-sans">
              <div class="text-right">
                <% const pMap = order.pricing && order.pricing.itemDetailsMap ? order.pricing.itemDetailsMap : {}; %>
                <% const itemInfo = pMap[item._id ? item._id.toString() : '']; %>
                <% if (item.status === 'Cancelled') { %>
                  <div class="font-semibold text-brand-gray-400 text-sm line-through">₹<%= item.price * item.quantity %></div>
                  <div class="text-xs text-brand-gray-400 font-medium">Cancelled</div>
                  <% if (itemInfo && itemInfo.allocatedCouponDiscount > 0) { %>
                    <div class="text-[11px] text-brand-gray-500">Coupon share: -₹<%= itemInfo.allocatedCouponDiscount %></div>
                  <% } %>
                  <% if (itemInfo && itemInfo.effectiveAmount > 0) { %>
                    <div class="text-xs text-green-600 font-bold">Refunded: ₹<%= item.refundAmount || itemInfo.effectiveAmount %></div>
                  <% } %>
                <% } else { %>
                  <div class="font-semibold text-brand-black text-sm">₹<%= item.price * item.quantity %></div>
                  <div class="text-xs text-brand-gray-400">₹<%= item.price %> each</div>
                  <% if (itemInfo && itemInfo.allocatedCouponDiscount > 0) { %>
                    <div class="text-[11px] text-green-600">Coupon share: -₹<%= itemInfo.allocatedCouponDiscount %></div>
                    <div class="text-xs font-semibold text-brand-black">Net: ₹<%= itemInfo.effectiveAmount %></div>
                  <% } %>
                <% } %>
              </div>
              <% if (item.status === 'Cancellation Requested') { %>
                <form action="/admin/orders/<%= order._id %>/items/<%= item._id %>/approve-cancellation" method="POST">
                  <button type="submit" class="px-3 py-1.5 bg-orange-600 hover:bg-orange-700 text-white font-sans text-xs font-semibold rounded shadow transition-colors whitespace-nowrap">
                    Approve Cancellation
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Summary Divider -->
      <div class="border-t border-brand-gray-100 pt-4 mt-4 space-y-2 font-sans text-xs sm:text-sm text-brand-gray-600">
        <% const p = order.pricing || {}; %>
        <div class="flex justify-between">
          <span>Original Order Subtotal</span>
          <span class="font-medium text-brand-black">₹<%= p.initialSubtotal %></span>
        </div>

        <% if (p.totalCouponDiscount > 0) { %>
          <div class="flex justify-between text-green-600">
            <span>Discount <%= order.couponCode ? `(${order.couponCode})` : '' %></span>
            <span class="font-medium">-₹<%= p.totalCouponDiscount %></span>
          </div>
        <% } %>

        <div class="flex justify-between">
          <span>Shipping</span>
          <span class="font-medium text-brand-black">₹<%= p.shippingCharge %></span>
        </div>

        <div class="flex justify-between font-semibold text-brand-black pt-1 border-t border-brand-gray-100">
          <span>Original Total</span>
          <span>₹<%= p.originalTotal %></span>
        </div>

        <% if (p.cancelledItemsDeduction > 0) { %>
          <div class="flex justify-between text-red-600 font-semibold">
            <span>Cancelled Items Deduction</span>
            <span>-₹<%= p.cancelledItemsDeduction %></span>
          </div>
        <% } %>

        <div class="border-t-2 border-brand-black pt-3 flex justify-between text-base font-bold text-brand-black">
          <span>Current Order Total</span>
          <span>₹<%= p.currentTotal %></span>
        </div>
      </div>
    </div>

    <!-- User Information Card -->
    <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm p-6">
      <h3 class="font-serif text-lg font-bold text-brand-black mb-4">Customer Details</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-sans text-sm">
        <div>
          <span class="block text-xs text-brand-gray-400 uppercase tracking-wider">Full Name</span>
          <span class="font-semibold text-brand-black"><%= order.user ? order.user.fullName : 'Guest' %></span>
        </div>
        <div>
          <span class="block text-xs text-brand-gray-400 uppercase tracking-wider">Email Address</span>
          <span class="font-semibold text-brand-black"><%= order.user ? order.user.email : 'N/A' %></span>
        </div>
        <div>
          <span class="block text-xs text-brand-gray-400 uppercase tracking-wider">Phone Number</span>
          <span class="font-semibold text-brand-black"><%= order.user && order.user.phone ? order.user.phone : (order.shippingAddress.phone || 'N/A') %></span>
        </div>
        <div>
          <span class="block text-xs text-brand-gray-400 uppercase tracking-wider">Joined Date</span>
          <span class="font-semibold text-brand-black">
            <%= order.user ? new Date(order.user.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side: Order Status and Shipping Address -->
  <div class="space-y-6">
    <!-- Status Management Card -->
    <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm p-6">
      <h3 class="font-serif text-lg font-bold text-brand-black mb-4">Order Status Management</h3>

      <% if (order.status === 'Cancellation Requested') { %>
        <div class="space-y-4 font-sans">
          <div class="p-3 bg-orange-50 border border-orange-200 rounded-md">
            <span class="block text-xs font-bold text-orange-800 uppercase tracking-wider mb-1">Cancellation Requested</span>
            <p class="text-xs text-orange-900"><span class="font-semibold">Reason:</span> <%= order.cancellationReason || 'No reason provided' %></p>
          </div>

          <form action="/admin/orders/<%= order._id %>/approve-cancellation" method="POST" class="block">
            <button type="submit" class="w-full bg-orange-600 text-white font-sans text-xs font-semibold tracking-wider uppercase py-2.5 rounded-md hover:bg-orange-700 transition-colors shadow">
              Approve Order Cancellation
            </button>
          </form>
        </div>
      <% } else if (order.status === 'Return Requested') { %>
        <div class="space-y-4 font-sans">
          <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-md">
            <span class="block text-xs font-bold text-yellow-800 uppercase tracking-wider mb-1">Return Requested</span>
            <p class="text-xs text-yellow-900"><span class="font-semibold">Reason:</span> <%= order.returnReason || 'No reason provided' %></p>
          </div>

          <div class="pt-2 space-y-2">
            <p class="text-xs font-semibold text-brand-black">Select Return Action:</p>
            <form action="/admin/orders/<%= order._id %>/update-status" method="POST" class="block">
              <input type="hidden" name="status" value="Returned">
              <input type="hidden" name="restockOption" value="restock">
              <button type="submit" class="w-full bg-brand-black text-white font-sans text-xs font-semibold tracking-wider uppercase py-2.5 rounded-md hover:bg-brand-gray-600 transition-colors shadow">
                Approve &amp; Restock
              </button>
            </form>
            <form action="/admin/orders/<%= order._id %>/update-status" method="POST" class="block">
              <input type="hidden" name="status" value="Returned">
              <input type="hidden" name="restockOption" value="no_restock">
              <button type="submit" class="w-full bg-white border border-brand-gray-200 text-brand-black font-sans text-xs font-semibold tracking-wider uppercase py-2.5 rounded-md hover:bg-brand-gray-50 transition-colors">
                Approve &amp; Do Not Restock
              </button>
            </form>
            <button type="button" onclick="openDeclineModal('/admin/returns/<%= order._id %>/decline')" class="w-full bg-red-600 text-white font-sans text-xs font-semibold tracking-wider uppercase py-2.5 rounded-md hover:bg-red-700 transition-colors shadow">
              Decline Return Request
            </button>
          </div>
        </div>
      <% } else if (order.status === 'Cancelled' || order.status === 'Returned') { %>
        <div class="p-4 bg-brand-gray-50 border border-brand-gray-100 rounded-md font-sans text-xs text-brand-gray-600">
          Status is <span class="font-bold text-brand-black"><%= order.status %></span>. No further status changes permitted.
          <% if (order.status === 'Cancelled' && order.cancellationReason) { %>
            <div class="mt-2"><span class="font-semibold">Reason:</span> <%= order.cancellationReason %></div>
          <% } %>
          <% if (order.status === 'Returned' && order.returnReason) { %>
            <div class="mt-2"><span class="font-semibold">Reason:</span> <%= order.returnReason %></div>
          <% } %>
        </div>
      <% } else { %>
        <form action="/admin/orders/<%= order._id %>/update-status" method="POST" class="space-y-4">
          <div>
            <label for="status" class="block font-sans text-xs font-semibold uppercase tracking-wider text-brand-black mb-2">Order Status</label>
            <div class="relative">
              <select name="status" id="status" class="w-full pl-4 pr-10 py-2.5 bg-white border border-brand-gray-200 rounded-md font-sans text-sm focus:outline-none focus:ring-1 focus:ring-brand-black focus:border-brand-black appearance-none">
                <% if (order.status === 'Pending') { %>
                  <option value="Pending" selected>Pending</option>
                  <option value="Shipped">Shipped</option>
                  <option value="Cancelled">Cancelled</option>
                <% } else if (order.status === 'Shipped') { %>
                  <option value="Shipped" selected>Shipped</option>
                  <option value="Out for Delivery">Out for Delivery</option>
                  <option value="Cancelled">Cancelled</option>
                <% } else if (order.status === 'Out for Delivery') { %>
                  <option value="Out for Delivery" selected>Out for Delivery</option>
                  <option value="Delivered">Delivered</option>
                <% } else if (order.status === 'Delivered') { %>
                  <option value="Delivered" selected>Delivered</option>
                <% } %>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-brand-gray-400">
                <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
                </svg>
              </div>
            </div>
          </div>
          
          <button type="submit" class="w-full bg-brand-black text-white font-sans text-xs font-semibold tracking-widest2 uppercase py-3 rounded-md hover:bg-brand-gray-600 transition-colors shadow">
            Save Status
          </button>
        </form>
      <% } %>
    </div>

    <!-- Shipping Address Card -->
    <div class="bg-white border border-brand-gray-100 rounded-xl shadow-sm p-6">
      <h3 class="font-serif text-lg font-bold text-brand-black mb-4">Shipping Address</h3>
      <div class="font-sans text-sm text-brand-gray-600 space-y-2">
        <div class="font-semibold text-brand-black text-base mb-1">
          <%= order.shippingAddress.fullName %>
        </div>
        <div>
          <span class="font-medium text-brand-black">Phone:</span> <%= order.shippingAddress.phone %>
        </div>
        <div class="pt-2 border-t border-brand-gray-50">
          <%= order.shippingAddress.addressLine1 %>
          <% if (order.shippingAddress.addressLine2) { %>
            <br><%= order.shippingAddress.addressLine2 %>
          <% } %>
          <br><%= order.shippingAddress.locality %>
          <br><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %>
          <br><%= order.shippingAddress.country %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Decline Return Request Modal -->
<div id="decline-modal" class="fixed inset-0 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true">
  <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
    <div class="fixed inset-0 bg-brand-black/40 backdrop-blur-sm transition-opacity" onclick="closeDeclineModal()"></div>

    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <div class="inline-block align-middle bg-white border border-brand-gray-200 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-md sm:w-full p-6 sm:p-8">
      <div class="pb-4 border-b border-brand-gray-100 flex justify-between items-center">
        <h3 class="font-serif text-xl font-bold text-brand-black">Decline Return Request</h3>
        <button type="button" onclick="closeDeclineModal()" class="text-brand-gray-400 hover:text-brand-black transition-colors focus:outline-none">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="decline-form" action="" method="POST" class="mt-6 font-sans text-sm space-y-4" novalidate>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-widest text-brand-gray-500 mb-2">Reason for declining <span class="text-red-500">*</span></label>
          <textarea id="declineReasonInput" name="declineReason" rows="3" class="w-full px-3 py-2 border border-brand-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-brand-black bg-white placeholder-brand-gray-400 transition-colors" placeholder="Please state why the return is being declined..."></textarea>
          <p class="hidden text-red-500 text-xs mt-1.5 font-sans pl-1" id="declineReasonError">Reason is mandatory.</p>
        </div>

        <div class="pt-4 flex gap-3">
          <button type="button" onclick="closeDeclineModal()" class="flex-1 py-2.5 border border-brand-gray-200 text-brand-gray-600 hover:bg-brand-gray-50 font-sans font-bold uppercase tracking-wider text-xs transition-colors">Cancel</button>
          <button type="submit" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-sans font-bold uppercase tracking-wider text-xs transition-colors">Confirm Decline</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openDeclineModal(actionUrl) {
    const form = document.getElementById('decline-form');
    form.action = actionUrl;
    const input = document.getElementById('declineReasonInput');
    const err = document.getElementById('declineReasonError');
    input.value = '';
    if (err) err.classList.add('hidden');
    input.classList.remove('border-red-500', 'focus:border-red-500');
    input.classList.add('border-brand-gray-200', 'focus:ring-brand-black');
    document.getElementById('decline-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDeclineModal() {
    document.getElementById('decline-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  document.getElementById('decline-form').addEventListener('submit', function(e) {
    const input = document.getElementById('declineReasonInput');
    const err = document.getElementById('declineReasonError');
    const val = input ? input.value.trim() : '';

    if (!val) {
      e.preventDefault();
      if (err) {
        err.textContent = 'Reason is mandatory.';
        err.classList.remove('hidden');
      }
      if (input) {
        input.classList.remove('border-brand-gray-200', 'focus:ring-brand-black');
        input.classList.add('border-red-500', 'focus:border-red-500');
        input.focus();
      }
    }
  });

  const inputEl = document.getElementById('declineReasonInput');
  if (inputEl) {
    inputEl.addEventListener('input', function() {
      if (this.value.trim()) {
        this.classList.remove('border-red-500', 'focus:border-red-500');
        this.classList.add('border-brand-gray-200', 'focus:ring-brand-black');
        const err = document.getElementById('declineReasonError');
        if (err) err.classList.add('hidden');
      }
    });
  }
</script>
